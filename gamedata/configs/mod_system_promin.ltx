[wd_promin]:identity_immunities
GroupControlSection  = spawn_group
discovery_dependency =
$spawn          = "devices\promin"
class           = II_ATTCH
kind            = i_device
cform           = skeleton
visual          = wd\world\promin_world.ogf
inv_name        = st_promin
inv_name_short  = st_promin
description     = st_promin_descr
inv_weight      = 0.211
icons_texture   = wd\ui\promin\icon_promin_t1
inv_grid_width  = 2
inv_grid_height = 1
inv_grid_x      = 0
inv_grid_y      = 0
cost            = 5800

![wd_promin]
use1_functor = d_promin.get_menu_text
use1_action_functor = d_promin.toggle_attach
use3_functor = d_promin.get_remove_module_menu_text
use3_action_functor = d_promin.remove_module
use6_functor = item_device.menu_battery
use6_action_functor = item_device.func_battery
battery = batteries_dead
power_critical = 0.05
can_break = false
use_condition = true
condition_bar = power_progess_bar

