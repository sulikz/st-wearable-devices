local BINOC_CLASS = "WP_BINOC"

local hidden = false
local zoomed = false

local function is_binoc(item)
    return ini_sys:r_string_ex(item:section(), "class") == BINOC_CLASS
end

local function is_texture_zoom_active(item)
    if not item then
        return false
    end
    local weapon = item:cast_Weapon()
    if weapon and weapon.IsTextureZoomActive then
        return weapon:IsTextureZoomActive()
    end
    return is_binoc(item)
end

local function set_hidden(hide)
    if hide == hidden then
        return
    end
    hidden = hide
    if hide then
        wd_attach.hide_screens()
    else
        wd_attach.show_screens()
    end
end

function update()
    if not zoomed then
        return
    end
    set_hidden(is_texture_zoom_active(db.actor:active_item()))
end

function on_zoom_in()
    zoomed = true
    update()
end

function on_zoom_out()
    zoomed = false
    set_hidden(false)
end

function on_first_update()
    zoomed = false
    hidden = false
    wd_attach.show_screens()
end

function register()
    wd_core.register({
        id = "wd_zoom",
        callbacks = {
            actor_on_first_update = { on_first_update },
            actor_on_update = { update },
            actor_on_weapon_zoom_in = { on_zoom_in },
            actor_on_weapon_zoom_out = { on_zoom_out },
        },
    })
end
