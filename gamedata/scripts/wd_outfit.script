DEFAULT_HANDS = "actor_hud_05"

OUTFIT_SLOT = 7
local NONE = "_none"
local hands_by_outfit = {}

function get_item()
    return db.actor and db.actor:item_in_slot(OUTFIT_SLOT)
end

function get_key()
    local outfit = get_item()
    if not outfit then
        return NONE
    end
    return outfit:section()
end

function is_none(outfit_key)
    return outfit_key == nil or outfit_key == NONE
end

function get_hands_section(outfit_key)
    if is_none(outfit_key) then
        return DEFAULT_HANDS
    end
    local cached = hands_by_outfit[outfit_key]
    if cached == nil then
        cached = ini_sys:r_string_ex(outfit_key, "player_hud_section") or false
        hands_by_outfit[outfit_key] = cached
    end
    return cached or nil
end
