local ROOT = "wd"
local ID_HOLD_KEY = "hold_key"
local ID_TAP_MS = "tap_ms"
local ID_GUI_KEY = "gui_key"
local ID_GUI_MOD = "gui_mod"
local ID_SWAP_HOLD_TOGGLE = "swap_hold_toggle"
local ID_STRICT_GEIGER = "strict_geiger"
local ID_QAW_RAISE = "qaw_raise"
local DEFAULT_TAP_MS = 200
local QAW_RAISE_NONE = "none"
local DEFAULT_QAW_RAISE = "watch"

hold_key = DIK_keys.MOUSE_4
tap_ms = DEFAULT_TAP_MS
gui_key = DIK_keys.DIK_M
gui_mod = "alt"
swap_hold_toggle = false
strict_geiger = true
qaw_raise = DEFAULT_QAW_RAISE

local MOD_DIKS = {
    alt = { "DIK_LMENU", "DIK_RMENU" },
    ctrl = { "DIK_LCONTROL", "DIK_RCONTROL" },
    shift = { "DIK_LSHIFT", "DIK_RSHIFT" },
}

function is_mod_held(mode)
    if mode == "none" then
        return true
    end
    local diks = MOD_DIKS[mode]
    if not diks then
        return false
    end
    return key_state(DIK_keys[diks[1]]) ~= 0 or key_state(DIK_keys[diks[2]]) ~= 0
end

function on_mcm_load()
    return {
        id = ROOT,
        sh = true,
        gr = {
            {
                id = "title",
                type = "slide",
                link = "ui_options_slider_player",
                text = "ui_mcm_wd_title",
                size = { 512, 50 },
                spacing = 20,
            },
            {
                id = ID_HOLD_KEY,
                type = "key_bind",
                val = 2,
                def = DIK_keys.MOUSE_4,
                text = "ui_mcm_wd_hold_key",
            },
            {
                id = ID_TAP_MS,
                type = "track",
                val = 2,
                def = DEFAULT_TAP_MS,
                min = 150,
                max = 600,
                step = 25,
                text = "ui_mcm_wd_tap_ms",
            },
            {
                id = ID_SWAP_HOLD_TOGGLE,
                type = "check",
                val = 1,
                def = false,
                text = "ui_mcm_wd_swap_hold_toggle",
            },
            {
                id = ID_GUI_KEY,
                type = "key_bind",
                val = 2,
                def = DIK_keys.DIK_M,
                text = "ui_mcm_wd_gui_key",
            },
            {
                id = ID_GUI_MOD,
                type = "list",
                val = 0,
                def = "alt",
                text = "ui_mcm_wd_gui_mod",
                content = { { "none", "none" }, { "alt", "alt" }, { "ctrl", "ctrl" }, { "shift", "shift" } },
            },
            {
                id = ID_STRICT_GEIGER,
                type = "check",
                val = 1,
                def = true,
                text = "ui_mcm_wd_strict_geiger",
            },
            {
                id = ID_QAW_RAISE,
                type = "list",
                val = 0,
                def = DEFAULT_QAW_RAISE,
                text = "ui_mcm_wd_qaw_raise",
                content = {
                    { wd_inspect.POSE_WATCH, "wd_qaw_raise_watch" },
                    { wd_inspect.POSE_PROMIN, "wd_qaw_raise_promin" },
                    { QAW_RAISE_NONE, "wd_qaw_raise_none" },
                },
            },
        },
    }
end

local function is_bound(value)
    return value ~= -1
end

local function is_positive(value)
    return value > 0
end

local function read_option(id, current, is_valid)
    local value = ui_mcm.get(ROOT .. "/" .. id)
    if value == nil or (is_valid and not is_valid(value)) then
        return current
    end
    return value
end

function on_option_change()
    if not ui_mcm then
        return
    end
    hold_key = read_option(ID_HOLD_KEY, hold_key, is_bound)
    tap_ms = read_option(ID_TAP_MS, tap_ms, is_positive)
    gui_key = read_option(ID_GUI_KEY, gui_key)
    gui_mod = read_option(ID_GUI_MOD, gui_mod)
    swap_hold_toggle = read_option(ID_SWAP_HOLD_TOGGLE, swap_hold_toggle)
    strict_geiger = read_option(ID_STRICT_GEIGER, strict_geiger)
    qaw_raise = read_option(ID_QAW_RAISE, qaw_raise)
end

function get_hold_key_dik()
    return hold_key
end

function get_tap_threshold_ms()
    return tap_ms
end

function get_gui_key_dik()
    return gui_key
end

function is_gui_mod_held()
    return is_mod_held(gui_mod)
end

function is_hold_toggle_swapped()
    return swap_hold_toggle == true
end

function is_strict_geiger()
    return strict_geiger == true
end

function get_qaw_raise_pose()
    if qaw_raise == QAW_RAISE_NONE then
        return nil
    end
    return qaw_raise
end
