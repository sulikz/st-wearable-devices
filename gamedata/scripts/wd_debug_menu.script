local SPAWN_GROUP_SOURCES = {
    i_wearable_module = "i_device",
    i_wearable_kit = "i_upgrade",
}

function add_spawn_kinds(groups)
    if type(groups) ~= "table" then
        return false
    end
    for kind, source_kind in pairs(SPAWN_GROUP_SOURCES) do
        local group = groups[source_kind]
        if group and groups[kind] == nil then
            groups[kind] = group
        end
    end
    return true
end

function install_spawn_kinds()
    if not ui_debug_launcher then
        return false
    end
    return add_spawn_kinds(ui_debug_launcher.itm_to_spawn_classes)
end

function register()
    wd_core.register({
        id = "wd_debug_menu",
        on_start = install_spawn_kinds,
    })
end
