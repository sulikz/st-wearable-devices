MOUNT = "wrist"
TWIST_ANM = [[wd\left_wrist_twist.anm]]
RETURN_MS = 334
WINDOWS = {
    weapon = {
        [wd_inspect.CLIP_DRAW] = { 0.20, 0.40 },
        [wd_inspect.CLIP_HOLSTER] = { 0.20, 1.00 },
        [wd_inspect.CLIP_SWITCH] = { 0.07, 0.67 },
    },
    detector = {
        [wd_inspect.CLIP_DRAW] = { 0.20, 0.50 },
        [wd_inspect.CLIP_HOLSTER] = { 0.25, 0.80 },
        [wd_inspect.CLIP_SWITCH] = { 0.07, 0.67 },
    },
}

ROOM = {
    forearm = { lo = math.rad(-99), hi = math.rad(99) },
    side = { lo = math.rad(-63), hi = math.rad(197) },
}

BRACER_ROLL_RANGE = { -20, 86 }
SLIDE_RANGE = { -0.04, 0.015 }

local KEEP_VISIBLE_LABEL = "Keep watch always visible"
local ROLL_LABEL = "Roll"
local TWIST_BONE = "l_forearm_twist"
local PROXY_NAME = "wd_wrist_roll_proxy"
local IDLE_ANM = "anm_idle"
local LAUNCHER_IDLE_ANM = "anm_idle_w_gl"
local GRENADE_IDLE_ANM = "anm_idle_g"
local FALLBACK_MOTION = "hand_idle_doun"
local SOLVE_ITERATIONS = 4
local REFRESH_INTERVAL_MS = 200
local APPLY_EPSILON = math.rad(0.01)
local WIDE_SUFFIX = "_16x9"
local FULL_WINDOW = { 0, 1 }
local X_AXIS = wd_frame.new_vec(1, 0, 0)
local Y_AXIS = wd_frame.new_vec(0, 1, 0)
local Z_AXIS = wd_frame.new_vec(0, 0, 1)
local TUBE_AXIS = Z_AXIS
local STORE_SECTION = "wd_wrist_roll"
local ENABLED_KEY = "keep_visible"
local ROLL_KEY = "roll"
local SLIDE_KEY = "slide"
local SETTING_DEFAULTS = { [ROLL_KEY] = 0, [SLIDE_KEY] = 0 }
local TWIST_PART = 1
local TWIST_UNIT = math.rad(10)
local FULL_TURN = 2 * math.pi
local HALF_TURN_RANGE = { -180, 180 }

function new_mount_frame()
    local bind = d_bracer_config.MOUNT_BIND
    local frame = wd_frame.new_xyzi_frame(bind.rot[1], bind.rot[2], bind.rot[3])
    frame.c = wd_frame.new_vec(bind.pos[1], bind.pos[2], bind.pos[3])
    return frame
end

local mount_frame = new_mount_frame()
local mount_inverse = wd_frame.invert_frame(mount_frame)

function get_mount_frame()
    return mount_frame
end

function get_tube_in_mount()
    return mount_inverse.k
end
local enabled = true
local gui_fields = nil

local function copy_settings(target, source)
    for key in pairs(SETTING_DEFAULTS) do
        target[key] = source[key]
    end
    return target
end

local settings = copy_settings({}, SETTING_DEFAULTS)
local saved = copy_settings({}, SETTING_DEFAULTS)
local twisted_pose = nil
local layers_primed = false
local twist_supported = false
local applied_twist = 0
local twist_cache = {}
local active_source_id = nil
local seen_clip = nil
local movement = nil
local next_tick_at = 0
local next_room_at = 0
local target_roll = 0
local room_lo = nil
local room_hi = nil
local applied_roll = 0
local posed_roll = 0
local rolled_memo = nil
local cleared = true
local solved = { roll = 0 }

local function is_enabled()
    return enabled
end

local function save_settings()
    wd_store.update({
        [STORE_SECTION] = {
            [ENABLED_KEY] = tostring(enabled),
            [ROLL_KEY] = tostring(saved[ROLL_KEY]),
            [SLIDE_KEY] = tostring(saved[SLIDE_KEY]),
        },
    })
end

local function save_gui_settings()
    copy_settings(saved, settings)
    save_settings()
end

function set_enabled(on)
    enabled = on and true or false
    next_tick_at = 0
    next_room_at = 0
    save_settings()
end

function get_slide()
    return settings[SLIDE_KEY]
end

local function read_setting(section, key, range)
    return clamp(tonumber(section[key]) or SETTING_DEFAULTS[key], range[1], range[2])
end

local function load_settings()
    local section = wd_store.read()[STORE_SECTION] or {}
    enabled = section[ENABLED_KEY] ~= "false"
    saved[ROLL_KEY] = read_setting(section, ROLL_KEY, HALF_TURN_RANGE)
    saved[SLIDE_KEY] = read_setting(section, SLIDE_KEY, SLIDE_RANGE)
    copy_settings(settings, saved)
end

function get_rolled_pose(pos, rot, roll)
    local in_model = wd_frame.compose_frames(mount_frame, wd_frame.new_pose_frame(pos, rot))
    local rolled = wd_frame.compose_frames(mount_inverse, wd_frame.rotate_frame(in_model, TUBE_AXIS, roll))
    local yaw, pitch, bank = wd_frame.get_hpb(rolled)
    return { rolled.c.x, rolled.c.y, rolled.c.z }, { math.deg(yaw), math.deg(pitch), math.deg(bank) }
end

local has_same_axes = wd_transforms.has_same_axes

local function adjust_mount_pose(pos, rot)
    local memo = rolled_memo
    if not (memo and memo.roll == posed_roll and has_same_axes(memo.pos, pos) and has_same_axes(memo.rot, rot)) then
        local rolled_pos, rolled_rot = get_rolled_pose(pos, rot, posed_roll)
        memo = {
            roll = posed_roll,
            pos = { pos[1], pos[2], pos[3] },
            rot = { rot[1], rot[2], rot[3] },
            rolled_pos = rolled_pos,
            rolled_rot = rolled_rot,
        }
        rolled_memo = memo
    end
    return memo.rolled_pos, memo.rolled_rot
end

local function apply_roll(roll)
    if math.abs(roll - posed_roll) < APPLY_EPSILON then
        return
    end
    posed_roll = roll
    if math.abs(roll) < APPLY_EPSILON then
        wd_attach.set_mount_pose(MOUNT, nil)
        return
    end
    wd_attach.set_mount_pose(MOUNT, adjust_mount_pose)
end

function get_face_frame(transforms)
    return wd_frame.compose_frames(mount_frame, wd_frame.new_pose_frame(transforms.model_pos, transforms.model_rot))
end

local function get_bracer_transforms()
    return wd_bare_wrist.get_bracer_transforms() or d_bracer.get_transforms() or d_bracer_config.transforms
end

local function get_banked_transforms()
    return wd_bare_wrist.get_bracer_transforms() or d_bracer_config.transforms
end

function get_rest_roll_for(bracer_roll)
    return math.rad(bracer_roll - d_bracer_config.CLIP_ROLL)
end

function get_rest_roll()
    return get_rest_roll_for(get_banked_transforms().model_rot[3])
end

function get_idle_roll_for(bracer_roll)
    return get_rest_roll_for(bracer_roll) + math.rad(d_bracer_config.WATCH_TWIST)
end

local function get_clip_roll_offset()
    return -get_rest_roll()
end

local function new_bracer_frame(transforms)
    return wd_frame.new_pose_frame(transforms.model_pos, transforms.model_rot, transforms.model_scale)
end

function solve_roll(twist_camera, face_frame, bracer_frame)
    local bracer_camera =
        wd_frame.compose_frames(twist_camera, bracer_frame or new_bracer_frame(get_bracer_transforms()))
    local eye = wd_frame.invert_frame(bracer_camera).c
    local roll = 0
    for _ = 1, SOLVE_ITERATIONS do
        local rolled_normal = wd_frame.rotate_about_axis(face_frame.j, TUBE_AXIS, roll)
        local rolled_center = wd_frame.rotate_about_axis(face_frame.c, TUBE_AXIS, roll)
        roll = roll + wd_frame.get_signed_angle(rolled_normal, wd_frame.subtract_vec(eye, rolled_center), TUBE_AXIS)
    end
    return wd_compass.normalize_angle(roll)
end

local function get_hands_visual()
    local visual = wd_inspect.get_hands_visual()
    return visual and visual:gsub("%.ogf$", "")
end

local function read_ini_vector(section, key)
    if ini_sys:line_exist(section, key) then
        return wd_frame.read_vec(ini_sys:r_vector(section, key))
    end
    return wd_frame.new_vec(0, 0, 0)
end

local function get_hands_offset(hud_section, suffix)
    local rot = read_ini_vector(hud_section, "hands_orientation" .. suffix)
    local offset = wd_frame.new_hpb_frame(math.rad(rot.x), math.rad(rot.y), math.rad(rot.z))
    offset.c = read_ini_vector(hud_section, "hands_position" .. suffix)
    return offset
end

function get_base_offset(hud_section, suffix)
    local rot = read_ini_vector(hud_section, "base_hud_offset_rot" .. suffix)
    local offset = wd_frame.rotate_frame(wd_frame.new_hpb_frame(0, 0, 0), X_AXIS, rot.x)
    offset = wd_frame.rotate_frame(offset, Y_AXIS, rot.y)
    offset = wd_frame.rotate_frame(offset, Z_AXIS, rot.z)
    offset.c = read_ini_vector(hud_section, "base_hud_offset_pos" .. suffix)
    return offset
end

local function find_idle_motion(hud_section, visual, anm)
    local base = wd_inspect.get_motion_name(hud_section, anm)
    if base and game.motion_exists then
        return wd_inspect.find_hands_motion(visual, base)
    end
    return base
end

local function resolve_idle_motion(hud_section, visual, idle_anm)
    return find_idle_motion(hud_section, visual, idle_anm)
        or idle_anm ~= IDLE_ANM and find_idle_motion(hud_section, visual, IDLE_ANM)
        or FALLBACK_MOTION
end

local function predict_twist(source_key)
    local motion = resolve_idle_motion(source_key.hud_section, source_key.visual, source_key.idle_anm)
    local proxy = db.actor:add_attachment(PROXY_NAME, source_key.visual)
    if not proxy then
        return nil
    end
    proxy:play_motion(motion, false, 1)
    local twist = wd_frame.read_frame(proxy:bone_transform(TWIST_BONE))
    db.actor:remove_attachment(PROXY_NAME)
    local hands_twist = wd_frame.compose_frames(get_hands_offset(source_key.hud_section, source_key.suffix), twist)
    return wd_frame.compose_frames(get_base_offset(source_key.hud_section, source_key.suffix), hands_twist)
end

function get_cached_twist(source_key)
    local cached = twist_cache[source_key.key]
    if cached == nil then
        cached = predict_twist(source_key) or false
        twist_cache[source_key.key] = cached
    end
    return cached or nil
end

local function get_idle_anm(source)
    if not (source:is_weapon() and source:weapon_is_grenadelauncher()) then
        return IDLE_ANM
    end
    return source:weapon_in_grenade_mode() and GRENADE_IDLE_ANM or LAUNCHER_IDLE_ANM
end

function get_source_key(section, idle_anm)
    local visual = get_hands_visual()
    local hud_section = visual and ini_sys:r_string_ex(section, "hud")
    if not hud_section then
        return nil
    end
    idle_anm = idle_anm or IDLE_ANM
    local suffix = utils_xml.is_widescreen() and WIDE_SUFFIX or ""
    return {
        key = hud_section .. "|" .. visual .. "|" .. suffix .. "|" .. idle_anm,
        hud_section = hud_section,
        visual = visual,
        suffix = suffix,
        idle_anm = idle_anm,
    }
end

local function get_idle_roll()
    return get_idle_roll_for(get_banked_transforms().model_rot[3])
end

local function get_source()
    local actor = db.actor
    local detector = actor:active_detector()
    if detector then
        return detector
    end
    local item = actor:active_item()
    if not item or IsMelee(item) or IsBolt(item) or wd_hands_empty.is_managed_section(item:section()) then
        return nil
    end
    return item
end

local function is_solved_for(twist, face, face_transforms, bracer_transforms)
    return solved.twist == twist
        and solved.face == face
        and wd_transforms.is_same_pose(solved.face_pose, face_transforms)
        and wd_transforms.is_same_pose(solved.bracer_pose, bracer_transforms)
end

local function get_solved_roll(twist, face)
    local face_transforms = face.get_transforms()
    local bracer_transforms = get_bracer_transforms()
    if not is_solved_for(twist, face, face_transforms, bracer_transforms) then
        solved.roll = solve_roll(twist, get_face_frame(face_transforms), new_bracer_frame(bracer_transforms))
        solved.twist = twist
        solved.face = face
        solved.face_pose = wd_transforms.copy_pose(face_transforms)
        solved.bracer_pose = wd_transforms.copy_pose(bracer_transforms)
    end
    return solved.roll
end

local function get_room()
    local lo, hi = nil, nil
    for slot, room in pairs(ROOM) do
        if wd_slots.get_mounted(slot) then
            lo = math.max(lo or room.lo, room.lo)
            hi = math.min(hi or room.hi, room.hi)
        end
    end
    return lo, hi
end

local function unwrap_into_room(roll)
    return room_lo + (roll - room_lo) % FULL_TURN
end

local function fit_room(roll)
    local unwrapped = unwrap_into_room(roll)
    if unwrapped <= room_hi then
        return wd_compass.normalize_angle(unwrapped)
    end
    if unwrapped - room_hi < room_lo + FULL_TURN - unwrapped then
        return wd_compass.normalize_angle(room_hi)
    end
    return room_lo
end

local function get_roll_limits()
    if wd_slots.is_bracer_worn() then
        return BRACER_ROLL_RANGE[1], BRACER_ROLL_RANGE[2]
    end
    local idle = get_idle_roll_for(d_bracer_config.DEFAULTS.model_rot[3])
    local swept_lo, swept_hi = wd_bare_wrist.get_roll_range()
    return math.deg(swept_lo - idle), math.deg(swept_hi - idle)
end

local function get_rest_goal()
    local roll = get_idle_roll()
    if settings[ROLL_KEY] == 0 then
        return roll
    end
    roll = roll + math.rad(clamp(settings[ROLL_KEY], get_roll_limits()))
    if room_lo then
        return fit_room(roll)
    end
    return wd_compass.normalize_angle(roll)
end

local function get_roll_bounds()
    local low, high = get_roll_limits()
    local room_low, room_high = get_room()
    if room_low then
        local idle = room_low + (get_idle_roll() - room_low) % FULL_TURN
        low, high = math.max(low, math.deg(room_low - idle)), math.min(high, math.deg(room_high - idle))
    end
    return low, math.max(low, high)
end

local function get_roll_turn(from, goal)
    if room_lo then
        local start, finish = unwrap_into_room(from), unwrap_into_room(goal)
        if start <= room_hi and finish <= room_hi then
            return finish - start
        end
    end
    return wd_compass.normalize_angle(goal - from)
end

local function refresh_target(face, source)
    target_roll = get_idle_roll()
    room_lo, room_hi = get_room()
    local source_key = source and get_source_key(source:section(), get_idle_anm(source))
    local twist = source_key and get_cached_twist(source_key)
    if not twist then
        return
    end
    target_roll = get_solved_roll(twist, face)
    if room_lo then
        target_roll = fit_room(target_roll)
    end
end

local function track_source(face, inspecting, now)
    local source = get_source()
    local source_id = source and source:id() or false
    local snap = enabled and source_id ~= active_source_id and not inspecting
    active_source_id = source_id
    if enabled and not inspecting then
        if snap or now >= next_tick_at then
            next_tick_at = now + REFRESH_INTERVAL_MS
            refresh_target(face, source)
        end
    elseif now >= next_room_at then
        next_room_at = now + REFRESH_INTERVAL_MS
        room_lo, room_hi = get_room()
    end
    return snap
end

local function get_window(clip)
    return WINDOWS[clip.detector and "detector" or "weapon"][clip.kind] or FULL_WINDOW
end

local function track_clip(inspecting)
    if not inspecting then
        twisted_pose = nil
    end
    local clip = wd_inspect.get_hand_clip()
    if clip == seen_clip then
        return nil
    end
    seen_clip = clip
    if not (inspecting and clip and clip.pose) then
        return nil
    end
    twisted_pose = clip.kind ~= wd_inspect.CLIP_HOLSTER and clip.pose or nil
    return clip
end

local function get_goals(face)
    local roll = enabled and target_roll or get_rest_goal()
    if twisted_pose == wd_inspect.POSE_WATCH then
        if not face then
            return roll, math.rad(d_bracer_config.WATCH_TWIST)
        end
        return roll, wd_compass.normalize_angle(roll + get_clip_roll_offset())
    end
    if twisted_pose == wd_inspect.POSE_PROMIN and wd_slots.is_bracer_worn() then
        return roll, wd_compass.normalize_angle(get_clip_roll_offset())
    end
    return roll, 0
end

local function is_near(lhs, rhs)
    return math.abs(wd_compass.normalize_angle(lhs - rhs)) < APPLY_EPSILON
end

local function is_heading_to(roll_goal, twist_goal)
    local roll, twist = applied_roll, applied_twist
    if movement then
        roll, twist = movement.roll_goal, movement.twist_goal
    end
    return is_near(roll, roll_goal) and is_near(twist, twist_goal)
end

local function start_movement(roll_goal, twist_goal, started, length, window)
    movement = {
        roll_from = applied_roll,
        roll_turn = get_roll_turn(applied_roll, roll_goal),
        twist_from = applied_twist,
        twist_turn = twist_goal - applied_twist,
        roll_goal = roll_goal,
        twist_goal = twist_goal,
        started = started,
        length = math.max(length, 1),
        window = window,
    }
end

local function advance_movement(now)
    local phase = clamp((now - movement.started) / movement.length, 0, 1)
    local window = movement.window
    local eased = wd_frame.get_smoothstep((phase - window[1]) / (window[2] - window[1]))
    applied_roll = wd_compass.normalize_angle(movement.roll_from + movement.roll_turn * eased)
    applied_twist = movement.twist_from + movement.twist_turn * eased
    if phase >= 1 then
        movement = nil
    end
end

local function prime_layers()
    wd_hands_freelook.prime_layer_order()
    wd_inspect.prime_hand_offsets()
    wd_hands_bob.prime_left_layers()
    twist_supported = pcall(game.play_hud_anm, TWIST_ANM, TWIST_PART, 1, 0, true, true, TWIST_BONE)
    if not twist_supported then
        printf("[wd_wrist_roll] engine has no hud anm pivot bone, the arm stays untwisted")
    end
    layers_primed = true
end

local function apply_twist(twist)
    if twist_supported then
        game.play_hud_anm(TWIST_ANM, TWIST_PART, 1, twist / TWIST_UNIT, true, true, TWIST_BONE)
    end
end

local function forget_layers()
    layers_primed = false
end

local function clear_roll()
    active_source_id = nil
    seen_clip = nil
    twisted_pose = nil
    movement = nil
    target_roll = 0
    applied_roll = 0
    applied_twist = 0
    apply_roll(0)
    apply_twist(0)
    cleared = true
end

function get_applied_roll()
    return applied_roll
end

function get_target_roll()
    return target_roll
end

function get_applied_twist()
    return applied_twist
end

function update()
    if not layers_primed then
        prime_layers()
    end
    local exo = wd_exo.is_exo()
    local face = not exo and wd_slots.get_mounted(MOUNT)
    local attached = face and cleared
    if attached then
        target_roll = get_idle_roll()
        cleared = false
    elseif not (face or cleared) then
        clear_roll()
    end
    local inspecting = wd_inspect.is_pose_up()
    if not (face or not exo and (inspecting or wd_slots.is_bracer_worn())) then
        if applied_twist ~= 0 or movement then
            clear_roll()
        end
        return
    end
    local now = time_global()
    local snap = face and track_source(face, inspecting, now) or attached
    local clip = track_clip(inspecting)
    local roll_goal, twist_goal = get_goals(face)
    if snap then
        movement = nil
        applied_roll, applied_twist = roll_goal, twist_goal
    elseif not is_heading_to(roll_goal, twist_goal) then
        if clip and clip.length > 0 then
            start_movement(roll_goal, twist_goal, clip.started, clip.length, get_window(clip))
        else
            start_movement(roll_goal, twist_goal, now, RETURN_MS, FULL_WINDOW)
        end
    end
    if movement then
        advance_movement(now)
    end
    apply_roll(applied_roll)
    apply_twist(applied_twist)
end

local function is_roll_shown()
    return not enabled
end

local function is_slide_shown()
    return wd_bare_wrist.is_active()
end

local function get_roll_text(value)
    return string.format("%+.0f deg", value)
end

local function restore_settings(source_name)
    copy_settings(settings, source_name == "default" and SETTING_DEFAULTS or saved)
end

local function bind_setting(slider, key)
    slider.no_apply = true
    slider.get = function()
        return settings[key]
    end
    slider.set = function(value)
        settings[key] = value
    end
    slider.save = save_gui_settings
    slider.restore = restore_settings
    return slider
end

local function new_gui_fields()
    local roll = bind_setting(wd_gui.new_ranged_slider(get_roll_bounds), ROLL_KEY)
    roll.text = get_roll_text
    roll.is_shown = is_roll_shown
    local slide = bind_setting(wd_gui.new_slider(SLIDE_RANGE[1], SLIDE_RANGE[2]), SLIDE_KEY)
    slide.text = wd_gui.get_mm_text
    slide.is_shown = is_slide_shown
    slide.on_change = wd_bare_wrist.update
    return {
        [ENABLED_KEY] = wd_gui.new_check(is_enabled, set_enabled),
        [ROLL_KEY] = roll,
        [SLIDE_KEY] = slide,
    }
end

function add_gui_rows(fields, rows)
    gui_fields = gui_fields or new_gui_fields()
    for key, field in pairs(gui_fields) do
        fields[key] = field
    end
    rows[#rows + 1] = { SLIDE_KEY, nil, 0.001, wd_gui.FOREARM_POSITION_LABEL }
    rows[#rows + 1] = { ENABLED_KEY, nil, 1, KEEP_VISIBLE_LABEL }
    rows[#rows + 1] = { ROLL_KEY, nil, 1, ROLL_LABEL }
end

function register()
    wd_core.register({
        id = "wd_wrist_roll",
        callbacks = {
            actor_on_update = { update },
            actor_on_first_update = { forget_layers },
        },
        on_start = load_settings,
    })
end
