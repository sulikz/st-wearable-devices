local LIFT = 0.05
local SAVE_KEY = "wd_world_spawned"
local SAVE_KEY_IDS = "wd_world_spawned_ids"

local SPAWNS = {
    {
        key = "promin_map_escape_02",
        section = "wd_promin_module_map",
        level = "l01_escape",
        x = -140.46,
        y = -28.66,
        z = -352.52,
    },
    {
        key = "vektor_pole_02",
        section = "wd_vektor",
        level = "y04_pole",
        x = 63.91,
        y = 9.70,
        z = 166.99,
    },
    {
        key = "promin_map_trucks_01",
        section = "wd_promin_module_map",
        level = "k02_trucks_cemetery",
        x = 102.54,
        y = 10.34,
        z = 131.87,
    },
}

local spawned_ids = {}

function get_target_position(entry)
    return vector():set(entry.x, entry.y + LIFT, entry.z)
end

function new_placer(cfg)
    local spawns = cfg.spawns
    local spawned = {}
    local placer = {}

    function placer.set_spawns(entries)
        spawns = entries
    end

    function placer.get_spawns()
        return spawns
    end

    function placer.is_spawned(key)
        return spawned[key] == true
    end

    function placer.spawn_missing()
        if not db.actor then
            return
        end
        local level_name = level.name()
        for _, entry in ipairs(spawns) do
            if not spawned[entry.key] and level_name == entry.level and cfg.is_ready(entry) then
                local position = get_target_position(entry)
                if cfg.create(entry, position, level.vertex_id(position), db.actor:game_vertex_id()) then
                    spawned[entry.key] = true
                end
            end
        end
    end

    function placer.save_state(m_data)
        m_data[cfg.save_key] = spawned
    end

    function placer.load_state(m_data)
        spawned = m_data[cfg.save_key] or {}
    end

    return placer
end

local function is_ready(entry)
    return ini_sys:section_exist(entry.section)
end

local function create_item(entry, position, level_vertex_id, game_vertex_id)
    local se_obj = alife_create(entry.section, position, level_vertex_id, game_vertex_id)
    if not se_obj then
        return false
    end
    spawned_ids[entry.key] = se_obj.id
    alife():teleport_object(se_obj.id, game_vertex_id, level_vertex_id, position)
    return true
end

local placer = new_placer({
    save_key = SAVE_KEY,
    spawns = SPAWNS,
    is_ready = is_ready,
    create = create_item,
})

set_spawns = placer.set_spawns
is_spawned = placer.is_spawned
spawn_missing = placer.spawn_missing

function get_spawned_id(key)
    return spawned_ids[key]
end

function save_state(m_data)
    placer.save_state(m_data)
    m_data[SAVE_KEY_IDS] = spawned_ids
end

function load_state(m_data)
    placer.load_state(m_data)
    spawned_ids = m_data[SAVE_KEY_IDS] or {}
end

function register()
    wd_core.register({
        id = "wd_world_spawn",
        callbacks = {
            actor_on_first_update = { spawn_missing },
            save_state = { save_state },
            load_state = { load_state },
        },
    })
end
