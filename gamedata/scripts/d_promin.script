local SECTION = "wd_promin"
local HAND_SECTION = "wd_promin_hand"
local ATT_NAME = "wd_promin"
local ATT_MODULE_NAME = "wd_promin_module"
local MODULES_KEY = "wd_promin_modules"
local UI_BONE = "screen_bone"
local EXO_BONE = "l_forearm"
local EXO_UI_BONE = "wpn_body"

local PAGE_KEY = "wd_promin_page"
local CHARGE_KEY = "wd_promin_charge"
local IDLE_UPDATE_MS = 1000
local QUEST_REFRESH_MS = 1000
local WHEEL_SAVE_DELAY_MS = 1000
local wheel_save_deadline = nil
local page = d_promin_config.COMMS_PAGE
local preview_page = nil
local map_view = nil
local last_level_name = nil
local marks_collector = nil
local next_idle_update = 0
local allow_quest_refresh = wd_core.throttle(QUEST_REFRESH_MS)
local quest_target = nil
local quest_category = nil
local zoom_frame = nil
local map_state = { has_map = false, heading = 0 }
local map_view_scratch = {}
local mark_pool = {}
local projected_marks = {}
local quest_scratch = {}
local quest_target_pos = {}
local player_pos_scratch = {}
local modules_installed = {}
local owner

local function is_screen_shown()
    return is_worn() and not wd_attach.is_screen_hidden(ATT_NAME)
end

local function is_screen_lit()
    return is_screen_shown() and is_powered()
end

local function is_promin_pose_shown(pose)
    return pose == wd_inspect.POSE_PROMIN and is_screen_lit()
end

local glow = wd_screen.new_screen_glow({
    name = ATT_NAME,
    config = d_promin_config,
    is_lit = is_screen_lit,
})

local function get_ui()
    return _G[d_promin_config.get_ui_module()]
end

local function attach_model()
    local desc = {
        name = ATT_NAME,
        model = d_promin_config.get_model(),
        ui = d_promin_config.get_ui_module() .. ".get_ui",
        ui_bone = UI_BONE,
        transforms = d_promin_config.transforms,
    }
    if wd_exo.is_exo() then
        desc.bone = EXO_BONE
        desc.ui_bone = EXO_UI_BONE
    else
        desc.parent = d_bracer_config.SECTION
    end
    return wd_attach.attach(desc)
end

local function get_installed_index(name)
    for index, installed in ipairs(modules_installed) do
        if installed == name then
            return index
        end
    end
    return nil
end

local function get_bay_occupant_index(bay_id)
    for index, installed in ipairs(modules_installed) do
        if d_promin_config.get_module(installed).bay == bay_id then
            return index
        end
    end
    return nil
end

function get_active_bay_ids()
    if not owner.is_attached() then
        return {}
    end
    return d_promin_config.get_active_bays()
end

local function has_bay(bays, bay_id)
    for _, tier_bay_id in ipairs(bays) do
        if tier_bay_id == bay_id then
            return true
        end
    end
    return false
end

function is_bay_active(bay_id)
    return owner.is_attached() and has_bay(d_promin_config.get_active_bays(), bay_id)
end

function is_module_installed(name)
    return get_installed_index(name) ~= nil
end

function has_module(name, bays)
    if not is_module_installed(name) then
        return false
    end
    local module = d_promin_config.get_module(name)
    return module ~= nil and has_bay(bays or d_promin_config.get_active_bays(), module.bay)
end

function get_sensor_level()
    if not (owner.is_attached() and is_powered()) then
        return 0
    end
    local bays = d_promin_config.get_active_bays()
    local level = 0
    for _, name in ipairs(modules_installed) do
        local module_level = d_promin_config.get_module(name).sensor_level
        if module_level and module_level > level and has_module(name, bays) then
            level = module_level
        end
    end
    return level
end

function has_sensor_level(level)
    return get_sensor_level() >= level
end

function has_sensor_module()
    return has_sensor_level(d_promin_config.SENSOR_LEVELS.geiger)
end

function has_artefact_module()
    return has_sensor_level(d_promin_config.SENSOR_LEVELS.artefacts)
end

local artefact_sensor = wd_sensor_artefact.new({
    group = "d_promin_artefact",
    enabled = function()
        return has_artefact_module()
    end,
    on_blink = function()
        wd_audio.play("artefact_blink")
        get_ui().set_artefact_lit(true)
    end,
    off = function()
        get_ui().set_artefact_lit(false)
    end,
})

local function get_bay_attachment_name(bay_id)
    return ATT_MODULE_NAME .. "_" .. bay_id
end

local function get_bay_model(bay_id)
    for _, module in ipairs(d_promin_config.MODULES) do
        if module.bay == bay_id and module.model and has_module(module.name) then
            return module.model
        end
    end
    return d_promin_config.get_bay(bay_id).null_model
end

local function detach_module_bays()
    for _, bay in ipairs(d_promin_config.BAYS) do
        wd_attach.detach(get_bay_attachment_name(bay.id))
    end
end

local function get_active_bays()
    if wd_exo.is_exo() then
        return {}
    end
    return d_promin_config.get_active_bays()
end

local function sync_module_attachment()
    if not owner.is_attached() then
        return
    end
    local active = {}
    for _, bay_id in ipairs(get_active_bays()) do
        active[bay_id] = true
        wd_attach.attach({
            name = get_bay_attachment_name(bay_id),
            model = get_bay_model(bay_id),
            parent = d_bracer_config.SECTION,
            transforms = d_promin_config.transforms,
        })
    end
    for _, bay in ipairs(d_promin_config.BAYS) do
        if not active[bay.id] then
            wd_attach.detach(get_bay_attachment_name(bay.id))
        end
    end
end

local function is_tier_carried(tier)
    return db.actor:object(tier.section) ~= nil
end

local function eject_inactive_modules()
    for index = #modules_installed, 1, -1 do
        if not is_bay_active(d_promin_config.get_module(modules_installed[index]).bay) then
            remove_module_at(index)
        end
    end
end

owner = wd_worn.new({
    attach_label = "st_promin_attach_arm",
    detach_label = "st_promin_detach_arm",
    save_key = "wd_promin_worn",
    get_obj_value = function(obj)
        return obj and obj:section()
    end,
    on_attach = function(obj)
        if not (obj and d_promin_config.set_active_tier(obj:section())) then
            return false
        end
        eject_inactive_modules()
        if not wd_attach.get_visual_of(obj:section()) then
            return false
        end
        if attach_model() == nil then
            return false
        end
        sync_module_attachment()
        return obj:section()
    end,
    on_detach = function(replacing)
        wd_attach.detach(ATT_NAME)
        detach_module_bays()
        if not replacing then
            eject_inactive_modules()
        end
        d_promin_config.reset_active_tier()
    end,
})

function is_worn()
    return owner.is_attached()
end

local function is_attachment_present()
    return wd_attach.has_attachment(ATT_NAME)
end

function ensure_attached()
    glow.sync()
    eject_inactive_modules()
    if not owner.is_attached() then
        return
    end
    if not wd_attach.get(ATT_NAME) then
        attach_model()
    end
    for _, bay_id in ipairs(get_active_bays()) do
        if not wd_attach.get(get_bay_attachment_name(bay_id)) then
            sync_module_attachment()
            break
        end
    end
end

local function get_tier_sections()
    local sections = {}
    for _, tier in ipairs(d_promin_config.TIERS) do
        sections[#sections + 1] = tier.section
    end
    return sections
end

local function get_consumption()
    local consumption = d_promin_config.get_battery_consumption()
    for _, name in ipairs(modules_installed) do
        local module = d_promin_config.get_module(name)
        consumption = consumption + ((module and module.consumption) or 0)
    end
    return consumption
end

local battery = wd_battery.new({
    section = SECTION,
    sections = get_tier_sections(),
    get_consumption = get_consumption,
    get_item = owner.get_object,
    is_draining = function()
        return is_worn()
    end,
})

function is_powered()
    return not battery.is_dead()
end

function get_power_ratio()
    return battery.get_ratio()
end

function update_battery()
    battery.update()
end

function get_page()
    return preview_page or page
end

local function append_pages(pages, page_ids)
    for _, page_id in ipairs(page_ids or {}) do
        pages[#pages + 1] = page_id
    end
end

function get_available_pages()
    local pages = {}
    append_pages(pages, d_promin_config.get_pages())
    for _, module in ipairs(d_promin_config.MODULES) do
        if has_module(module.name) then
            append_pages(pages, module.pages)
        end
    end
    return pages
end

function has_available_page(page_id)
    for _, candidate in ipairs(get_available_pages()) do
        if candidate == page_id then
            return true
        end
    end
    return false
end

local function show_page(page_id)
    page = page_id
    get_ui().set_page(get_page())
end

function set_page(page_id)
    if has_available_page(page_id) then
        show_page(page_id)
    end
end

local function ensure_valid_page()
    if not has_available_page(page) then
        set_page(get_available_pages()[1])
    end
end

local function set_preview_page(page_id)
    preview_page = page_id
    get_ui().set_page(get_page())
end

local function show_health_page()
    set_preview_page(d_promin_config.HEALTH_PAGE)
end

local function hide_health_page()
    set_preview_page(nil)
end

local function pick_numbered_page(number, pose)
    if not is_promin_pose_shown(pose) then
        return false
    end
    local pages = get_available_pages()
    local page_id = pages[2] and pages[number]
    if not page_id then
        return false
    end
    if page_id ~= page then
        wd_audio.play("ui_button")
        show_page(page_id)
    else
        get_ui().on_page_key()
    end
    return true
end

local function get_map_view()
    if not map_view then
        map_view = wd_map_minimap.new({})
    end
    return map_view
end

local function refresh_map_level()
    local level_name = level.name()
    if level_name ~= last_level_name then
        last_level_name = level_name
        get_map_view().refresh()
    end
end

local function get_marks_collector()
    if not marks_collector then
        marks_collector = wd_map_marks.new({ max_marks = d_promin_map_ui.get_map_frame().max_marks })
    end
    return marks_collector
end

local mark_pos_scratch = { x = 0, y = 0, z = 0 }

local function project_same_level_mark(player_pos, mark, zoom, screen, out)
    mark_pos_scratch.x = mark.pos_x
    mark_pos_scratch.z = mark.pos_z
    return wd_map_minimap.project_mark_into(out, player_pos, mark_pos_scratch, zoom, screen.w, screen.h)
end

local function collect_marks(zoom, map_frame, player_pos, actor_level, range, tracked_id)
    local count = 0
    map_view_scratch.pos = player_pos
    map_view_scratch.level_id = actor_level
    map_view_scratch.range = range
    for _, mark in ipairs(get_marks_collector().get_marks(map_view_scratch)) do
        if count >= map_frame.max_marks then
            break
        end
        if mark.id ~= tracked_id then
            local slot = mark_pool[count + 1]
            if not slot then
                slot = {}
                mark_pool[count + 1] = slot
            end
            local projected = project_same_level_mark(player_pos, mark, zoom, map_frame.screen, slot)
            if projected and projected.inside then
                projected.id = mark.id
                projected.category = mark.category
                projected.icon = mark.icon
                projected.dy = player_pos.y - mark.pos_y
                count = count + 1
                projected_marks[count] = projected
            end
        end
    end
    for index = #projected_marks, count + 1, -1 do
        projected_marks[index] = nil
    end
    return projected_marks
end

local function get_zoom_frame()
    local frame = d_promin_map_ui.get_map_frame()
    local zoom = clamp(d_promin_config.transforms.map_zoom, d_promin_config.MAP_ZOOM_MIN, d_promin_config.MAP_ZOOM_MAX)
    if zoom_frame and zoom_frame.frame == frame and zoom_frame.zoom == zoom then
        return zoom_frame
    end
    local screen = frame.screen
    local span_y = zoom
    local span_x = zoom * screen.w / screen.h
    zoom_frame = {
        frame = frame,
        screen = screen,
        zoom = zoom,
        span_x = span_x,
        span_y = span_y,
        range = math.sqrt(span_x * span_x + span_y * span_y) / 2,
    }
    return zoom_frame
end

local function prefetch_attach_models()
    for _, tier in ipairs(d_promin_config.TIERS) do
        game.prefetch_model(tier.model)
    end
    for _, bay in ipairs(d_promin_config.BAYS) do
        game.prefetch_model(bay.null_model)
    end
    for _, module in ipairs(d_promin_config.MODULES) do
        if module.model then
            game.prefetch_model(module.model)
        end
    end
end

local function get_quest_category(target)
    if
        target.storyline
        or level.map_has_object_spot(target.id, "storyline_task_location") ~= 0
        or level.map_has_object_spot(target.id, "storyline_task_location_complex_timer") ~= 0
    then
        return "quest"
    end
    return "quest_secondary"
end

local function project_quest_mark(player_pos, actor_level, target_id, zoom, screen)
    local target_x, target_y, target_z, target_gvid = wd_compass.get_target_global_xyz(target_id)
    if not target_x then
        return nil
    end
    local target_pos = quest_target_pos
    target_pos.x, target_pos.y, target_pos.z = target_x, target_y, target_z
    local cross_level = wd_compass.get_level_id_of(target_gvid) ~= actor_level
    local exit_mark_id = nil
    if cross_level then
        local exit_pos, _, mark_id = wd_level_transitions.get_exit_pos(target_gvid, target_pos)
        if exit_pos then
            target_pos = exit_pos
            exit_mark_id = mark_id
        end
    end
    local projected = wd_map_minimap.project_mark_into(quest_scratch, player_pos, target_pos, zoom, screen.w, screen.h)
    if projected then
        projected.dy = player_pos.y - target_pos.y
        projected.exit_mark_id = exit_mark_id
        if cross_level then
            projected.inside = false
        end
    end
    return projected
end

local function collect_quest(target, category, zoom, screen, player_pos, actor_level)
    if not target then
        return nil
    end
    local projected = project_quest_mark(player_pos, actor_level, target.id, zoom, screen)
    if projected then
        projected.category = category
    end
    return projected
end

local function refresh_quest_target()
    if allow_quest_refresh() then
        quest_target = wd_compass.get_active_task_target()
        quest_category = quest_target and get_quest_category(quest_target) or nil
    end
    return quest_target, quest_category
end

local function is_map_page(page_id)
    return page_id == d_promin_config.MAP_PAGE
end

local function is_promin_raised()
    local active_spec = wd_inspect.get_active_spec()
    return wd_inspect.is_raised() and active_spec ~= nil and active_spec.id == SECTION
end

function is_reading()
    return is_promin_raised() and is_promin_pose_shown(wd_inspect.get_raised_pose())
end

local function apply_wheel(direction, pose)
    if not is_promin_pose_shown(pose) then
        return false
    end
    local zoom = d_promin_config.transforms.map_zoom
    local taken = get_ui().on_wheel(direction)
    if d_promin_config.transforms.map_zoom ~= zoom then
        wheel_save_deadline = time_global() + WHEEL_SAVE_DELAY_MS
    end
    return taken
end

local function update_wheel_save()
    if not wheel_save_deadline then
        return
    end
    if time_global() >= wheel_save_deadline or not is_promin_raised() then
        wheel_save_deadline = nil
        d_promin_config.save_global()
    end
end

function update_screen()
    if not (is_map_page(get_page()) and is_screen_lit()) then
        next_idle_update = 0
        return
    end
    wd_map_spots.request_refresh()
    if not is_promin_raised() then
        local now = time_global()
        if now < next_idle_update then
            return
        end
        next_idle_update = now + IDLE_UPDATE_MS
    end
    refresh_map_level()
    local view = get_map_view()
    local frame = get_zoom_frame()
    local screen = frame.screen
    local zoom = frame.zoom
    local render_device = wd_core.get_render_device()
    local state = map_state
    state.heading = wd_map_minimap.get_heading(render_device and render_device.cam_dir)
    state.zoom = zoom
    state.has_map = false
    state.layers = nil
    state.quest = nil
    local actor = db.actor
    local actor_pos = actor and actor:position()
    if view.has_map() and actor_pos then
        state.layers = view.get_layers(actor_pos, frame.span_x, frame.span_y)
        state.has_map = state.layers ~= nil
    end
    local actor_gvid = actor_pos and actor:game_vertex_id()
    local player_pos = nil
    if actor_pos then
        player_pos = player_pos_scratch
        player_pos.x, player_pos.y, player_pos.z = wd_compass.get_global_xyz(actor_pos, actor_gvid)
    end
    if player_pos then
        local actor_level = wd_compass.get_level_id_of(actor_gvid)
        local target, category = refresh_quest_target()
        state.marks = collect_marks(zoom, frame.frame, player_pos, actor_level, frame.range, target and target.id)
        state.quest = collect_quest(target, category, zoom, screen, player_pos, actor_level)
    else
        state.marks = collect_marks(zoom, frame.frame, nil, nil, 0, nil)
    end
    get_ui().update_map(state)
end

function get_menu_text(obj)
    return owner.get_menu_text(obj)
end

function toggle_attach(obj)
    wd_slots.toggle(obj)
end

function get_module_menu_text(obj)
    local module = d_promin_config.get_module_of_section(obj and obj:section())
    if not module then
        return nil
    end
    if get_installed_index(module.name) or not is_bay_active(module.bay) then
        return nil
    end
    return "st_promin_module_install"
end

function install_module(obj)
    if not get_module_menu_text(obj) then
        return
    end
    local module = d_promin_config.get_module_of_section(obj:section())
    local occupant_index = get_bay_occupant_index(module.bay)
    if occupant_index then
        remove_module_at(occupant_index)
    end
    modules_installed[#modules_installed + 1] = module.name
    alife_release(obj)
    sync_module_attachment()
    ensure_valid_page()
end

function get_installed_modules()
    local installed = {}
    for index, name in ipairs(modules_installed) do
        installed[index] = name
    end
    return installed
end

function get_remove_module_menu_text(_obj)
    if #modules_installed == 0 then
        return nil
    end
    return "st_promin_module_remove"
end

function remove_module_at(index)
    local name = modules_installed[index]
    if not name then
        return
    end
    local module = d_promin_config.get_module(name)
    table.remove(modules_installed, index)
    if db.actor and module then
        alife_create_item(module.section, db.actor)
    end
    sync_module_attachment()
    ensure_valid_page()
end

function remove_module(_obj)
    remove_module_at(#modules_installed)
end

function save_state(m_data)
    owner.save(m_data)
    m_data[PAGE_KEY] = page
    m_data[CHARGE_KEY] = battery.save()
    m_data[MODULES_KEY] = get_installed_modules()
end

function load_state(m_data)
    owner.load(m_data)
    local value = owner.get_value()
    if type(value) == "string" then
        d_promin_config.set_active_tier(value)
    end
    modules_installed = {}
    for _, name in ipairs(m_data[MODULES_KEY] or {}) do
        if d_promin_config.get_module(name) then
            modules_installed[#modules_installed + 1] = name
        end
    end
    local saved_page = m_data[PAGE_KEY]
    if not (saved_page and has_available_page(saved_page)) then
        saved_page = get_available_pages()[1]
    end
    set_page(saved_page)
    battery.load(m_data[CHARGE_KEY])
end

local function get_promin_spec()
    return {
        id = SECTION,
        eligible = function()
            return db.actor ~= nil
        end,
        get_hand_section = function()
            return d_promin_config.get_hand_section()
        end,
        hand_offsets = function(watch_stance)
            if watch_stance then
                return d_watch_config.transforms.hand_pos, d_watch_config.transforms.hand_rot
            end
            return d_promin_config.transforms.hand_pos, d_promin_config.transforms.hand_rot
        end,
        variants = function()
            return true
        end,
        looping = true,
        on_attach = function()
            get_ui().repaint()
        end,
        teardown_response = "soft",
        yields_now = function()
            return wd_blocking.is_hands_locked()
        end,
        on_wheel = apply_wheel,
    }
end

function reapply_transforms()
    local applied = wd_attach.reapply_transforms(ATT_NAME, d_promin_config.transforms)
    for _, bay in ipairs(d_promin_config.BAYS) do
        wd_attach.reapply_transforms(get_bay_attachment_name(bay.id), d_promin_config.transforms)
    end
    return applied
end

function resync_attachment()
    if not owner.is_attached() then
        return
    end
    detach_module_bays()
    if attach_model() then
        sync_module_attachment()
    end
end

local COLOR_STEP = 5
local COLOR_CHANNELS = { "Red", "Green", "Blue" }
local color_group_index = 1

local function get_color_group_index()
    return color_group_index
end

local function set_color_group_index(index)
    color_group_index = index
end

local color_rows = nil

local function get_color_rows(group_index)
    if not color_rows then
        color_rows = {}
        for index, group in ipairs(d_promin_config.COLOR_GROUPS) do
            local rows = {}
            for channel = 1, #COLOR_CHANNELS do
                rows[channel] = { group.key, channel, COLOR_STEP, COLOR_CHANNELS[channel] }
            end
            color_rows[index] = rows
        end
    end
    return color_rows[group_index]
end

local function register_gui()
    local function repaint()
        wd_inspect.repaint_active(SECTION, function()
            get_ui().repaint()
        end)
    end
    local emblem =
        wd_gui.new_catalog_enum(d_promin_config.EMBLEMS, d_promin_config.get_emblem_index, { no_apply = true })
    emblem.on_change = repaint
    local function get_int_text(value)
        return string.format("%d", math.floor(value + 0.5))
    end
    local function bind_repaint(slider)
        slider.no_apply = true
        slider.on_change = repaint
        return slider
    end
    local function new_repaint_slider(min, max)
        local slider = bind_repaint(wd_gui.new_slider(min or 0, max or 255))
        slider.text = get_int_text
        return slider
    end
    local color = new_repaint_slider()
    local brightness = bind_repaint(wd_gui.new_percent_slider())
    local hand = wd_gui.new_slider(-d_promin_config.HAND_RANGE, d_promin_config.HAND_RANGE)
    local device_spec = {
        is_worn = is_worn,
        store = function()
            return d_promin_config.transforms
        end,
        saved = function()
            return d_promin_config.saved
        end,
        defaults = function()
            return d_promin_config.get_defaults()
        end,
        save_global = d_promin_config.save_global,
        on_apply = reapply_transforms,
        fields = {
            hand_pos = hand,
            hand_rot = wd_gui.new_slider(-90, 90),
            model_pos = wd_gui.new_slider(-0.3, 0.3),
            model_rot = wd_gui.new_slider(-180, 180),
            model_scale = wd_gui.new_slider(0.01, 3),
            ui_pos = wd_gui.new_slider(-0.3, 0.3),
            ui_rot = wd_gui.new_slider(-180, 180),
            ui_scale = wd_gui.new_slider(0.01, 3),
            emblem = emblem,
            brightness = brightness,
            map_x = wd_gui.new_slider(-0.05, 0.05),
            map_y = wd_gui.new_slider(-0.05, 0.05),
            map_scale = wd_gui.new_slider(0.1, 3),
        },
    }
    for _, group in ipairs(d_promin_config.COLOR_GROUPS) do
        device_spec.fields[group.key] = color
    end
    device_spec.id = SECTION
    device_spec.label = "Promin"
    wd_gui.register_device(device_spec)
    local hand_spec = {
        id = HAND_SECTION,
        label = "L-Hand",
        rank = 2,
        is_worn = wd_slots.is_bracer_worn,
        store = function()
            return setmetatable({
                watch_hand_pos = d_watch_config.transforms.hand_pos,
                watch_hand_rot = d_watch_config.transforms.hand_rot,
            }, { __index = d_promin_config.transforms })
        end,
        saved = function()
            return setmetatable({
                watch_hand_pos = d_watch_config.saved.hand_pos,
                watch_hand_rot = d_watch_config.saved.hand_rot,
            }, { __index = d_promin_config.saved })
        end,
        defaults = function()
            return setmetatable({
                watch_hand_pos = d_watch_config.DEFAULTS.hand_pos,
                watch_hand_rot = d_watch_config.DEFAULTS.hand_rot,
            }, { __index = d_promin_config.get_defaults() })
        end,
        save_global = function()
            local promin_ok = d_promin_config.save_global()
            local watch_ok = d_watch_config.save_global()
            return promin_ok and watch_ok
        end,
        on_apply = function() end,
        fields = {
            hand_pos = hand,
            hand_rot = wd_gui.new_slider(-90, 90),
            watch_hand_pos = wd_gui.new_slider(-d_promin_config.HAND_RANGE, d_promin_config.HAND_RANGE),
            watch_hand_rot = wd_gui.new_slider(-90, 90),
        },
    }
    wd_gui.register_device(hand_spec)
    wd_gui.register_tab({
        device = SECTION,
        id = "promin_skin",
        label = "Promin",
        rows = {
            { "brightness", nil, 5, "Brightness" },
        },
        picker = {
            options = d_promin_config.COLOR_GROUPS,
            get = get_color_group_index,
            set = set_color_group_index,
            rows = get_color_rows,
        },
    })
    local function get_hand_rows(pos_field, rot_field)
        return {
            { pos_field, 1, d_promin_config.HAND_STEP, "Position x" },
            { pos_field, 2, d_promin_config.HAND_STEP, "Position y" },
            { pos_field, 3, d_promin_config.HAND_STEP, "Position z" },
            { rot_field, 1, 0.5, "Pitch (X)" },
            { rot_field, 2, 0.5, "Yaw (Y)" },
            { rot_field, 3, 0.5, "Roll (Z)" },
        }
    end
    local HAND_ROWS = {
        promin = get_hand_rows("hand_pos", "hand_rot"),
        watch = get_hand_rows("watch_hand_pos", "watch_hand_rot"),
        free = {},
    }
    wd_gui.register_tab({
        device = HAND_SECTION,
        id = "promin_hand",
        label = "Hand",
        rows = function()
            return HAND_ROWS[wd_gui.get_pose()] or HAND_ROWS.free
        end,
    })
    wd_gui.register_tab({
        device = SECTION,
        id = "promin_model",
        dev = true,
        label = "Device Position",
        rows = {
            { "model_pos", 1, 0.0005, "Position x" },
            { "model_pos", 2, 0.0005, "Position y" },
            { "model_pos", 3, 0.0005, "Position z" },
            { "model_rot", 1, 0.25, "Yaw (Y)" },
            { "model_rot", 2, 0.25, "Pitch (X)" },
            { "model_rot", 3, 0.25, "Roll (Z)" },
            { "model_scale", nil, 0.005, "Scale" },
        },
    })
    wd_gui.register_tab({
        device = SECTION,
        id = "promin_ui",
        dev = true,
        label = "Display Position",
        rows = {
            { "ui_pos", 1, 0.0005, "Position x" },
            { "ui_pos", 2, 0.0005, "Position y" },
            { "ui_pos", 3, 0.0005, "Position z" },
            { "ui_rot", 1, 1, "Yaw (Y)" },
            { "ui_rot", 2, 1, "Pitch (X)" },
            { "ui_rot", 3, 1, "Roll (Z)" },
            { "ui_scale", nil, 0.01, "Scale" },
        },
    })
    wd_gui.register_tab({
        device = SECTION,
        id = "promin_emblem",
        dev = true,
        label = "Emblem",
        rows = {
            { "emblem", nil, 1, "Emblem" },
        },
    })
    wd_gui.register_tab({
        device = SECTION,
        id = "promin_map",
        dev = true,
        label = "Map",
        rows = {
            { "map_x", nil, 0.001, "Offset x" },
            { "map_y", nil, 0.001, "Offset y" },
            { "map_scale", nil, 0.01, "Scale" },
        },
    })
end

function update_bleed_audio()
    if owner.is_attached() and is_powered() then
        wd_bleed.update()
    else
        wd_bleed.reset()
    end
end

local function has_tier_item()
    for _, tier in ipairs(d_promin_config.TIERS) do
        if is_tier_carried(tier) then
            return true
        end
    end
    return false
end

function update_artefact_sensor()
    artefact_sensor.update()
end

function actor_on_first_update()
    wd_bleed.reset()
    artefact_sensor.reset()
    if has_tier_item() then
        get_ui().get_ui()
        prefetch_attach_models()
    end
end

local function build_consumption_line(consumption)
    local units = { "st_ah_sec", "st_mah_sec", "st_uah_sec", "st_pah_sec" }
    local value = consumption
    local unit_index = 1
    while value < 1 and unit_index < #units do
        value = value * 1000
        unit_index = unit_index + 1
    end
    return utils_xml.get_color("d_purple")
        .. "  "
        .. string.char(149)
        .. " "
        .. utils_xml.get_color("ui_gray_2")
        .. " "
        .. game.translate_string("st_ui_power_consumption")
        .. ": "
        .. utils_xml.get_color("ui_gray_1")
        .. tostring(value)
        .. " "
        .. game.translate_string(units[unit_index])
        .. " \\n"
end

local function get_section_consumption(section)
    local tier = d_promin_config.get_tier_of(section)
    if tier then
        return tier.consumption
    end
    local module = d_promin_config.get_module_of_section(section)
    return module and module.consumption
end

function install_description_hook()
    if _G.wd_promin_desc_wrapped then
        return
    end
    if not (ui_item and ui_item.build_desc_footer and utils_xml and utils_xml.get_color) then
        return
    end
    local base_build_desc_footer = ui_item.build_desc_footer
    ui_item.build_desc_footer = function(obj, sec, str)
        local result = base_build_desc_footer(obj, sec, str)
        local consumption = get_section_consumption(sec)
        if consumption and result and result ~= "" then
            result = result
                .. utils_xml.get_color("ui_gray_1")
                .. " "
                .. game.translate_string("st_itm_desc_properties")
                .. ":\\n"
                .. build_consumption_line(consumption)
        end
        return result
    end
    _G.wd_promin_desc_wrapped = true
end

function register()
    wd_slots.register_device({
        id = "promin",
        slot = "forearm",
        matches_section = function(section)
            return d_promin_config.get_tier_of(section) ~= nil
        end,
        owner = owner,
        is_present = is_attachment_present,
        resync = ensure_attached,
    })
    wd_inspect.register(get_promin_spec())
    wd_inspect.register_number_key(pick_numbered_page)
    wd_qaw_preview.register_preview(wd_inspect.POSE_PROMIN, {
        is_ready = is_screen_lit,
        show = show_health_page,
        hide = hide_health_page,
    })
    wd_geiger.set_link_check(function()
        return has_sensor_module()
    end)
    wd_exo.register_device({
        id = "promin",
        names = { ATT_NAME },
        on_change = function(exo)
            d_promin_config.set_variant(exo and d_promin_config.VARIANT_EXO or nil)
            ensure_valid_page()
        end,
        resync = resync_attachment,
    })
    wd_core.register({
        id = SECTION,
        callbacks = {
            actor_on_first_update = { actor_on_first_update },
            actor_on_update = {
                { ensure_attached, interval = 200 },
                update_battery,
                update_screen,
                update_wheel_save,
                update_bleed_audio,
                { update_artefact_sensor, interval = 200 },
            },
            actor_on_item_take = { artefact_sensor.rescan },
            actor_on_item_drop = { artefact_sensor.rescan },
            save_state = { save_state },
            load_state = { load_state },
        },
        on_start = function()
            install_description_hook()
            battery.reset()
            modules_installed = {}
            d_promin_config.load_transforms()
            get_ui().repaint()
            last_level_name = nil
            next_idle_update = 0
            wheel_save_deadline = nil
        end,
    })
    wd_trader.register(d_promin_config.TIERS[1].section, 1)
    register_gui()
end
