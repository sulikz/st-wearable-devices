    { "dig_scale", false },
    { "ring_ui_pos", true },
    { "ring_ui_scale", false },
    { "ring_offset", false },
    { "arrow_ui_pos", true },
    { "arrow_ui_scale", false },
    { "compass_offset", false },
    { "brightness", false },
    { "status_bar", false },
}

local USER_FIELDS = {
    "brightness",
    "status_bar",
}

DEFAULTS = {
    model_pos = { 0.0002, -0.0072, 0.1237 },
    model_rot = { -89.099, 0.587, -177.99 },
    model_scale = 1.5600000314713,
    ui_pos = { -0.015799999237061, 0.026469984276295, 0.015299993813038 },
