        ui = "d_vektor_ui",
        ring_ui = "d_vektor_ring_ui",
        arrow_ui = "d_vektor_arrow_ui",
        sensors = { anomaly = true, artefact = true },
        defaults = {},
    },
}

STATUS_BARS = {
    { name = "dynamic", label = "Dynamic" },
    { name = "stamina", label = "Stamina" },
    { name = "toxic", label = "Toxic Air" },
}

