BULB_LIT_TEXTURE = "wd\\vektor\\vektor_led_lit"
BULBS = { "artefact", "anomaly" }

function get_bulb_texture(lit)
    return lit and BULB_LIT_TEXTURE or BULB_TEXTURE
end

