SECTION = "wd_vektor"
LIGHT_OFFSET = { 0.008, 0.1, 0 }
LED_ANOMALY_COLOR = { r = 0.34, g = 0.12, b = 0.1, a = 0.8 }
LED_RAD_COLOR = { r = 0.34, g = 0.26, b = 0.19, a = 0.8 }
LED_RANGE = 0.25
LED_ANOMALY_OFFSET = { -0.0178, 0.045, 0.0033 }
LED_RAD_OFFSET = { -0.016, 0.045, 0.011 }
BULB_TEXTURE = "wd\\vektor\\vektor_led_unlit"
BULB_LIT_TEXTURE = "wd\\vektor\\vektor_led_lit"
BULBS = { "rad", "anomaly" }

SCREEN = {
    rect = { x = 0.002, y = 0.0015, width = 0.04, height = 0.04 },
    opening_radius = 0.939,
    shader = "wd\\crt_vektor",
    arc_shader = "wd\\crt_vektor_arc",
    body_shader = "wd\\crt_vektor_body",
}

FACES = { 1, 2, 3, 4 }
LIMBS_FACE_ID = 4

function get_bulb_texture(lit)
    return lit and BULB_LIT_TEXTURE or BULB_TEXTURE
end

TIERS = {
    {
        id = "t1",
        section = SECTION,
        model = "wd\\vektor\\vektor_t1",
        sensors = {},
        defaults = {},
    },
    {
        id = "t2",
        section = "wd_vektor_2",
        model = "wd\\vektor\\vektor_t2",
        sensors = { anomaly = true, rad = true },
        defaults = {},
    },
}

STATUS_BARS = {
    { name = "dynamic", label = "Dynamic" },
    { name = "stamina", label = "Stamina" },
    { name = "toxic", label = "Toxic Air" },
    { name = "hp", label = "Health" },
}

local FAMILY_FIELDS = {
    { "model_pos", true },
    { "model_rot", true },
    { "model_scale", false },
    { "ui_pos", true },
    { "ui_rot", true },
    { "ui_scale", false },
    { "brightness", false },
    { "status_bar", false },
    { "time_source", false },
    { "time_format", false },
    { "face_id", false },
}

local USER_FIELDS = {
    "brightness",
    "status_bar",
    "time_source",
    "time_format",
    "face_id",
}

DEFAULTS = {
    model_pos = { 0.0002, -0.0072, 0.1237 },
    model_rot = { -89.099, 0.587, -177.99 },
    model_scale = 1.5600000314713,
    ui_pos = { -0.015799999237061, 0.026469984276295, 0.015299993813038 },
    ui_rot = { 0, 90, 0 },
    ui_scale = 0.72100001573563,
    brightness = 90,
    status_bar = "dynamic",
    time_source = "game",
    time_format = "24h",
    face_id = 2,
}

local cfg = wd_config.new({
    section = SECTION,
    global_key = "vektor",
    tiers = TIERS,
    family_fields = FAMILY_FIELDS,
    user_fields = USER_FIELDS,
    defaults = DEFAULTS,
})

transforms = cfg.transforms
saved = cfg.saved
reset_transforms = cfg.reset_transforms
load_transforms = cfg.load_transforms
save_global = cfg.save_global
get_active_tier = cfg.get_active_tier
get_tier_of = cfg.get_tier_of
set_active_tier = cfg.set_active_tier
reset_active_tier = cfg.reset_active_tier
get_model = cfg.get_model
has_sensor = cfg.has_sensor
resolve = cfg.resolve

function get_status_bar_index()
    return wd_appearance.get_index(transforms, STATUS_BARS, "status_bar")
end

function get_status_bar()
    local name = transforms.status_bar
    if name == "toxic" and not wd_toxic.is_installed() then
        return "dynamic"
    end
    return name
end
