    brightness = 80,
    status_bar = "dynamic",
}

local cfg = wd_config.new({
    section = SECTION,
    global_key = "vektor",
    tiers = TIERS,
    family_fields = FAMILY_FIELDS,
    user_fields = USER_FIELDS,
    defaults = DEFAULTS,
})

transforms = cfg.transforms
saved = cfg.saved
reset_transforms = cfg.reset_transforms
load_transforms = cfg.load_transforms
save_global = cfg.save_global
get_active_tier = cfg.get_active_tier
get_tier_of = cfg.get_tier_of
set_active_tier = cfg.set_active_tier
reset_active_tier = cfg.reset_active_tier
get_model = cfg.get_model
get_ui_module = cfg.get_ui_module
has_sensor = cfg.has_sensor
resolve = cfg.resolve

function get_status_bar_index()
    return wd_appearance.get_index(transforms, STATUS_BARS, "status_bar")
end

function get_status_bar()
    local name = transforms.status_bar
    if name == "toxic" and not wd_toxic.is_installed() then
        return "dynamic"
    end
    return name
end
