local registry = {}
local order = {}
local timed = {}
local wired = false
local render_device = nil

function register(spec)
    if type(spec) ~= "table" or not spec.id then
        return false
    end
    if not registry[spec.id] then
        order[#order + 1] = spec.id
    end
    registry[spec.id] = spec
    return true
end

function get(id)
    return registry[id]
end

function get_devices()
    local out = {}
    for device_index = 1, #order do
        out[device_index] = registry[order[device_index]]
    end
    return out
end

function clear()
    registry = {}
    order = {}
    timed = {}
    wired = false
end

function get_time_ms()
    return time_global()
end

function get_render_device()
    render_device = render_device or device()
    return render_device
end

function throttle(interval_ms)
    local next_at = 0
    return function(now)
        now = now or time_global()
        if now < next_at then
            return false
        end
        next_at = now + interval_ms
        return true
    end
end

local function new_guarded_handler(handler)
    local fn = handler[1]
    local unless = handler.unless
    if not unless then
        return fn
    end
    return function(...)
        if unless() then
            return
        end
        return fn(...)
    end
end

local function new_timed_dispatcher(entries)
    return function(...)
        local now = time_global()
        for entry_index = 1, #entries do
            local entry = entries[entry_index]
            if now >= entry.next_at then
                entry.next_at = now + entry.interval
                entry.fn(...)
            end
        end
    end
end

local function add_timed_handler(event, fn, interval_ms)
    local entries = timed[event]
    if not entries then
        entries = {}
        timed[event] = entries
        RegisterScriptCallback(event, new_timed_dispatcher(entries))
    end
    entries[#entries + 1] = { fn = fn, interval = interval_ms, next_at = 0 }
end

function wire(spec)
    local callbacks = spec and spec.callbacks
    if not callbacks then
        return
    end
    for event, handlers in pairs(callbacks) do
        for handler_index = 1, #handlers do
            local handler = handlers[handler_index]
            if type(handler) ~= "table" then
                RegisterScriptCallback(event, handler)
            else
                local interval = handler.interval
                if interval then
                    add_timed_handler(event, new_guarded_handler(handler), interval)
                else
                    RegisterScriptCallback(event, new_guarded_handler(handler))
                end
            end
        end
    end
end

function start()
    local list = get_devices()
    if not wired then
        for device_index = 1, #list do
            wire(list[device_index])
        end
        wired = true
    end
    for device_index = 1, #list do
        local spec = list[device_index]
        if spec.on_start then
            spec.on_start()
        end
    end
end
