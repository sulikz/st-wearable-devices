SLIM_VISUAL_DIR = "wd\\hands\\slim\\"
LEFT_SECTION = "wd_hands_left"

local UNKNOWN = "_unknown"

local items = {}
local applied_key = UNKNOWN
local visuals_by_outfit = {}

function register_item(id, is_worn)
    items[id] = is_worn
end

local function is_any_item_worn()
    for _, is_worn in pairs(items) do
        if is_worn() then
            return true
        end
    end
    return false
end

local function get_slim_visual(sys, hands_section)
    local base_visual = sys:r_string_ex(hands_section, "visual_2") or sys:r_string_ex(hands_section, "visual")
    if not base_visual or base_visual == "" then
        return nil
    end
    local stem = base_visual:match("([^\\/]+)$")
    if not stem then
        return nil
    end
    stem = stem:gsub("%.ogf$", "")
    local slim_visual = SLIM_VISUAL_DIR .. stem
    if not getFS():exist("$game_meshes$", slim_visual .. ".ogf") then
        return nil
    end
    return slim_visual
end

local function resolve_visuals(hands_section)
    local sys = system_ini()
    if not sys:section_exist(LEFT_SECTION) or not sys:section_exist(hands_section) then
        return nil
    end
    local visual = sys:r_string_ex(hands_section, "visual")
    local slim_visual = get_slim_visual(sys, hands_section)
    if not visual or not slim_visual then
        return nil
    end
    return { visual = visual, visual_2 = slim_visual, key = visual .. "|" .. slim_visual }
end

local function write_left_section(visuals)
    local sys = system_ini()
    sys:set_readonly(false)
    sys:set_override_names(true)
    sys:w_string(LEFT_SECTION, "visual", visuals.visual)
    sys:w_string(LEFT_SECTION, "visual_2", visuals.visual_2)
    sys:set_override_names(false)
    sys:set_readonly(true)
end

function get_base_hands_section()
    return wd_outfit.get_hands_section(wd_outfit.get_key()) or wd_outfit.DEFAULT_HANDS
end

local function get_target_visuals()
    if not is_any_item_worn() then
        return nil
    end
    local outfit_key = wd_outfit.get_key()
    local cached = visuals_by_outfit[outfit_key]
    if cached == nil then
        local hands_section = wd_outfit.get_hands_section(outfit_key)
        cached = (hands_section and resolve_visuals(hands_section)) or false
        visuals_by_outfit[outfit_key] = cached
    end
    return cached or nil
end

function apply()
    local target = get_target_visuals()
    local key = target and target.key
    if key == applied_key then
        return
    end
    local hud = get_player_hud()
    if not hud then
        return
    end
    if target then
        write_left_section(target)
        hud:set_hands(LEFT_SECTION)
    else
        hud:set_hands(get_base_hands_section())
        hud:reset_hands()
    end
    applied_key = key
end

function reset()
    applied_key = UNKNOWN
end

function register()
    wd_core.register({
        id = "wd_hands_left",
        callbacks = {
            actor_on_update = { apply },
        },
        on_start = reset,
    })
end
