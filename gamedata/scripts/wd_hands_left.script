FLAT_EXO_DIR = "wd\\hands\\flat_exo\\"
LEFT_SECTION = "wd_hands_left"

local UNKNOWN = "_unknown"

local sources = {}
local base_visuals = {}
local left_sources = {}
local flat_exo_visuals = {}
local applied_visual = UNKNOWN
local applied_visual_2 = UNKNOWN
local motion_owner = nil

local function is_source_before(first, second)
    if first.priority ~= second.priority then
        return first.priority < second.priority
    end
    return first.id < second.id
end

local function is_always_worn()
    return true
end

local function is_never_building()
    return false
end

function register_source(id, source, priority, is_worn, is_source_building)
    for index, entry in ipairs(sources) do
        if entry.id == id then
            table.remove(sources, index)
            break
        end
    end
    sources[#sources + 1] = {
        id = id,
        source = source,
        priority = priority,
        is_worn = is_worn or is_always_worn,
        is_building = is_source_building or is_never_building,
    }
    table.sort(sources, is_source_before)
end

function register_motion_owner(owner)
    motion_owner = owner
end

local function is_any_source_building()
    for index = 1, #sources do
        if sources[index].is_building() then
            return true
        end
    end
    return false
end

function is_building()
    return is_any_source_building() and get_outfit_hands_section() ~= nil
end

local function is_any_source_worn()
    for index = 1, #sources do
        if sources[index].is_worn() then
            return true
        end
    end
    return false
end

local function read_left_source(hands_section)
    local sys = system_ini()
    local visual = sys:r_string_ex(hands_section, "visual_2") or sys:r_string_ex(hands_section, "visual")
    if not visual or visual == "" then
        return false
    end
    return (visual:gsub("%.ogf$", ""))
end

function get_left_source(hands_section)
    local left_source = left_sources[hands_section]
    if left_source == nil then
        left_source = read_left_source(hands_section)
        left_sources[hands_section] = left_source
    end
    return left_source or nil
end

local function read_flat_exo_visual(hands_section)
    local stem = (get_left_source(hands_section) or ""):match("([^\\/]+)$")
    if not stem then
        return false
    end
    local flat_exo_visual = FLAT_EXO_DIR .. stem
    if not getFS():exist("$game_meshes$", flat_exo_visual .. ".ogf") then
        return false
    end
    return flat_exo_visual
end

function get_flat_exo_visual(hands_section)
    local flat_exo_visual = flat_exo_visuals[hands_section]
    if flat_exo_visual == nil then
        flat_exo_visual = read_flat_exo_visual(hands_section)
        flat_exo_visuals[hands_section] = flat_exo_visual
    end
    return flat_exo_visual or nil
end

local function read_base_visual(hands_section)
    local sys = system_ini()
    if not sys:section_exist(LEFT_SECTION) or not sys:section_exist(hands_section) then
        return false
    end
    return sys:r_string_ex(hands_section, "visual") or false
end

local function get_base_visual(hands_section)
    local base_visual = base_visuals[hands_section]
    if base_visual == nil then
        base_visual = read_base_visual(hands_section)
        base_visuals[hands_section] = base_visual
    end
    return base_visual
end

local function write_left_section(visual, visual_2)
    local sys = system_ini()
    sys:set_readonly(false)
    sys:set_override_names(true)
    sys:w_string(LEFT_SECTION, "visual", visual)
    sys:w_string(LEFT_SECTION, "visual_2", visual_2)
    sys:set_override_names(false)
    sys:set_readonly(true)
end

function get_outfit_hands_section()
    return wd_outfit.get_hands_section(wd_outfit.get_key())
end

function get_base_hands_section()
    return get_outfit_hands_section() or wd_outfit.DEFAULT_HANDS
end

local function get_target_visuals()
    if not (applied_visual_2 or is_any_source_worn()) then
        return nil
    end
    local hands_section = get_outfit_hands_section()
    if not hands_section then
        return nil
    end
    local visual = get_base_visual(hands_section)
    if not visual then
        return nil
    end
    for _, entry in ipairs(sources) do
        local visual_2 = entry.source(hands_section)
        if visual_2 then
            return visual, visual_2
        end
    end
    return nil
end

function apply()
    local visual, visual_2 = get_target_visuals()
    if visual == applied_visual and visual_2 == applied_visual_2 then
        return
    end
    if motion_owner and motion_owner.is_swap_blocked() then
        return
    end
    local hud = get_player_hud()
    if not hud then
        return
    end
    if visual_2 then
        wd_build_probe.enter("hands_swap")
        write_left_section(visual, visual_2)
        hud:set_hands(LEFT_SECTION)
        wd_build_probe.leave("hands_swap")
    else
        wd_build_probe.enter("hands_reset")
        hud:set_hands(get_base_hands_section())
        hud:reset_hands()
        wd_build_probe.leave("hands_reset")
    end
    applied_visual, applied_visual_2 = visual, visual_2
    if motion_owner then
        motion_owner.on_swap()
    end
end

function reset()
    applied_visual, applied_visual_2 = UNKNOWN, UNKNOWN
end

function register()
    wd_core.register({
        id = "wd_hands_left",
        callbacks = {
            actor_on_update = { apply },
        },
        on_start = reset,
    })
end
