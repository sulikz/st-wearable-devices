function new_vec(x, y, z)
    return { x = x, y = y, z = z }
end

function read_vec(vec)
    return new_vec(vec.x, vec.y, vec.z)
end

local function add_vec(lhs, rhs)
    return new_vec(lhs.x + rhs.x, lhs.y + rhs.y, lhs.z + rhs.z)
end

function subtract_vec(lhs, rhs)
    return new_vec(lhs.x - rhs.x, lhs.y - rhs.y, lhs.z - rhs.z)
end

local function scale_vec(vec, factor)
    return new_vec(vec.x * factor, vec.y * factor, vec.z * factor)
end

local function get_dot(lhs, rhs)
    return lhs.x * rhs.x + lhs.y * rhs.y + lhs.z * rhs.z
end

local function get_cross(lhs, rhs)
    return new_vec(lhs.y * rhs.z - lhs.z * rhs.y, lhs.z * rhs.x - lhs.x * rhs.z, lhs.x * rhs.y - lhs.y * rhs.x)
end

local function get_length(vec)
    return math.sqrt(get_dot(vec, vec))
end

local function normalize_vec(vec)
    local length = get_length(vec)
    if length < 1e-9 then
        return new_vec(0, 0, 0)
    end
    return scale_vec(vec, 1 / length)
end

function read_frame(mat)
    return { i = read_vec(mat.i), j = read_vec(mat.j), k = read_vec(mat.k), c = read_vec(mat.c) }
end

function new_hpb_frame(yaw, pitch, roll)
    local sin_yaw, cos_yaw = math.sin(yaw), math.cos(yaw)
    local sin_pitch, cos_pitch = math.sin(pitch), math.cos(pitch)
    local sin_roll, cos_roll = math.sin(roll), math.cos(roll)
    local cc = cos_yaw * cos_roll
    local cs = cos_yaw * sin_roll
    local sc = sin_yaw * cos_roll
    local ss = sin_yaw * sin_roll
    return {
        i = new_vec(cc - sin_pitch * ss, -cos_pitch * sin_roll, sin_pitch * cs + sc),
        j = new_vec(sin_pitch * sc + cs, cos_pitch * cos_roll, ss - sin_pitch * cc),
        k = new_vec(-cos_pitch * sin_yaw, sin_pitch, cos_pitch * cos_yaw),
        c = new_vec(0, 0, 0),
    }
end

function new_xyzi_frame(x, y, z)
    return new_hpb_frame(-y, -x, -z)
end

function new_pose_frame(pos, rot_deg, scale)
    local frame = new_hpb_frame(math.rad(rot_deg[1]), math.rad(rot_deg[2]), math.rad(rot_deg[3]))
    local factor = scale or 1
    frame.i = scale_vec(frame.i, factor)
    frame.j = scale_vec(frame.j, factor)
    frame.k = scale_vec(frame.k, factor)
    frame.c = new_vec(pos[1], pos[2], pos[3])
    return frame
end

local function transform_dir(frame, vec)
    return add_vec(add_vec(scale_vec(frame.i, vec.x), scale_vec(frame.j, vec.y)), scale_vec(frame.k, vec.z))
end

function transform_point(frame, vec)
    return add_vec(transform_dir(frame, vec), frame.c)
end

function compose_frames(parent, child)
    return {
        i = transform_dir(parent, child.i),
        j = transform_dir(parent, child.j),
        k = transform_dir(parent, child.k),
        c = transform_point(parent, child.c),
    }
end

function invert_frame(frame)
    local col_x = get_cross(frame.j, frame.k)
    local col_y = get_cross(frame.k, frame.i)
    local col_z = get_cross(frame.i, frame.j)
    local inv_det = 1 / get_dot(frame.i, col_x)
    local inverted = {
        i = scale_vec(new_vec(col_x.x, col_y.x, col_z.x), inv_det),
        j = scale_vec(new_vec(col_x.y, col_y.y, col_z.y), inv_det),
        k = scale_vec(new_vec(col_x.z, col_y.z, col_z.z), inv_det),
        c = new_vec(0, 0, 0),
    }
    inverted.c = scale_vec(transform_dir(inverted, frame.c), -1)
    return inverted
end

function rotate_about_axis(vec, axis, angle)
    local cos_angle, sin_angle = math.cos(angle), math.sin(angle)
    return add_vec(
        add_vec(scale_vec(vec, cos_angle), scale_vec(get_cross(axis, vec), sin_angle)),
        scale_vec(axis, get_dot(axis, vec) * (1 - cos_angle))
    )
end

function rotate_frame(frame, axis, angle)
    return {
        i = rotate_about_axis(frame.i, axis, angle),
        j = rotate_about_axis(frame.j, axis, angle),
        k = rotate_about_axis(frame.k, axis, angle),
        c = rotate_about_axis(frame.c, axis, angle),
    }
end

function get_hpb(frame)
    local row_i = normalize_vec(frame.i)
    local row_j = normalize_vec(frame.j)
    local row_k = normalize_vec(frame.k)
    local cos_pitch = math.sqrt(row_j.y * row_j.y + row_i.y * row_i.y)
    if cos_pitch > 1e-6 then
        return -math.atan2(row_k.x, row_k.z), -math.atan2(-row_k.y, cos_pitch), -math.atan2(row_i.y, row_j.y)
    end
    return -math.atan2(-row_i.z, row_i.x), -math.atan2(-row_k.y, cos_pitch), 0
end

function get_signed_angle(from, to, axis)
    local from_flat = subtract_vec(from, scale_vec(axis, get_dot(from, axis)))
    local to_flat = subtract_vec(to, scale_vec(axis, get_dot(to, axis)))
    return math.atan2(get_dot(axis, get_cross(from_flat, to_flat)), get_dot(from_flat, to_flat))
end
