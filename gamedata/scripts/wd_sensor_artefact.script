local ARTEFACT = {
    [clsid.artefact] = true,
    [clsid.artefact_s] = true,
}

local KIND = {
    i_arty = true,
    i_arty_junk = true,
}

local kind_by_section = {}

local function get_kind(section)
    local kind = kind_by_section[section]
    if kind == nil then
        kind = ini_sys:r_string_ex(section, "kind") or ""
        kind_by_section[section] = kind
    end
    return kind
end

local function is_artefact(obj)
    return ARTEFACT[obj:clsid()] == true and KIND[get_kind(obj:section())] == true
end

function new(cfg)
    cfg.sense = wd_sensor_proximity.new({
        predicate = is_artefact,
        max_distance = cfg.max_distance or 30,
        min_repeat = 1500,
        max_repeat = 1500,
    })
    return wd_sensor_pulse.new(cfg)
end
