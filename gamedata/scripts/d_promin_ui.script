local IDLE_UPDATE_MS = 250
local XML_FILE = "ui_wd.xml"
local WINDOW = "wd"
local NODE_PREFIX = "wd:"
local DEFAULT_PAGE = d_promin_config.COMMS_PAGE
local MAP_PAGE = d_promin_config.MAP_PAGE

local DEFAULT_THEME = d_promin_config.DEFAULT_THEME

local THEME_BUILDERS = {
    [DEFAULT_THEME] = {
        [d_promin_config.HEALTH_PAGE] = d_promin_health_ui.build,
        [MAP_PAGE] = d_promin_map_ui.build,
        [d_promin_config.COMMS_PAGE] = d_promin_comms_ui.build,
    },
    [d_promin_config.LARGE_THEME] = {
        [d_promin_config.HEALTH_PAGE] = d_promin_health_large_ui.build,
        [MAP_PAGE] = d_promin_map_ui.build,
        [d_promin_config.COMMS_PAGE] = d_promin_comms_ui.build,
    },
}
local PAGE_BUILDERS = THEME_BUILDERS[DEFAULT_THEME]

local active_page_id = DEFAULT_PAGE
local singleton = nil
local artefact_lit = false

local allow_idle_update = wd_core.throttle(IDLE_UPDATE_MS)

local function is_powered()
    return d_promin.is_powered()
end

class("UIPromin")(CUIScriptWnd)

function UIPromin:__init()
    super()
    self:Show(true)
    self:Enable(true)
    local xml = CScriptXmlInit()
    xml:ParseFile(XML_FILE)
    xml:InitWindow(WINDOW, 0, self)
    self.init = function(id)
        return xml:InitStatic(NODE_PREFIX .. id, self)
    end
    self.themes = {}
    self.powered_state = true
    self:select_theme(d_promin_config.get_theme())
    self:apply_page()
end

function UIPromin:select_theme(theme)
    self.theme = theme
    self.pages = self.themes[theme] or {}
    self.themes[theme] = self.pages
    self.ctx = { wnd = self, init = self.init, theme = theme }
end

function UIPromin:apply_theme()
    local theme = d_promin_config.get_theme()
    if theme == self.theme then
        return
    end
    for _, handle in pairs(self.pages) do
        handle.set_visible(false)
    end
    self:select_theme(theme)
    self:apply_page()
end

function UIPromin:ensure_page(page_id)
    local handle = self.pages[page_id]
    if handle then
        return handle
    end
    local build = THEME_BUILDERS[self.theme][page_id]
    if not build then
        return nil
    end
    handle = build(self.ctx)
    self.pages[page_id] = handle
    if page_id == MAP_PAGE then
        handle.set_artefact_lit(artefact_lit)
    end
    if page_id ~= active_page_id then
        handle.set_visible(false)
    end
    return handle
end

function UIPromin:apply_page()
    self:ensure_page(active_page_id)
    for page_id, handle in pairs(self.pages) do
        handle.set_visible(page_id == active_page_id and self.powered_state)
    end
    self:update_active()
end

function UIPromin:update_active()
    if not self.powered_state then
        return
    end
    local handle = self.pages[active_page_id]
    if handle and handle.update then
        handle.update()
    end
end

function UIPromin:repaint()
    for _, pages in pairs(self.themes) do
        for _, handle in pairs(pages) do
            if handle.repaint then
                handle.repaint()
            end
        end
    end
end

function UIPromin:Update()
    CUIScriptWnd.Update(self)
    local powered = is_powered()
    if powered ~= self.powered_state then
        self.powered_state = powered
        self:apply_page()
    end
    if not powered then
        return
    end
    if not (wd_inspect.is_raised() or allow_idle_update()) then
        return
    end
    self:update_active()
end

function UIPromin:__finalize() end

function get_ui()
    if singleton == nil then
        singleton = UIPromin()
    end
    return singleton
end

function repaint()
    if singleton then
        singleton:repaint()
    end
end

function apply_theme()
    if singleton then
        singleton:apply_theme()
    end
end

function set_page(page_id)
    if not PAGE_BUILDERS[page_id] then
        return
    end
    active_page_id = page_id
    if singleton then
        singleton:apply_page()
    end
end

function get_page()
    return active_page_id
end

function get_theme()
    return singleton and singleton.theme or d_promin_config.get_theme()
end

function ensure_page(page_id)
    return singleton and singleton:ensure_page(page_id)
end

local function get_active_handle()
    return singleton and singleton.pages[active_page_id]
end

function on_wheel(direction)
    local handle = get_active_handle()
    if handle and handle.on_wheel then
        return handle.on_wheel(direction)
    end
    return false
end

function on_page_key()
    local handle = get_active_handle()
    if handle and handle.on_page_key then
        handle.on_page_key()
    end
end

function set_artefact_lit(lit)
    artefact_lit = lit
    if not singleton then
        return
    end
    for _, pages in pairs(singleton.themes) do
        local page = pages[MAP_PAGE]
        if page then
            page.set_artefact_lit(lit)
        end
    end
end

function update_map(state)
    local page = ensure_page(MAP_PAGE)
    if page then
        page.update_map(state)
    end
end
