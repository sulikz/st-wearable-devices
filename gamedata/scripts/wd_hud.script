local PARK_OFF = 4000
local PARKED_X = -1000
local STAMINA_AUTOHIDE_TRIGGER = 0.95
local BAR_UPDATES = {
    Update_HealthHUD = "m_ui_health_bar_show",
    Update_StaminaHUD = "m_ui_stamina_bar_show",
}

local function get_npc_id_module()
    return rawget(_G, "factionid_hud_mcm") or rawget(_G, "factionID_hud_mcm")
end

local function get_sidhud_module()
    return rawget(_G, "ui_sidhud_mcm")
end

local AMMO_WIDGETS = {
    "m_ui_weapon_cur_ammo",
    "m_ui_weapon_fmj_ammo",
    "m_ui_weapon_ap_ammo",
    "m_ui_weapon_third_ammo",
    "m_ui_grenade",
    "m_ui_weapon_icon",
}

local FLAGS = {
    {
        key = "hud_minimap",
        label = "Minimap",
        get = function()
            return ui_options.get("video/hud/show_minimap") and true or false
        end,
        set = function(on)
            ui_options.set("video/hud/show_minimap", on and true or false)
            local mgui = ActorMenu.get_maingame()
            if mgui and mgui.UIZoneMap then
                mgui.UIZoneMap.disabled = not on
                mgui.UIMotionIcon:Show(on and true or false)
            end
        end,
    },
    { key = "hud_psy", label = "Psy bar" },
    {
        key = "hud_rad",
        label = "Radiation bar",
        is_available = function()
            return get_sidhud_module() ~= nil and ui_mcm ~= nil
        end,
        get = function()
            return get_sidhud_module().get_setting("radhealthshow") and true or false
        end,
        set = function(on)
            ui_mcm.set("sidhud/radhealthshow", on and true or false)
            get_sidhud_module().loadsetting()
        end,
    },
    { key = "hud_fire", label = "Fire mode" },
    { key = "hud_ammo", label = "Ammo counter" },
    { key = "hud_status", label = "Status Icons" },
    { key = "hud_companions", label = "Companions" },
    { key = "hud_bhs", label = "Health/BHS", default = 1 },
    { key = "hud_bhs_inv", label = "Health/BHS inventory only", invert = true },
    {
        key = "hud_npc_info",
        label = "NPC Identification",
        is_available = function()
            return get_npc_id_module() ~= nil
        end,
    },
    { key = "hud_radio", label = "Radio Messages" },
    {
        key = "hud_toxic",
        label = "Air filter condition",
        is_available = function()
            return toxic_air ~= nil
        end,
    },
}

local function is_stored_flag(flag)
    return flag.get == nil
end

local FLAG_KEYS = {}
for _, flag in ipairs(FLAGS) do
    if is_stored_flag(flag) then
        FLAG_KEYS[#FLAG_KEYS + 1] = flag.key
    end
end

local LTX_SECTION = "wd_hud"

local flags
local prev = {}
local forced_psy = false
local npc_id_module

local function get_default_flags()
    local out = {}
    for _, flag in ipairs(FLAGS) do
        if is_stored_flag(flag) then
            out[flag.key] = flag.default or 0
        end
    end
    return out
end

flags = get_default_flags()

function reset()
    prev = {}
end

function get(name)
    return flags[name] or 0
end

function set(name, value)
    flags[name] = value
end

function is_visible(name)
    return get(name) < 0.5
end

function set_visible(name, on)
    set(name, on and 0 or 1)
    save()
end

local function is_hidden(name)
    return not is_visible(name)
end

function is_mode_on(name)
    return is_hidden(name)
end

function set_mode(name, on)
    set_visible(name, not on)
end

function load()
    flags = wd_store.load_fields(LTX_SECTION, FLAG_KEYS, flags)
end

function save()
    return wd_store.save_fields(LTX_SECTION, FLAG_KEYS, flags)
end

function apply(wnd, hide)
    if not wnd then
        return
    end
    local pos = wnd:GetWndPos()
    local parked = pos.x < PARKED_X
    if hide then
        if not parked then
            pos.x = pos.x - PARK_OFF
            pos.y = pos.y - PARK_OFF
            wnd:SetWndPos(pos)
        end
        wnd:Show(false)
    elseif parked then
        pos.x = pos.x + PARK_OFF
        pos.y = pos.y + PARK_OFF
        wnd:SetWndPos(pos)
        wnd:Show(true)
    end
end

local function park(wnd, name)
    apply(wnd, is_hidden(name))
end

local function apply_module(mod, name)
    if not mod then
        return
    end
    local hide = is_hidden(name)
    if hide then
        if mod.HUD ~= nil and mod.deactivate_hud then
            mod.deactivate_hud()
        end
    elseif prev[name] and mod.activate_hud then
        mod.activate_hud()
    end
    prev[name] = hide
end

local function is_bhs_hidden()
    if is_hidden("hud_bhs") then
        return true
    end
    if not is_mode_on("hud_bhs_inv") then
        return false
    end
    return actor_menu.get_last_mode() ~= 1
end

local function apply_vanilla_bars(hud_states, hide)
    if hide then
        hud_states.m_ui_health_bar_show = false
        hud_states.m_ui_stamina_bar_show = false
        hud_states.m_back:Show(false)
    elseif prev.hud_bhs then
        hud_states.m_ui_health_bar_show = true
        hud_states.m_ui_stamina_bar_show = not ui_options.get("video/hud/autohide_stamina_bar")
            or db.actor.power < STAMINA_AUTOHIDE_TRIGGER
        hud_states.m_back:Show(true)
    end
end

local function apply_bhs(hud_states)
    if zzz_player_injuries then
        local hide = is_bhs_hidden()
        if hide and not prev.hud_bhs then
            zzz_player_injuries.show_hud_type = 0
        elseif not hide and prev.hud_bhs then
            zzz_player_injuries.show_hud_type = 2
        end
        prev.hud_bhs = hide
        return
    end
    if not hud_states then
        return
    end
    local hide = is_hidden("hud_bhs") or is_mode_on("hud_bhs_inv")
    apply_vanilla_bars(hud_states, hide)
    prev.hud_bhs = hide
end

function hide_reshown_bar(field)
    if not prev.hud_bhs then
        return
    end
    local mgui = ActorMenu.get_maingame()
    local hud_states = mgui and mgui.m_ui_hud_states
    if hud_states and hud_states[field] then
        hud_states[field] = false
    end
end

local function pass_after_hide(field, ...)
    wd_hud.hide_reshown_bar(field)
    return ...
end

function install_bar_wraps()
    if _G.wd_hud_bars_wrapped or not actor_effects or zzz_player_injuries then
        return
    end
    for name, field in pairs(BAR_UPDATES) do
        local original = actor_effects[name]
        if original then
            actor_effects[name] = function(...)
                return pass_after_hide(field, original(...))
            end
        end
    end
    _G.wd_hud_bars_wrapped = true
end

local function apply_radio()
    local get_menu = ActorMenu.get_messages_menu
    local menu = get_menu and get_menu()
    if not menu then
        return
    end
    local hide = is_hidden("hud_radio")
    if hide then
        menu:Show(false)
    elseif prev.hud_radio then
        menu:Show(true)
    end
    prev.hud_radio = hide
end

function actor_on_update()
    local mgui = ActorMenu.get_maingame()
    local st = mgui and mgui.m_ui_hud_states
    if st then
        if is_hidden("hud_psy") then
            st.m_ui_psy_bar_show = false
            forced_psy = true
        elseif forced_psy then
            st.m_ui_psy_bar_show = true
        end
        park(st.m_fire_mode, "hud_fire")
        for _, field in ipairs(AMMO_WIDGETS) do
            park(st[field], "hud_ammo")
        end
    end
    apply_radio()
    apply_module(actor_status, "hud_status")
    apply_module(npc_id_module, "hud_npc_info")
    apply_module(axr_companions, "hud_companions")
    apply_module(toxic_air, "hud_toxic")
    apply_bhs(st)
end

local function register_flag_toggle(flag)
    local key = flag.key
    if not is_stored_flag(flag) then
        wd_gui.register_global_toggle({
            id = key,
            label = flag.label,
            get = flag.get,
            set = flag.set,
        })
        return
    end
    local get = flag.invert and is_mode_on or is_visible
    local set = flag.invert and set_mode or set_visible
    wd_gui.register_global_toggle({
        id = key,
        label = flag.label,
        get = function()
            return get(key)
        end,
        set = function(on)
            set(key, on)
        end,
    })
end

local function register_gui()
    wd_gui.register_device({
        id = "hud",
        label = "HUD",
        rank = 1,
    })
    wd_gui.register_tab({
        device = "hud",
        id = "hud_globals",
        label = "HUD",
        globals = true,
    })
end

function register()
    register_gui()
    for _, flag in ipairs(FLAGS) do
        if not flag.is_available or flag.is_available() then
            register_flag_toggle(flag)
        end
    end
    wd_core.register({
        id = "wd_hud",
        callbacks = {
            actor_on_update = { { actor_on_update, interval = 200 } },
        },
        on_start = function()
            npc_id_module = get_npc_id_module()
            load()
            reset()
            install_bar_wraps()
        end,
    })
end
