jit.off(true, true)

SMOOTH_COS = math.cos(math.rad(2))
TURN_MIN = math.rad(0.25)
TURN_MAX = math.rad(80)
AREA_KEEP = 0.1
SUPPORT_MIN = 0.5
LENGTH_MIN = 1e-12

local acos = math.acos
local atan2 = math.atan2
local cos = math.cos
local sin = math.sin
local sqrt = math.sqrt
local min = math.min

function new_moves()
    return { x = {}, y = {}, z = {} }
end

function add_move(moves, record, coord_x, coord_y, coord_z)
    local offset = record.offset
    moves.x[offset], moves.y[offset], moves.z[offset] = coord_x, coord_y, coord_z
end

local function get_length(coord_x, coord_y, coord_z)
    return sqrt(coord_x * coord_x + coord_y * coord_y + coord_z * coord_z)
end

local function get_cross(ax, ay, az, bx, by, bz)
    return ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx
end

local function get_corner_angle(size, dot)
    if size < LENGTH_MIN then
        return 0
    end
    local cosine = dot / size
    if cosine > 1 then
        cosine = 1
    elseif cosine < -1 then
        cosine = -1
    end
    return acos(cosine)
end

local function find_bucket(buckets, coord_x, coord_y, coord_z, create)
    local by_y = buckets[coord_x]
    if not by_y then
        if not create then
            return nil
        end
        by_y = {}
        buckets[coord_x] = by_y
    end
    local by_z = by_y[coord_y]
    if not by_z then
        if not create then
            return nil
        end
        by_z = {}
        by_y[coord_y] = by_z
    end
    local bucket = by_z[coord_z]
    if not bucket and create then
        bucket = {}
        by_z[coord_z] = bucket
    end
    return bucket
end

local function read_layer(mesh, vertices)
    local positions = wd_ogf.read_positions(mesh, vertices)
    return {
        vertices = vertices,
        x = positions.x,
        y = positions.y,
        z = positions.z,
        first_offset = wd_ogf.get_record_offset(vertices, 1),
        stride = vertices.stride,
        moved = {},
        active = {},
        indices = wd_ogf.read_indices(mesh, vertices),
    }
end

local function mark_moved(layers, moves)
    for offset in pairs(moves.x) do
        for _, layer in ipairs(layers) do
            local index = (offset - layer.first_offset) / layer.stride + 1
            if index >= 1 and index <= layer.vertices.count and index % 1 == 0 then
                layer.moved[index] = true
                layer.any_moved = true
                break
            end
        end
    end
end

local function mark_moved_fans(layer, buckets)
    local indices, moved = layer.indices, layer.moved
    local xs, ys, zs = layer.x, layer.y, layer.z
    local marked = {}
    local stride = wd_build_slice.STRIDE * 3
    local check = wd_build_slice.check
    for base = 1, #indices - 2, 3 do
        if base % stride == 1 then
            check()
        end
        local first, second, third = indices[base] + 1, indices[base + 1] + 1, indices[base + 2] + 1
        if moved[first] or moved[second] or moved[third] then
            if not marked[first] then
                marked[first] = true
                find_bucket(buckets, xs[first], ys[first], zs[first], true)
            end
            if not marked[second] then
                marked[second] = true
                find_bucket(buckets, xs[second], ys[second], zs[second], true)
            end
            if not marked[third] then
                marked[third] = true
                find_bucket(buckets, xs[third], ys[third], zs[third], true)
            end
        end
    end
end

local function join_group(bucket, normal_x, normal_y, normal_z)
    for _, group in ipairs(bucket) do
        if group.nx * normal_x + group.ny * normal_y + group.nz * normal_z >= SMOOTH_COS then
            return group
        end
    end
    local group = {
        nx = normal_x,
        ny = normal_y,
        nz = normal_z,
        bx = 0,
        by = 0,
        bz = 0,
        ax = 0,
        ay = 0,
        az = 0,
        kept = 0,
        dropped = 0,
    }
    bucket[#bucket + 1] = group
    return group
end

local function mark_active(mesh, layer, buckets)
    local vertices = layer.vertices
    local xs, ys, zs, active = layer.x, layer.y, layer.z, layer.active
    local read_normal = wd_ogf.read_normal
    local stride = wd_build_slice.STRIDE
    local check = wd_build_slice.check
    for index = 1, vertices.count do
        if index % stride == 0 then
            check()
        end
        local by_y = buckets[xs[index]]
        if by_y then
            local by_z = by_y[ys[index]]
            local bucket = by_z and by_z[zs[index]]
            if bucket then
                local nx, ny, nz = read_normal(mesh, vertices, index)
                local size = nx and ny and nz and sqrt(nx * nx + ny * ny + nz * nz) or 0
                if size > LENGTH_MIN then
                    active[index] = join_group(bucket, nx / size, ny / size, nz / size)
                    layer.any_active = true
                end
            end
        end
    end
end

local function add_corner(group, weight, is_kept, bx, by, bz, before_size, ax, ay, az, after_size)
    if is_kept then
        local before_weight, after_weight = weight / before_size, weight / after_size
        group.bx, group.by, group.bz =
            group.bx + bx * before_weight, group.by + by * before_weight, group.bz + bz * before_weight
        group.ax, group.ay, group.az =
            group.ax + ax * after_weight, group.ay + ay * after_weight, group.az + az * after_weight
        group.kept = group.kept + weight
    else
        group.dropped = group.dropped + weight
    end
end

local function add_faces(layer, moves)
    local indices, active, moved = layer.indices, layer.active, layer.moved
    local xs, ys, zs = layer.x, layer.y, layer.z
    local first_offset, record_stride = layer.first_offset, layer.stride
    local move_x, move_y, move_z = moves.x, moves.y, moves.z
    local stride = wd_build_slice.STRIDE * 3
    local check = wd_build_slice.check
    for base = 1, #indices - 2, 3 do
        if base % stride == 1 then
            check()
        end
        local first, second, third = indices[base] + 1, indices[base + 1] + 1, indices[base + 2] + 1
        local first_group, second_group, third_group = active[first], active[second], active[third]
        if first_group or second_group or third_group then
            local x1, y1, z1 = xs[first], ys[first], zs[first]
            local x2, y2, z2 = xs[second], ys[second], zs[second]
            local x3, y3, z3 = xs[third], ys[third], zs[third]
            local ux, uy, uz = x2 - x1, y2 - y1, z2 - z1
            local vx, vy, vz = x3 - x1, y3 - y1, z3 - z1
            local bx, by, bz = uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx
            local before_size = sqrt(bx * bx + by * by + bz * bz)
            if before_size >= LENGTH_MIN then
                local ax1, ay1, az1, ax2, ay2, az2, ax3, ay3, az3 = x1, y1, z1, x2, y2, z2, x3, y3, z3
                if moved[first] then
                    local offset = first_offset + (first - 1) * record_stride
                    ax1, ay1, az1 = move_x[offset], move_y[offset], move_z[offset]
                end
                if moved[second] then
                    local offset = first_offset + (second - 1) * record_stride
                    ax2, ay2, az2 = move_x[offset], move_y[offset], move_z[offset]
                end
                if moved[third] then
                    local offset = first_offset + (third - 1) * record_stride
                    ax3, ay3, az3 = move_x[offset], move_y[offset], move_z[offset]
                end
                local sx, sy, sz = ax2 - ax1, ay2 - ay1, az2 - az1
                local tx, ty, tz = ax3 - ax1, ay3 - ay1, az3 - az1
                local ax, ay, az = sy * tz - sz * ty, sz * tx - sx * tz, sx * ty - sy * tx
                local after_size = sqrt(ax * ax + ay * ay + az * az)
                local is_kept = after_size >= AREA_KEEP * before_size and ax * bx + ay * by + az * bz > 0
                local wx, wy, wz = x3 - x2, y3 - y2, z3 - z2
                local u_size = sqrt(ux * ux + uy * uy + uz * uz)
                local v_size = sqrt(vx * vx + vy * vy + vz * vz)
                local w_size = sqrt(wx * wx + wy * wy + wz * wz)
                if first_group then
                    local weight = get_corner_angle(u_size * v_size, ux * vx + uy * vy + uz * vz)
                    add_corner(first_group, weight, is_kept, bx, by, bz, before_size, ax, ay, az, after_size)
                end
                if second_group then
                    local weight = get_corner_angle(w_size * u_size, -(wx * ux + wy * uy + wz * uz))
                    add_corner(second_group, weight, is_kept, bx, by, bz, before_size, ax, ay, az, after_size)
                end
                if third_group then
                    local weight = get_corner_angle(v_size * w_size, vx * wx + vy * wy + vz * wz)
                    add_corner(third_group, weight, is_kept, bx, by, bz, before_size, ax, ay, az, after_size)
                end
            end
        end
    end
end

local function get_turn(group)
    if group.dropped > SUPPORT_MIN * (group.kept + group.dropped) then
        return nil
    end
    local bx, by, bz, ax, ay, az = group.bx, group.by, group.bz, group.ax, group.ay, group.az
    local size = get_length(bx, by, bz) * get_length(ax, ay, az)
    if size < LENGTH_MIN then
        return nil
    end
    local cx, cy, cz = get_cross(bx, by, bz, ax, ay, az)
    local sine_size = get_length(cx, cy, cz)
    local angle = atan2(sine_size / size, (bx * ax + by * ay + bz * az) / size)
    if angle < TURN_MIN or sine_size < LENGTH_MIN then
        return nil
    end
    angle = min(angle, TURN_MAX)
    return { x = cx / sine_size, y = cy / sine_size, z = cz / sine_size, cosine = cos(angle), sine = sin(angle) }
end

local function rotate_unit(turn, coord_x, coord_y, coord_z)
    local size = coord_x and coord_y and coord_z and sqrt(coord_x * coord_x + coord_y * coord_y + coord_z * coord_z)
        or 0
    if size < LENGTH_MIN then
        return nil
    end
    coord_x, coord_y, coord_z = coord_x / size, coord_y / size, coord_z / size
    local axis_x, axis_y, axis_z, cosine, sine = turn.x, turn.y, turn.z, turn.cosine, turn.sine
    local cx, cy, cz =
        axis_y * coord_z - axis_z * coord_y, axis_z * coord_x - axis_x * coord_z, axis_x * coord_y - axis_y * coord_x
    local along = (axis_x * coord_x + axis_y * coord_y + axis_z * coord_z) * (1 - cosine)
    return coord_x * cosine + cx * sine + axis_x * along,
        coord_y * cosine + cy * sine + axis_y * along,
        coord_z * cosine + cz * sine + axis_z * along
end

local function write_frame(mesh, patch, vertices, index, group)
    local turn = group.turn
    if turn == nil then
        turn = get_turn(group) or false
        group.turn = turn
    end
    if not turn then
        return false
    end
    local nx, ny, nz, tx, ty, tz, bx, by, bz = wd_ogf.read_normal_frame(mesh, vertices, index)
    local rnx, rny, rnz = rotate_unit(turn, nx, ny, nz)
    local rtx, rty, rtz = rotate_unit(turn, tx, ty, tz)
    local rbx, rby, rbz = rotate_unit(turn, bx, by, bz)
    if not (rnx and rtx and rbx) then
        return false
    end
    local ok, reason = patch.set_normal_frame(vertices, index, rnx, rny, rnz, rtx, rty, rtz, rbx, rby, rbz)
    if not ok then
        return nil, reason
    end
    return true
end

function turn_normals(mesh, patch, moves)
    local layers, buckets = {}, {}
    for _, child in ipairs(mesh.children) do
        local vertices = child.vertices
        if vertices then
            local layer = read_layer(mesh, vertices)
            if layer.indices then
                layers[#layers + 1] = layer
            end
        end
    end
    mark_moved(layers, moves)
    for _, layer in ipairs(layers) do
        if layer.any_moved then
            mark_moved_fans(layer, buckets)
        end
    end
    for _, layer in ipairs(layers) do
        mark_active(mesh, layer, buckets)
        if layer.any_active then
            add_faces(layer, moves)
        end
    end
    local turned = 0
    local stride = wd_build_slice.STRIDE
    local check = wd_build_slice.check
    for _, layer in ipairs(layers) do
        if layer.any_active then
            local vertices, active = layer.vertices, layer.active
            for index = 1, vertices.count do
                if index % stride == 0 then
                    check()
                end
                local group = active[index]
                if group then
                    local written, reason = write_frame(mesh, patch, vertices, index, group)
                    if written == nil then
                        return nil, reason
                    end
                    turned = turned + (written and 1 or 0)
                end
            end
        end
    end
    return turned
end
