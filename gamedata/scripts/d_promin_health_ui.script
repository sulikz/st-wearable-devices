local px = d_promin_config.get_px()
local baked = d_promin_bio_baked
local boost = wd_vitals.BOOST

local body_binder = wd_screen.new_binder(d_promin_config.BODY_SHADER)

local set_shown = wd_screen.set_shown
local place_widget = wd_screen.place_widget
local place_soft_fill = wd_panel.place_soft_fill
local SOFT_FILLS = wd_panel.SOFT_FILLS

BACKGROUND = "wd_promin_page_bio"
TITLE_TEXTURE = "wd_promin_title_bio"
SLOW_REFRESH_MS = 250

local NONE = "\151"
local NO_TIMER = "--:--"
local TIMER_TEXT = "%02d:%02d"
local PERCENT_TEXT = "%d %%"
local MSV_TEXT = "%d mSv"
local NO_DOSE = "-- mSv"
local WEIGHT_TEXT = "%d/%d KG"
local WEIGHT_SHORT_TEXT = "%d/%d"
local GEIGER_TEXT = "%d"
local MIN_GEIGER = -999
local MAX_GEIGER = 9999
local GEIGER_FRAME = "wd_bio_geiger"
local GEIGER_UNIT = "wd_bio_geiger_unit"
local LABEL_PREFIX = "wd_bio_label_"
local MAX_TIMER_SECONDS = 99 * 60 + 59
local REAPPLY_SECONDS = 0.5

EFFECTS = {
    { name = "HEALING", icon = "heart", boosters = { boost.hp_restore } },
    { name = "BLEED HEALING", icon = "bleed", boosters = { boost.bleeding_restore } },
    { name = "STAMINA REGEN", icon = "stamina", boosters = { boost.power_restore } },
    { name = "RAD HEALING", icon = "rad", boosters = { boost.radiation_restore } },
    { name = "CARRY WEIGHT", icon = "weight", boosters = { boost.max_weight } },
    {
        name = "RESISTANCE",
        icon = "armor",
        boosters = {
            boost.wound_immunity,
            boost.fire_wound_immunity,
            boost.strike_immunity,
            boost.expl_immunity,
            boost.burn_immunity,
            boost.shock_immunity,
        },
    },
    {
        name = "RAD PROTECTION",
        icon = "prot_rad",
        boosters = { boost.radiation_protection, boost.radiation_immunity },
    },
    {
        name = "PSY PROTECTION",
        icon = "prot_psy",
        boosters = { boost.telepatic_protection, boost.telepatic_immunity },
    },
    {
        name = "CHEM PROTECTION",
        icon = "prot_chem",
        boosters = { boost.chemical_burn_protection, boost.chemical_burn_immunity },
    },
}

STATUS = {
    health = { icon = "heart", icon_role = "text", format = PERCENT_TEXT },
    psy = { icon = "psy", icon_role = "text", format = PERCENT_TEXT },
    radiation = { icon = "rad", icon_role = "text", format = MSV_TEXT },
    stamina = { icon = "stamina", icon_role = "text", format = PERCENT_TEXT },
    bleeding = { icon = "bleed", name = "BLEEDING" },
    food = { icon = "food", format = PERCENT_TEXT },
    water = { icon = "water", format = PERCENT_TEXT },
    sleep = { icon = "sleep", format = PERCENT_TEXT },
    weight = { icon = "weight", icon_role = "text", name = "WEIGHT" },
}

MOBILITY = {
    ok = { text = "MOBILITY \183 OK", role = "dim" },
    cant_walk_stamina = { text = "CAN'T WALK \183 STAMINA", role = "crit" },
    cant_walk_weight = { text = "CAN'T WALK \183 WEIGHT", role = "crit" },
    cant_walk_legs = { text = "CAN'T WALK \183 LEGS", role = "crit" },
    cant_run_leg = { text = "CAN'T RUN \183 LEG", role = "warn" },
    limp = { text = "LIMP", role = "warn" },
    cant_sprint = { text = "CAN'T SPRINT", role = "warn" },
}

BLEEDING_TIERS = { { text = "I", role = "text" }, { text = "II", role = "warn" }, { text = "III", role = "crit" } }

GEIGER_STATES = {
    clear = { reading = { text = "CLEAR", role = "text" }, shield = { text = "PROTECTION", role = "text" } },
    held = { reading = { text = "ELEVATED", role = "warn" }, shield = { text = "PROTECTED", role = "text" } },
    leaking = { reading = { text = "DANGER", role = "crit" }, shield = { text = "EXPOSED", role = "crit" } },
}

GEIGER_OFF = {
    reading = { text = "GEIGER", role = "dim", value = d_promin_config.OFF_TEXT },
    shield = { text = d_promin_config.UNAVAILABLE_TEXT, role = "dim", value = "--" },
}

local label_ids = {}

function get_label_id(text, prefix)
    prefix = prefix or LABEL_PREFIX
    local ids = label_ids[prefix]
    if not ids then
        ids = {}
        label_ids[prefix] = ids
    end
    local id = ids[text]
    if not id then
        local slug = text:lower():gsub("[^a-z0-9]+", "_"):gsub("^_+", ""):gsub("_+$", "")
        id = prefix .. slug
        ids[text] = id
    end
    return id
end

local function get_icon(name)
    return { id = "wd_bio_icon_" .. name, w = px.w(baked.ICON), h = px.h(baked.ICON) }
end

function get_percent(ratio)
    return math.floor(clamp(ratio, 0, 1) * 100 + 0.5)
end

local LEVEL_STEPS = baked.TRACK.w - 2 * baked.TRACK.inset
local GEIGER = baked.GEIGER
local GEIGER_TRACK = GEIGER.track
local GEIGER_STEPS = GEIGER_TRACK.w - 2 * GEIGER_TRACK.inset
local GEIGER_RANGE = GEIGER.range
local GEIGER_DECADES = math.log10(GEIGER_RANGE.max / GEIGER_RANGE.min)

function get_snapped(ratio, steps)
    return math.floor(clamp(ratio, 0, 1) * steps + 0.5) / steps
end

function format_timer(seconds)
    local whole = clamp(math.floor(seconds), 0, MAX_TIMER_SECONDS)
    return string.format(TIMER_TEXT, math.floor(whole / 60), whole % 60)
end

local function get_columns(art_x)
    return {
        icon = px.x(art_x),
        name = px.x(art_x + baked.ICON_W),
        value = px.x(art_x + baked.ICON_W + baked.NAME_W),
    }
end

local function new_text(kit, left, top, width, align)
    local cell = kit.new_cell({ chars = kit.get_max_chars(width - 2 * kit.style.pad), align = align, box = false })
    cell.place(left, top, width, kit.style.row_h)
    cell.width = width
    return cell
end

local function new_label(kit, text, left, top, width)
    local cell = kit.new_cell({ label = get_label_id(text), box = false })
    cell.place(left, top, width, kit.style.row_h)
    return cell
end

function show_label(cell, text, role, prefix)
    cell.set_label(get_label_id(text, prefix))
    cell.set_role(role)
end

local function new_icon(kit, name, left, top)
    local cell = kit.new_cell({ icon = get_icon(name), align = "center", box = false })
    cell.place(left, top, px.w(baked.ICON_W), kit.style.row_h)
    return cell
end

local function new_sidebar_row(kit, icon, name, top, columns)
    return {
        icon = new_icon(kit, icon, columns.icon, top),
        name = new_label(kit, name, columns.name, top, px.w(baked.NAME_W)),
        value = new_text(kit, columns.value, top, px.w(baked.VALUE_W), "right"),
    }
end

local function build_effects(kit)
    local rows, by_booster = {}, {}
    local columns = get_columns(baked.EFFECTS.x)
    local underline_w, underline_h = px.w(baked.UNDERLINE.w), px.h(baked.UNDERLINE.h)
    local underline_x = columns.value + px.w(baked.VALUE_W) - kit.style.pad - underline_w
    for index, effect in ipairs(EFFECTS) do
        local art_top = baked.EFFECTS.y + (index - 1) * baked.ROW_H
        local top = px.y(art_top)
        local row = new_sidebar_row(kit, effect.icon, effect.name, top, columns)
        row.effect = effect
        row.track = kit.new_soft_fill("dim", SOFT_FILLS.line_h)
        row.level = kit.new_soft_fill("text", SOFT_FILLS.line_h)
        row.underline = { x = underline_x, y = px.y(art_top + baked.UNDERLINE.y), w = underline_w, h = underline_h }
        row.seconds = 0
        place_soft_fill(row.track, underline_x, row.underline.y, underline_w, underline_h)
        for _, booster in ipairs(effect.boosters) do
            by_booster[booster] = row
        end
        rows[index] = row
    end
    return rows, by_booster
end

local function build_status(kit)
    local rows = {}
    local columns = get_columns(baked.STATUS_X)
    local track = baked.TRACK
    local inset = px.w(track.inset)
    local track_x, track_w, track_h = px.x(baked.STATUS_X + baked.ICON_W + track.x), px.w(track.w), px.h(track.h)
    for _, spec in ipairs(baked.STATUS_ROWS) do
        local top = px.y(spec.y)
        local status = STATUS[spec.key]
        local row = {
            status = status,
            icon = new_icon(kit, status.icon, columns.icon, top),
            value = new_text(kit, columns.value, top, px.w(baked.VALUE_W), "right"),
        }
        if status.icon_role then
            row.icon.set_role(status.icon_role)
        end
        if spec.bar then
            row.track_top = px.y(spec.y + track.y)
            row.bar = kit.new_bar({ level = "text", inset = inset })
            row.bar.place(track_x, row.track_top, track_w, track_h)
        else
            row.name = new_label(kit, status.name, columns.name, top, px.w(baked.NAME_W))
        end
        rows[spec.key] = row
    end
    local stamina = rows.stamina
    local tick_h = px.h(baked.TICK.h)
    local track_top = stamina.track_top
    stamina.cap = kit.new_soft_fill("border", SOFT_FILLS.bar)
    stamina.tick = kit.new_soft_fill("text", SOFT_FILLS.line_v)
    stamina.cap_rect = {
        x = track_x + inset,
        w = track_w - 2 * inset,
        y = track_top + inset,
        h = track_h - 2 * inset,
        tick_y = track_top + track_h / 2 - tick_h / 2,
        tick_w = px.w(baked.TICK.w),
        tick_h = tick_h,
    }
    return rows
end

local function build_mobility(kit)
    local style = kit.style
    local left, top = px.x(baked.STATUS_X), px.y(baked.MOBILITY_Y)
    local width = px.w(baked.ICON_W + baked.NAME_W + baked.VALUE_W)
    local cell = kit.new_cell({ label = get_label_id(MOBILITY.ok.text), icon = get_icon("walk"), box = false })
    cell.place(left, top, width, style.row_h)
    local border = kit.new_box({ border = "warn" })
    border.place(left, top, width, style.row_h)
    return { cell = cell, border = border }
end

local function new_geiger_unit(kit, row_y)
    local unit = GEIGER.unit
    local image = kit.new_image(GEIGER_UNIT, "art")
    place_widget(image.widget, px.x(GEIGER.x + unit.x), px.y(row_y + unit.y), px.w(unit.w), px.h(unit.h))
    return image
end

local function build_geiger(kit)
    local columns = get_columns(GEIGER.x)
    local track, marker_art = GEIGER_TRACK, GEIGER.marker
    local inset = px.w(track.inset)
    local track_x, track_w = px.x(GEIGER.x + track.x), px.w(track.w)
    local block = GEIGER.block
    local frame = kit.new_image(GEIGER_FRAME, "art")
    place_widget(frame.widget, px.x(block.x), px.y(block.y), px.w(block.w), px.h(block.h))
    local reading = new_sidebar_row(kit, "rad", GEIGER_OFF.reading.text, px.y(GEIGER.reading_y), columns)
    local shield = new_sidebar_row(kit, "prot_rad", GEIGER_OFF.shield.text, px.y(GEIGER.shield_y), columns)
    local bar = kit.new_bar({ level = "text", inset = inset })
    bar.place(track_x, px.y(GEIGER.scale_y + track.y), track_w, px.h(track.h))
    local marker = kit.new_soft_fill("text", SOFT_FILLS.line_v)
    return {
        frame = frame,
        reading = reading,
        shield = shield,
        bar = bar,
        marker = marker,
        steps = GEIGER_STEPS,
        marker_rect = {
            x = track_x + inset,
            w = track_w - 2 * inset,
            y = px.y(GEIGER.scale_y + marker_art.y),
            marker_w = px.w(marker_art.w),
            h = px.h(marker_art.h),
        },
        live = { marker, new_geiger_unit(kit, GEIGER.reading_y), new_geiger_unit(kit, GEIGER.shield_y) },
    }
end

local function get_part_cell(cells, part)
    local cell = cells[part]
    return { x = px.x(cell.x), y = px.y(cell.y), w = px.w(cell.w), h = px.h(cell.h) }
end

function new_silhouette(kit, parent, cells, id_prefix, texture_file)
    local silhouette = { tracks = {}, fills = {}, limbs = {} }
    for _, entry in ipairs(wd_vitals.LIMB_PARTS) do
        for _, part in ipairs(entry.parts) do
            local cell = get_part_cell(cells, part)
            local track = kit.new_image(id_prefix .. part, "dim")
            place_widget(track.widget, cell.x, cell.y, cell.w, cell.h)
            silhouette.tracks[#silhouette.tracks + 1] = track
        end
    end
    local function new_part_widget(part)
        local widget = wd_panel.new_widget(parent, id_prefix .. part, body_binder)
        silhouette.fills[#silhouette.fills + 1] = widget
        return widget, get_part_cell(cells, part)
    end
    for index, entry in ipairs(wd_vitals.LIMB_PARTS) do
        silhouette.limbs[index] = wd_silhouette.new_limb(entry, new_part_widget, texture_file)
    end
    return silhouette
end

function show_text(cell, text, role)
    cell.set_text(text)
    cell.set_role(role)
end

function get_time_left_ratio(entry)
    if not entry.duration or entry.seconds > entry.last_seconds + REAPPLY_SECONDS then
        entry.duration = entry.seconds
    end
    entry.last_seconds = entry.seconds
    return entry.seconds / entry.duration
end

local function show_effect(kit, row)
    local active = row.seconds > 0
    local role = active and "text" or "dim"
    row.icon.set_role(role)
    row.name.set_role(role)
    row.value.set_role(role)
    set_shown(row.track, active)
    set_shown(row.level, active)
    if not active then
        row.duration, row.whole = nil, nil
        row.value.set_text(NO_TIMER)
        return
    end
    local whole = math.floor(row.seconds)
    if row.whole ~= whole then
        row.whole = whole
        row.value.set_text(format_timer(whole))
    end
    local underline = row.underline
    local ratio = get_snapped(get_time_left_ratio(row), baked.UNDERLINE.w)
    if row.ratio ~= ratio then
        row.ratio = ratio
        place_soft_fill(row.level, underline.x, underline.y, underline.w * ratio, underline.h)
    end
end

local function show_level_row(kit, row, ratio, role, value)
    row.bar.set_ratio(get_snapped(ratio, LEVEL_STEPS))
    kit.set_role(row.bar.level, role)
    row.value.set_role(role)
    if row.shown_value ~= value then
        row.shown_value = value
        row.value.set_text(string.format(row.status.format, value))
    end
end

local function show_percent_row(kit, row, ratio)
    show_level_row(kit, row, ratio, d_promin_config.get_state_role(ratio), get_percent(ratio))
end

function place_stamina_cap(row, cap, steps)
    cap = get_snapped(cap, steps)
    if row.cap_ratio == cap then
        return
    end
    row.cap_ratio = cap
    local rect = row.cap_rect
    local cap_x = rect.x + rect.w * cap
    place_soft_fill(row.cap, cap_x, rect.y, rect.x + rect.w - cap_x, rect.h)
    place_soft_fill(row.tick, cap_x, rect.tick_y, rect.tick_w, rect.tick_h)
end

local function show_unknown_row(row, text)
    row.icon.set_role("dim")
    row.bar.set_ratio(0)
    row.shown_value = nil
    show_text(row.value, text, "dim")
end

local function show_dose_row(kit, row, msv, readable)
    if not readable then
        show_unknown_row(row, NO_DOSE)
        return
    end
    local radiation = wd_vitals.get_radiation()
    row.icon.set_role(row.status.icon_role)
    show_level_row(kit, row, radiation, d_promin_config.get_state_role(radiation, true), msv)
end

local function show_bleeding(row)
    local tier = BLEEDING_TIERS[wd_vitals.get_bleeding_tier()]
    local role = tier and tier.role or "dim"
    row.icon.set_role(role)
    row.name.set_role(role)
    show_text(row.value, tier and tier.text or NONE, role)
end

local function show_vitals(page, conditions)
    local kit, rows = page.kit, page.status
    show_percent_row(kit, rows.health, wd_vitals.get_health())
    show_percent_row(kit, rows.psy, wd_vitals.get_psy())
    local msv = wd_vitals.get_radiation_msv()
    show_dose_row(kit, rows.radiation, msv, page.dose_readable)
    show_percent_row(kit, rows.stamina, wd_vitals.get_stamina())
    place_stamina_cap(rows.stamina, wd_vitals.get_stamina_cap(conditions, msv), LEVEL_STEPS)
    show_bleeding(rows.bleeding)
end

local function show_need(kit, row, ratio)
    if not ratio then
        show_unknown_row(row, NONE)
        return
    end
    row.icon.set_role(d_promin_config.get_state_role(ratio))
    show_percent_row(kit, row, ratio)
end

function get_weight_text(kit, total, max, width, text_h)
    local text = string.format(WEIGHT_TEXT, total, max)
    if kit.measure(text, text_h) <= width then
        return text, true
    end
    text = string.format(WEIGHT_SHORT_TEXT, total, max)
    return text, kit.measure(text, text_h) <= width
end

local function show_weight(kit, row, conditions)
    local total, max = wd_vitals.get_carry_weight(conditions)
    local width = row.value.width - 2 * kit.style.pad
    local text = get_weight_text(kit, math.floor(total + 0.5), math.floor(max + 0.5), width)
    show_text(row.value, text, total > max and "crit" or "text")
end

local function show_mobility(mobility, conditions)
    local state = MOBILITY[wd_vitals.get_mobility(conditions)]
    show_label(mobility.cell, state.text, state.role)
    local alert = state.role ~= "dim"
    if alert then
        mobility.border.set_role(state.role)
    end
    mobility.border.set_visible(alert)
end

local function get_geiger_scale_ratio(reading)
    if reading <= GEIGER_RANGE.min then
        return 0
    end
    return math.log10(reading / GEIGER_RANGE.min) / GEIGER_DECADES
end

local function get_scale_position(reading, steps)
    return get_snapped(get_geiger_scale_ratio(reading), steps)
end

local function get_geiger_state(reading, shield)
    if reading <= 0 then
        return "clear"
    elseif reading > shield then
        return "leaking"
    end
    return "held"
end

local function show_geiger_row(kit, row, label, value_text)
    row.icon.set_role(label.role)
    show_label(row.name, label.text, label.role)
    show_text(row.value, value_text, label.role)
end

local function get_geiger_text(value)
    return string.format(GEIGER_TEXT, clamp(math.floor(value), MIN_GEIGER, MAX_GEIGER))
end

local function place_geiger_marker(geiger, ratio)
    if geiger.marker_ratio == ratio then
        return
    end
    geiger.marker_ratio = ratio
    local rect = geiger.marker_rect
    place_soft_fill(geiger.marker, rect.x + rect.w * ratio - rect.marker_w / 2, rect.y, rect.marker_w, rect.h)
end

function set_live_shown(geiger, flag)
    for _, slot in ipairs(geiger.live) do
        set_shown(slot, flag)
    end
end

local function show_geiger(page, conditions, linked)
    local kit, geiger = page.kit, page.geiger
    local show_row = page.view.show_geiger_row
    set_live_shown(geiger, linked)
    if not linked then
        for key, label in pairs(GEIGER_OFF) do
            show_row(kit, geiger[key], label, label.value)
        end
        geiger.bar.set_ratio(0)
        return
    end
    local reading = wd_geiger.get_exact_reading()
    local shield = wd_geiger.get_shield(conditions)
    local state = GEIGER_STATES[get_geiger_state(reading, shield)]
    show_row(kit, geiger.reading, state.reading, get_geiger_text(reading))
    show_row(kit, geiger.shield, state.shield, get_geiger_text(shield))
    geiger.bar.set_ratio(get_scale_position(reading, geiger.steps))
    kit.set_role(geiger.bar.level, state.reading.role)
    place_geiger_marker(geiger, get_scale_position(shield, geiger.steps))
end

local function show_silhouette(silhouette)
    local level = d_promin_config.get_ui_level()
    local limbs = wd_vitals.get_limbs()
    for _, limb in ipairs(silhouette.limbs) do
        local state = limbs[limb.limb]
        local perm = state.perm
        local tone = wd_face_tones.get_state(perm)
        if limb.tone ~= tone or limb.level ~= level then
            limb.tone, limb.level = tone, level
            limb.temp.set(wd_face_tones.get_body_color(level, "ok", true))
            limb.perm.set(wd_face_tones.get_body_color(level, tone))
        end
        wd_silhouette.set_limb(limb, perm, state.total)
    end
end

local function set_sidebars_shown(page, flag)
    for _, cell in ipairs(page.cells) do
        cell.set_visible(flag)
    end
    for _, slot in ipairs(page.always) do
        set_shown(slot, flag)
    end
    for _, bar in ipairs(page.bars) do
        bar.set_visible(flag)
    end
    if not flag then
        set_live_shown(page.geiger, false)
        for _, row in ipairs(page.effects) do
            set_shown(row.track, false)
            set_shown(row.level, false)
        end
        page.mobility.border.set_visible(false)
    end
    for _, widget in ipairs(page.silhouette.fills) do
        widget:Show(flag)
    end
end

local function collect_widgets(page)
    local cells, always, bars = {}, {}, {}
    local function add_row_cells(row)
        cells[#cells + 1] = row.icon
        cells[#cells + 1] = row.name
        cells[#cells + 1] = row.value
    end
    for _, row in ipairs(page.effects) do
        add_row_cells(row)
    end
    for _, row in pairs(page.status) do
        add_row_cells(row)
        bars[#bars + 1] = row.bar
    end
    cells[#cells + 1] = page.mobility.cell
    local geiger = page.geiger
    add_row_cells(geiger.reading)
    add_row_cells(geiger.shield)
    always[#always + 1] = geiger.frame
    bars[#bars + 1] = geiger.bar
    always[#always + 1] = page.status.stamina.cap
    always[#always + 1] = page.status.stamina.tick
    for _, track in ipairs(page.silhouette.tracks) do
        always[#always + 1] = track
    end
    page.cells, page.always, page.bars = cells, always, bars
end

local function update_slow(page, conditions)
    local kit, status = page.kit, page.status
    local food, water, sleep = wd_vitals.get_needs(conditions)
    show_need(kit, status.food, food)
    show_need(kit, status.water, water)
    show_need(kit, status.sleep, sleep)
    show_weight(kit, status.weight, conditions)
    show_mobility(page.mobility, conditions)
end

local VIEW = {
    show_effect = show_effect,
    show_geiger_row = show_geiger_row,
    show_vitals = show_vitals,
    update_slow = update_slow,
    set_widgets_shown = set_sidebars_shown,
}

local function apply_visibility(page)
    local visible = page.page_visible and not page.blanked
    page.chrome.set_visible(visible)
    if page.kit then
        page.view.set_widgets_shown(page, visible)
        page.allow_slow = wd_core.throttle(SLOW_REFRESH_MS)
        page.allow_geiger = wd_core.throttle(wd_geiger.REFRESH_MS)
    end
end

local function update_effects(page, conditions)
    local kit, effects, show_entry = page.kit, page.effects, page.view.show_effect
    for _, entry in ipairs(effects) do
        entry.seconds = 0
    end
    conditions:BoosterForEach(page.add_booster)
    for _, entry in ipairs(effects) do
        show_entry(kit, entry)
    end
end

local function update_page(page)
    local blanked = not db.actor or not db.actor:alive()
    if page.blanked ~= blanked then
        page.blanked = blanked
        apply_visibility(page)
    end
    if blanked then
        return
    end
    page.chrome.update()
    local conditions = page.kit and wd_vitals.get_conditions()
    if not conditions then
        return
    end
    local view = page.view
    update_effects(page, conditions)
    if page.allow_geiger() then
        page.dose_readable = wd_geiger.is_dose_readable()
        show_geiger(page, conditions, wd_geiger.is_linked())
    end
    view.show_vitals(page, conditions)
    show_silhouette(page.silhouette)
    if page.allow_slow() then
        view.update_slow(page, conditions)
    end
end

function new_page(ctx, background, view)
    local page = { page_visible = true, blanked = false, view = view }
    page.chrome = d_promin_chrome_ui.build({
        init = ctx.init,
        theme = ctx.theme,
        bg_tex = background,
        title_tex = TITLE_TEXTURE,
        wnd = ctx.wnd,
    })

    function page.add_booster(booster_type, seconds)
        local entry = page.effect_by_booster[booster_type]
        if entry and seconds > entry.seconds then
            entry.seconds = seconds
        end
    end

    function page.set_visible(visible)
        page.page_visible = visible
        apply_visibility(page)
        if visible then
            update_page(page)
        end
    end

    function page.update()
        update_page(page)
    end

    return page
end

function build(ctx)
    local page = new_page(ctx, BACKGROUND, VIEW)
    local kit = page.chrome.kit
    page.kit = kit
    if kit then
        page.silhouette = new_silhouette(kit, ctx.wnd, baked.PARTS, "wd_bio_part_", d_promin_config.SPRITES_TEXTURE)
        page.effects, page.effect_by_booster = build_effects(kit)
        page.status = build_status(kit)
        page.mobility = build_mobility(kit)
        page.geiger = build_geiger(kit)
        collect_widgets(page)
    end

    function page.repaint()
        page.chrome.repaint()
    end

    page.set_visible(true)
    return page
end
