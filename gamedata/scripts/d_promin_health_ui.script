local scratch_size = vector2()
local scratch_pos = vector2()

local binder = wd_screen.new_binder(d_promin_config.SCREEN_SHADER)

local LIMBS = { "head", "torso", "leftarm", "rightarm", "leftleg", "rightleg" }

local DATA_KEY = {
    leftarm = "rightarm",
    rightarm = "leftarm",
    leftleg = "rightleg",
    rightleg = "leftleg",
}

local NEEDS = { "food", "water", "sleep" }

local SYS_COLOR = { health = "hp_color", stam = "stam_color", psy = "psy_color", rad = "rad_color" }

local TM_NODES = { "tm_h1", "tm_h2", "tm_m1", "tm_m2" }

local HELMET_SLOT = 12

function get_ui_alpha()
    return wd_screen.get_alpha(d_promin_config.transforms.brightness)
end

local function get_hovered_wheel_section()
    local qaw = haru_quick_action_wheel_mcm
    local gui = qaw and qaw.GUI
    if not gui then
        return nil
    end
    if gui.IsShown and not gui:IsShown() then
        return nil
    end
    local idx = gui.hovered_idx
    if not idx or idx <= 0 then
        return nil
    end
    local opt = gui.options and gui.options[idx]
    return opt and opt.section or nil
end

local function compute_preview(sec, health, timedhp, maxhp)
    local mk = zzz_player_injuries.medkits and zzz_player_injuries.medkits[sec]
    local hh = zzz_player_injuries.healhelp and zzz_player_injuries.healhelp[sec]
    if not mk and not hh then
        return nil, nil
    end

    local pv_h, pv_b = {}, {}
    for _, limb in ipairs(LIMBS) do
        pv_h[limb] = health[limb]
        pv_b[limb] = timedhp[limb]
    end

    if mk then
        for _, limb in ipairs(LIMBS) do
            local bonus = mk[limb]
            if bonus then
                if mk.harming then
                    pv_h[limb] = pv_h[limb] + bonus
                    pv_b[limb] = pv_b[limb] + bonus
                elseif pv_h[limb] + bonus > maxhp[limb] then
                    local amt = maxhp[limb] - pv_h[limb]
                    pv_h[limb] = pv_h[limb] + amt
                    pv_b[limb] = pv_b[limb] + amt
                else
                    pv_h[limb] = pv_h[limb] + bonus
                    pv_b[limb] = pv_b[limb] + bonus
                end
            end
        end
    end
    if hh then
        for _, limb in ipairs(LIMBS) do
            if hh[limb] then
                pv_b[limb] = pv_b[limb] - hh[limb]
                if pv_b[limb] < 0 then
                    pv_b[limb] = 0
                end
            end
        end
    end
    for _, limb in ipairs(LIMBS) do
        if pv_h[limb] > maxhp[limb] then
            pv_h[limb] = maxhp[limb]
        end
        if pv_h[limb] <= 0 then
            pv_h[limb] = 0
        end
        if pv_h[limb] < pv_b[limb] then
            pv_b[limb] = health[limb]
        end
    end
    return pv_h, pv_b
end

local SCREEN = { x = 0.001, y = -0.008, w = 0.084, h = 0.0458 }

local function new_px_space(img_w, img_h)
    local space = {}
    function space.x(px)
        return SCREEN.x + px * SCREEN.w / img_w
    end
    function space.y(py)
        return SCREEN.y + py * SCREEN.h / img_h
    end
    function space.w(pw)
        return pw * SCREEN.w / img_w
    end
    function space.h(ph)
        return ph * SCREEN.h / img_h
    end
    function space.box(px, py, pw, ph)
        return { space.x(px), space.y(py), space.w(pw), space.h(ph) }
    end
    return space
end

local px_v2 = new_px_space(1100, 600)

function get_px()
    return px_v2
end

local DIG_TEX = {}
for digit = 0, 9 do
    DIG_TEX[digit] = "dig2_" .. digit
end
local GHOST_DIG_TEX = "dig2_g0"

