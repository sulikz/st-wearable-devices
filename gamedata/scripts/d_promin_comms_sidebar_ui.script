local px = d_promin_config.get_px()
local map_binder = wd_screen.new_binder(d_promin_config.MAP_SHADER)

local set_shown = wd_screen.set_shown
local place_widget = wd_screen.place_widget

local scratch_pos = vector2()

local LAYOUT = {
    x = 725,
    top = 75,
    w = 300,
    inset = 10,
    text_h = 18,
    line_box_h = 20,
    plate = { y = 10, h = 198, glyph = 96, emblem = 64 },
    name = { y = 216, box_h = 27, h = 24 },
    blocks = { top = 252, pitch = 60 },
    cell = { h = 56, pad = 10, label = { dy = 6, box_h = 17, h = 15 }, value_dy = 26 },
    faction = { emblem_dy = 29, emblem = 18, emblem_dx = 26 },
    tiers = { w = 138, pitch = 142 },
    rule = { gap = 10, h = 2 },
    stamp = { gap = 10, pitch = 20, lines = 2 },
}
LAYOUT.inner_w = LAYOUT.w - 2 * LAYOUT.inset

local BORDER_ROLES = { border = "border" }
local RADIO_GLYPH = wd_comms.RADIO_GLYPH
local TONE_ROLES = { tracked = "tracked", warn = "warn", crit = "crit" }
local ALERT_ROLES = { warn = "warn", crit = "crit" }
local SEPARATOR = " \183 "
local TIER_PREFIXES = { rank = "st_rank_", reputation = "st_reputation_" }

GLYPH_IDS = {}
SMALL_GLYPH_IDS = {}
for _, glyph in ipairs(wd_comms.GLYPHS) do
    GLYPH_IDS[glyph] = "wd_comms_icon_" .. glyph
    SMALL_GLYPH_IDS[glyph] = GLYPH_IDS[glyph] .. "_small"
end

local get_emblem_id = d_promin_chrome_ui.get_emblem_id

function get_tone_role(entry)
    return TONE_ROLES[entry.tone] or "text"
end

function get_alert_role(entry)
    return ALERT_ROLES[entry.tone]
end

local function get_upper(text)
    return wd_text.get_upper(text or "")
end

function get_sender_icon(entry, ids)
    if entry.glyph == nil and entry.community then
        return get_emblem_id(entry.community), true
    end
    return ids[entry.glyph] or ids[RADIO_GLYPH], false
end

local function place_text(text, left, box_top, box_h, height)
    text.place(px.w(left), px.h(box_top + (box_h - height) / 2))
end

local function get_tier_text(key, tier)
    return wd_text.get_upper(game.translate_string(TIER_PREFIXES[key] .. tier))
end

local function new_cell(kit, holder, key, width)
    local spec = LAYOUT.cell
    local label = spec.label
    local label_text = wd_text.get_upper(key)
    local cell = {
        box = kit.new_box(BORDER_ROLES, holder),
        label = kit.new_text({ parent = holder, chars = #label_text, height = px.h(label.h) }),
        value = kit.new_text({ parent = holder, chars = kit.get_max_chars(px.w(width - 2 * spec.pad)) }),
    }

    function cell.show(left, top, value, value_dx)
        cell.box.place(px.w(left), px.h(top), px.w(width), px.h(spec.h))
        cell.box.set_visible(true)
        place_text(cell.label, left + spec.pad, top + label.dy, label.box_h, label.h)
        cell.label.show(label_text, "meta")
        place_text(cell.value, left + value_dx, top + spec.value_dy, LAYOUT.line_box_h, LAYOUT.text_h)
        cell.value.show(kit.fit(value, px.w(width - value_dx - spec.pad)), "text")
    end

    function cell.hide()
        cell.box.set_visible(false)
        cell.label.set_visible(false)
        cell.value.set_visible(false)
    end

    return cell
end

function new(kit)
    local font = kit.font
    local holder = kit.new_holder()
    holder:SetWndPos(scratch_pos:set(px.x(LAYOUT.x), px.y(LAYOUT.top)))
    local sidebar_w = px.w(LAYOUT.w)
    local inset_x = px.w(LAYOUT.inset)
    local inner_w = px.w(LAYOUT.inner_w)
    local plate_h = px.h(LAYOUT.plate.h)
    local name_h = px.h(LAYOUT.name.h)
    local line_chars = kit.get_max_chars(inner_w)
    local sidebar = { visible = false }

    sidebar.card = kit.new_box(BORDER_ROLES, holder)
    sidebar.plate = kit.new_box(nil, holder)
    sidebar.plate.place(inset_x, px.h(LAYOUT.plate.y), inner_w, plate_h)
    sidebar.portrait = kit.new_image(wd_screen.FILL_ID, "art", holder, map_binder)
    place_widget(sidebar.portrait.widget, inset_x, px.h(LAYOUT.plate.y), inner_w, plate_h)
    sidebar.glyph = kit.new_image(GLYPH_IDS[RADIO_GLYPH], "text", holder)
    sidebar.name =
        kit.new_text({ parent = holder, chars = wd_text.get_max_chars(font, name_h, inner_w), height = name_h })
    place_text(sidebar.name, LAYOUT.inset, LAYOUT.name.y, LAYOUT.name.box_h, LAYOUT.name.h)
    sidebar.faction = new_cell(kit, holder, "faction", LAYOUT.inner_w)
    sidebar.emblem = kit.new_image(wd_screen.FILL_ID, "text", holder)
    sidebar.rank = new_cell(kit, holder, "rank", LAYOUT.tiers.w)
    sidebar.reputation = new_cell(kit, holder, "reputation", LAYOUT.tiers.w)
    sidebar.rule = kit.new_fill("border", holder)
    sidebar.channel = kit.new_text({ parent = holder, chars = line_chars })
    sidebar.stamp = kit.new_text({ parent = holder, chars = line_chars })

    local shown_entry = nil

    local function place_footer(rule_y)
        local stamp = LAYOUT.stamp
        local stamp_y = rule_y + stamp.gap
        place_widget(sidebar.rule.widget, inset_x, px.h(rule_y), inner_w, px.h(LAYOUT.rule.h))
        place_text(sidebar.channel, LAYOUT.inset, stamp_y, LAYOUT.line_box_h, LAYOUT.text_h)
        place_text(sidebar.stamp, LAYOUT.inset, stamp_y + stamp.pitch, LAYOUT.line_box_h, LAYOUT.text_h)
        sidebar.card.place(0, 0, sidebar_w, px.h(stamp_y + stamp.lines * stamp.pitch + LAYOUT.inset))
    end

    local function hide_details()
        set_shown(sidebar.portrait, false)
        set_shown(sidebar.glyph, false)
        sidebar.card.set_visible(false)
        sidebar.name.set_visible(false)
        set_shown(sidebar.emblem, false)
        sidebar.faction.hide()
        sidebar.rank.hide()
        sidebar.reputation.hide()
        set_shown(sidebar.rule, false)
        sidebar.channel.set_visible(false)
        sidebar.stamp.set_visible(false)
    end

    local function show_glyph(entry)
        local id, is_emblem = get_sender_icon(entry, GLYPH_IDS)
        local size = is_emblem and LAYOUT.plate.emblem or LAYOUT.plate.glyph
        kit.set_image(sidebar.glyph, id)
        kit.set_role(sidebar.glyph, get_alert_role(entry) or "text")
        place_widget(
            sidebar.glyph.widget,
            px.w(LAYOUT.inset + (LAYOUT.inner_w - size) / 2),
            px.h(LAYOUT.plate.y + (LAYOUT.plate.h - size) / 2),
            px.w(size),
            px.h(size)
        )
        set_shown(sidebar.glyph, true)
    end

    local function show_faction(entry, top)
        local faction = entry.faction
        local community = faction and entry.community
        if community then
            local spec = LAYOUT.faction
            kit.set_image(sidebar.emblem, get_emblem_id(community))
            local left = px.w(LAYOUT.inset + LAYOUT.cell.pad)
            place_widget(sidebar.emblem.widget, left, px.h(top + spec.emblem_dy), px.w(spec.emblem), px.h(spec.emblem))
        end
        set_shown(sidebar.emblem, community ~= nil)
        if not faction then
            sidebar.faction.hide()
            return top
        end
        local value_dx = LAYOUT.cell.pad + (community and LAYOUT.faction.emblem_dx or 0)
        sidebar.faction.show(LAYOUT.inset, top, wd_text.get_upper(faction), value_dx)
        return top + LAYOUT.blocks.pitch
    end

    local function show_tiers(entry, top)
        local rank = entry.rank
        local reputation = entry.reputation
        if rank == nil or reputation == nil then
            sidebar.rank.hide()
            sidebar.reputation.hide()
            return top
        end
        local pad = LAYOUT.cell.pad
        sidebar.rank.show(LAYOUT.inset, top, get_tier_text("rank", rank), pad)
        sidebar.reputation.show(LAYOUT.inset + LAYOUT.tiers.pitch, top, get_tier_text("reputation", reputation), pad)
        return top + LAYOUT.blocks.pitch
    end

    local function apply_plate()
        local entry = shown_entry
        local portrait_id = entry and entry.portrait
        local person = portrait_id ~= nil
        sidebar.plate.set_visible(not person)
        if not entry then
            hide_details()
            return
        end
        if person then
            kit.set_image(sidebar.portrait, portrait_id)
            set_shown(sidebar.glyph, false)
        else
            show_glyph(entry)
        end
        set_shown(sidebar.portrait, person)
        sidebar.card.set_visible(true)
        sidebar.name.show(wd_text.ellipsize(font, get_upper(entry.name), name_h, inner_w), get_tone_role(entry))
        local blocks_bottom = show_tiers(entry, show_faction(entry, LAYOUT.blocks.top))
        place_footer(blocks_bottom + LAYOUT.rule.gap)
        set_shown(sidebar.rule, true)
        local channel = get_upper(entry.channel) .. SEPARATOR .. get_upper(entry.level)
        sidebar.channel.show(kit.fit(channel, inner_w), "meta")
        sidebar.stamp.show(kit.fit(d_promin_comms_feed.format_stamp(entry), inner_w), "meta")
    end

    function sidebar.show(entry)
        if entry == shown_entry then
            return
        end
        shown_entry = entry
        if sidebar.visible then
            apply_plate()
        end
    end

    function sidebar.set_visible(flag)
        sidebar.visible = flag
        if flag then
            apply_plate()
            return
        end
        sidebar.plate.set_visible(false)
        hide_details()
    end

    return sidebar
end
