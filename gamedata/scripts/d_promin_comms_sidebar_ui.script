local px = d_promin_config.get_px()
local map_binder = wd_screen.new_binder(d_promin_config.MAP_SHADER)

local set_shown = wd_screen.set_shown
local place_widget = wd_screen.place_widget

local scratch_pos = vector2()

LAYOUTS = {
    [d_promin_config.DEFAULT_THEME] = {
        x = 725,
        top = 75,
        w = 300,
        inset = 10,
        header = { y = 6, h = 15, rule_y = 26, rule_h = 1.5 },
        plate = { bottom = 394, glyph = 96, emblem = 64 },
        name = { y = 398, box_h = 27, h = 24 },
        lines_top = 428,
        cell = { h = 20, text_h = 18 },
        faction = { emblem_dy = 2, emblem = 16, emblem_dx = 22 },
        channel_gap = 2,
        squad = {
            ruled = true,
            tile = { y = 30, h = 56, gap = 4, columns = 2, inset = 5 },
            slots = 4,
            portrait = { w = 51, h = 36 },
            health = { x = 61 },
            track = { h = 6, border_w = 0.6, inset = 1.5 },
            glyph = { id = "wd_nav_icon_squad", w = 22, h = 16.3 },
        },
    },
    [d_promin_config.LARGE_THEME] = {
        x = 775,
        top = 75,
        w = 300,
        inset = 10,
        header = { y = 8, h = 23, rule_y = 32, rule_h = 1.5 },
        plate = { bottom = 368, glyph = 96, emblem = 64 },
        name = { y = 372, box_h = 36, h = 33 },
        lines_top = 410,
        cell = { h = 26, text_h = 23 },
        faction = { emblem_dy = 3, emblem = 20, emblem_dx = 26 },
        channel_gap = 2,
        squad = {
            ruled = false,
            tile = { y = 36, h = 65, gap = 4, columns = 2, inset = 5 },
            slots = 4,
            portrait = { w = 62, h = 44 },
            health = { x = 70 },
            track = { h = 7, border_w = 0.75, inset = 1.5 },
            glyph = { id = "wd_large_nav_icon_squad", w = 28, h = 20.7 },
        },
    },
}
for _, layout in pairs(LAYOUTS) do
    layout.inner_w = layout.w - 2 * layout.inset
    local squad = layout.squad
    local tile = squad.tile
    tile.w = (layout.inner_w - (tile.columns - 1) * tile.gap) / tile.columns
    squad.h = tile.y + math.ceil(squad.slots / tile.columns) * (tile.h + tile.gap)
    layout.card_top = squad.h + layout.inset
    local plate = layout.plate
    plate.y = layout.card_top + layout.header.rule_y + layout.header.rule_h
    plate.h = plate.bottom - plate.y
end
LAYOUT = LAYOUTS[d_promin_config.DEFAULT_THEME]

local BORDER_ROLES = { border = "border" }
local RADIO_GLYPH = wd_comms.RADIO_GLYPH
local TONE_ROLES = { tracked = "tracked", warn = "warn", crit = "crit" }
local ALERT_ROLES = { warn = "warn", crit = "crit" }
local SEPARATOR = " \183 "
local RANK_PREFIX = "st_rank_"

GLYPH_IDS = {}
SMALL_GLYPH_IDS = {}
for _, glyph in ipairs(wd_comms.GLYPHS) do
    GLYPH_IDS[glyph] = "wd_comms_icon_" .. glyph
    SMALL_GLYPH_IDS[glyph] = GLYPH_IDS[glyph] .. "_small"
end

local get_emblem_id = d_promin_chrome_ui.get_emblem_id

function get_tone_role(entry)
    return TONE_ROLES[entry.tone] or "text"
end

function get_alert_role(entry)
    return ALERT_ROLES[entry.tone]
end

local function get_upper(text)
    return wd_text.get_upper(text or "")
end

function get_sender_icon(entry, ids)
    if entry.glyph == nil and entry.community then
        return get_emblem_id(entry.community), true
    end
    return ids[entry.glyph] or ids[RADIO_GLYPH], false
end

local function place_text(text, left, box_top, box_h, height)
    text.place(px.w(left), px.h(box_top + (box_h - height) / 2))
end

local function get_rank_text(rank)
    return wd_text.get_upper(game.translate_string(RANK_PREFIX .. rank))
end

local function new_line(kit, holder, layout)
    local spec = layout.cell
    local text_h = px.h(spec.text_h)
    local width = layout.inner_w
    local value = kit.new_text({ parent = holder, chars = kit.get_max_chars(px.w(width), text_h), height = text_h })
    local line = { value = value }

    function line.show(top, text, value_dx, role)
        place_text(value, layout.inset + value_dx, top, spec.h, spec.text_h)
        value.show(kit.fit(text, px.w(width - value_dx), text_h), role)
    end

    function line.hide()
        value.set_visible(false)
    end

    return line
end

local SQUAD_LABEL = "SQUAD"
local SENDER_LABEL = "SENDER"
local HEALTH_TEXT = "%d%%"

local function place_box(box, left, top, width, height)
    box.place(px.w(left), px.h(top), px.w(width), px.h(height))
end

local function new_header(kit, holder, layout, top, label, ruled)
    local spec = layout.header
    local header = { title = kit.new_text({ parent = holder, chars = #label, height = px.h(spec.h) }) }
    header.title.place(px.w(layout.inset), px.h(top + spec.y))
    if ruled then
        header.rule = kit.new_soft_fill("border", wd_panel.SOFT_FILLS.line_h, holder)
        wd_panel.place_soft_fill(
            header.rule,
            px.w(layout.inset),
            px.h(top + spec.rule_y),
            px.w(layout.inner_w),
            px.h(spec.rule_h)
        )
    end

    function header.set_shown(flag)
        if flag then
            header.title.show(label, "meta")
        else
            header.title.set_visible(false)
        end
        if header.rule then
            set_shown(header.rule, flag)
        end
    end

    return header
end

local function new_squad_slot(kit, holder, spec, left, top)
    local tile = spec.tile
    local inset = tile.inset
    local portrait = spec.portrait
    local health_x = spec.health.x
    local track = spec.track
    local glyph = spec.glyph
    local slot = {
        box = kit.new_box(nil, holder),
        portrait = kit.new_image(wd_screen.FILL_ID, "art", holder, map_binder),
        frame = kit.new_box(BORDER_ROLES, holder),
        glyph = kit.new_image(glyph.id, "dim", holder),
        health = kit.new_text({
            parent = holder,
            chars = #string.format(HEALTH_TEXT, 100),
            width = px.w(tile.w - health_x - inset),
            align = "right",
        }),
        track = kit.new_box({ fill = "track_fill", border = "track_border", border_w = px.h(track.border_w) }, holder),
        bar = kit.new_bar({ level = "text", inset = px.h(track.inset), parent = holder }),
    }
    place_box(slot.box, left, top, tile.w, tile.h)
    local portrait_box = { px.w(left + inset), px.h(top + inset), px.w(portrait.w), px.h(portrait.h) }
    place_widget(slot.portrait.widget, portrait_box[1], portrait_box[2], portrait_box[3], portrait_box[4])
    slot.frame.place(portrait_box[1], portrait_box[2], portrait_box[3], portrait_box[4])
    place_widget(
        slot.glyph.widget,
        px.w(left + (tile.w - glyph.w) / 2),
        px.h(top + (tile.h - glyph.h) / 2),
        px.w(glyph.w),
        px.h(glyph.h)
    )
    slot.health.place(px.w(left + health_x), portrait_box[2] + (portrait_box[4] - kit.style.text_h) / 2)
    local track_y = top + tile.h - inset - track.h
    local track_w = tile.w - 2 * inset
    place_box(slot.track, left + inset, track_y, track_w, track.h)
    slot.bar.place(px.w(left + inset), px.h(track_y), px.w(track_w), px.h(track.h))
    return slot
end

local function new_squad(kit, holder, layout)
    local spec = layout.squad
    local tile = spec.tile
    local squad = {
        frame = kit.new_box(nil, holder),
        header = new_header(kit, holder, layout, 0, SQUAD_LABEL, spec.ruled),
        count = kit.new_text({
            parent = holder,
            chars = 2,
            width = px.w(layout.inner_w),
            align = "right",
            height = px.h(layout.header.h),
        }),
        slots = {},
    }
    place_box(squad.frame, 0, 0, layout.w, spec.h)
    squad.count.place(px.w(layout.inset), px.h(layout.header.y))
    for index = 1, spec.slots do
        local column = (index - 1) % tile.columns
        local row = math.floor((index - 1) / tile.columns)
        local left = layout.inset + column * (tile.w + tile.gap)
        local top = tile.y + row * (tile.h + tile.gap)
        squad.slots[index] = new_squad_slot(kit, holder, spec, left, top)
    end
    return squad
end

local function hide_squad_slot(slot)
    slot.box.set_visible(false)
    set_shown(slot.portrait, false)
    slot.frame.set_visible(false)
    set_shown(slot.glyph, false)
    slot.health.set_visible(false)
    slot.track.set_visible(false)
    slot.bar.set_visible(false)
end

local function show_squad_slot(kit, slot, companion)
    slot.box.set_visible(true)
    local icon = companion and companion.icon
    if icon then
        kit.set_image(slot.portrait, icon)
    end
    set_shown(slot.portrait, icon ~= nil)
    slot.frame.set_visible(icon ~= nil)
    set_shown(slot.glyph, icon == nil)
    kit.set_role(slot.glyph, companion and "text" or "dim")
    slot.track.set_visible(companion ~= nil)
    slot.bar.set_visible(companion ~= nil)
    if not companion then
        slot.health.set_visible(false)
        return
    end
    local health = companion.health
    local role = d_promin_config.get_state_role(health)
    slot.health.show(string.format(HEALTH_TEXT, d_promin_health_ui.get_percent(health)), role)
    slot.bar.set_ratio(health)
    kit.set_role(slot.bar.level, role)
end

local function hide_squad(squad)
    squad.frame.set_visible(false)
    squad.header.set_shown(false)
    squad.count.set_visible(false)
    for _, slot in ipairs(squad.slots) do
        hide_squad_slot(slot)
    end
end

local function show_squad(kit, squad, companions)
    squad.frame.set_visible(true)
    squad.header.set_shown(true)
    squad.count.show(tostring(#companions), "meta")
    for index, slot in ipairs(squad.slots) do
        show_squad_slot(kit, slot, companions[index])
    end
end

function new(kit, layout)
    local font = kit.font
    local holder = kit.new_holder()
    holder:SetWndPos(scratch_pos:set(px.x(layout.x), px.y(layout.top)))
    local sidebar_w = px.w(layout.w)
    local inset_x = px.w(layout.inset)
    local inner_w = px.w(layout.inner_w)
    local plate_h = px.h(layout.plate.h)
    local name_h = px.h(layout.name.h)
    local pitch = layout.cell.h
    local sidebar = { visible = false }

    sidebar.card = kit.new_box(BORDER_ROLES, holder)
    sidebar.plate = kit.new_box(nil, holder)
    sidebar.plate.place(inset_x, px.h(layout.plate.y), inner_w, plate_h)
    sidebar.portrait = kit.new_image(wd_screen.FILL_ID, "art", holder, map_binder)
    place_widget(sidebar.portrait.widget, inset_x, px.h(layout.plate.y), inner_w, plate_h)
    sidebar.glyph = kit.new_image(GLYPH_IDS[RADIO_GLYPH], "text", holder)
    sidebar.name =
        kit.new_text({ parent = holder, chars = wd_text.get_max_chars(font, name_h, inner_w), height = name_h })
    place_text(sidebar.name, layout.inset, layout.name.y, layout.name.box_h, layout.name.h)
    sidebar.faction = new_line(kit, holder, layout)
    sidebar.emblem = kit.new_image(wd_screen.FILL_ID, "text", holder)
    sidebar.rank = new_line(kit, holder, layout)
    sidebar.channel = new_line(kit, holder, layout)
    sidebar.squad = new_squad(kit, holder, layout)
    sidebar.card_header = new_header(kit, holder, layout, layout.card_top, SENDER_LABEL, true)

    local shown_entry = nil

    local function show_footer(footer_y, channel)
        local channel_y = footer_y + layout.channel_gap
        sidebar.channel.show(channel_y, channel, 0, "meta")
        local card_top = layout.card_top
        local card_bottom = channel_y + pitch + layout.inset
        sidebar.card.place(0, px.h(card_top), sidebar_w, px.h(card_bottom - card_top))
    end

    local function hide_details()
        set_shown(sidebar.portrait, false)
        set_shown(sidebar.glyph, false)
        sidebar.card_header.set_shown(false)
        sidebar.card.set_visible(false)
        sidebar.name.set_visible(false)
        set_shown(sidebar.emblem, false)
        sidebar.faction.hide()
        sidebar.rank.hide()
        sidebar.channel.hide()
    end

    local function show_glyph(entry)
        local id, is_emblem = get_sender_icon(entry, GLYPH_IDS)
        local size = is_emblem and layout.plate.emblem or layout.plate.glyph
        kit.set_image(sidebar.glyph, id)
        kit.set_role(sidebar.glyph, get_alert_role(entry) or "text")
        place_widget(
            sidebar.glyph.widget,
            px.w(layout.inset + (layout.inner_w - size) / 2),
            px.h(layout.plate.y + (layout.plate.h - size) / 2),
            px.w(size),
            px.h(size)
        )
        set_shown(sidebar.glyph, true)
    end

    local function show_faction(entry, top)
        local faction = entry.faction
        local community = faction and entry.community
        local spec = layout.faction
        if community then
            kit.set_image(sidebar.emblem, get_emblem_id(community))
            place_widget(
                sidebar.emblem.widget,
                inset_x,
                px.h(top + spec.emblem_dy),
                px.w(spec.emblem),
                px.h(spec.emblem)
            )
        end
        set_shown(sidebar.emblem, community ~= nil)
        if not faction then
            sidebar.faction.hide()
            return top
        end
        sidebar.faction.show(top, wd_text.get_upper(faction), community and spec.emblem_dx or 0, "text")
        return top + pitch
    end

    local function show_rank(entry, top)
        local rank = entry.rank
        if rank == nil then
            sidebar.rank.hide()
            return top
        end
        sidebar.rank.show(top, get_rank_text(rank), 0, "text")
        return top + pitch
    end

    local function apply_plate()
        local entry = shown_entry
        local portrait_id = entry and entry.portrait
        local person = portrait_id ~= nil
        sidebar.plate.set_visible(not person)
        if not entry then
            hide_details()
            return
        end
        if person then
            kit.set_image(sidebar.portrait, portrait_id)
            set_shown(sidebar.glyph, false)
        else
            show_glyph(entry)
        end
        set_shown(sidebar.portrait, person)
        sidebar.card.set_visible(true)
        sidebar.card_header.set_shown(true)
        sidebar.name.show(wd_text.ellipsize(font, get_upper(entry.name), name_h, inner_w), get_tone_role(entry))
        local channel = get_upper(entry.channel) .. SEPARATOR .. get_upper(entry.level)
        show_footer(show_rank(entry, show_faction(entry, layout.lines_top)), channel)
    end

    local function apply_squad()
        local squad = sidebar.squad
        local companions = sidebar.visible and sidebar.companions
        if companions then
            show_squad(kit, squad, companions)
        else
            hide_squad(squad)
        end
    end

    function sidebar.show(entry)
        if entry == shown_entry then
            return
        end
        shown_entry = entry
        if sidebar.visible then
            apply_plate()
        end
    end

    function sidebar.show_squad(companions)
        sidebar.companions = companions
        if sidebar.visible then
            apply_squad()
        end
    end

    function sidebar.set_visible(flag)
        sidebar.visible = flag
        apply_squad()
        if flag then
            apply_plate()
            return
        end
        sidebar.plate.set_visible(false)
        hide_details()
    end

    return sidebar
end
