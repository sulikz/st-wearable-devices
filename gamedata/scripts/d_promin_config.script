        section = "wd_promin_module_conn",
        model = "wd\\promin\\promin_s_m_conn",
        bay = "conn",
    },
    {
        name = "side",
        section = "wd_promin_module_side",
        bay = "side",
    },
}

function get_bay(bay_id)
    for _, bay in ipairs(BAYS) do
        if bay.id == bay_id then
            return bay
        end
    end
    return nil
end

function get_module(name)
    for _, module in ipairs(MODULES) do
        if module.name == name then
            return module
        end
    end
    return nil
end

function get_module_of_section(section)
    for _, module in ipairs(MODULES) do
        if module.section == section then
            return module
        end
    end
    return nil
end

