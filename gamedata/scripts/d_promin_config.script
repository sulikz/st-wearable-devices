local cfg = wd_config.new({
    section = SECTION,
    global_key = "promin",
    tiers = TIERS,
    tier_fields = TIER_FIELDS,
    family_fields = FAMILY_FIELDS,
    variant_fields = VARIANT_FIELDS,
    variant_defaults = VARIANT_DEFAULTS,
    user_fields = USER_FIELDS,
    defaults = DEFAULTS,
    emblems = EMBLEMS,
})

transforms = cfg.transforms
saved = cfg.saved
snapshot_saved = cfg.snapshot_saved
load_transforms = cfg.load_transforms
save_global = cfg.save_global
set_variant = cfg.set_variant
get_variant = cfg.get_variant
get_defaults = cfg.get_defaults
get_tier_of = cfg.get_tier_of
set_active_tier = cfg.set_active_tier
reset_active_tier = cfg.reset_active_tier
