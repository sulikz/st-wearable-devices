function get_hand_section()
    return ANIM_SECTION
end

function set_map_zoom(value)
    cfg.transforms.map_zoom = value
end

function get_active_bays()
    return cfg.get_active_tier().bays or {}
end

function get_battery_consumption()
    return cfg.get_active_tier().consumption or BATTERY_MA
end

local function new_px_space(img_w, img_h)
    local space = {}
    function space.x(px)
        return SCREEN.x + px * SCREEN.w / img_w
    end
    function space.y(py)
        return SCREEN.y + py * SCREEN.h / img_h
    end
    function space.w(pw)
        return pw * SCREEN.w / img_w
    end
    function space.h(ph)
        return ph * SCREEN.h / img_h
    end
    function space.box(px, py, pw, ph)
        return { space.x(px), space.y(py), space.w(pw), space.h(ph) }
    end
    function space.place(widget, px, py, pw, ph)
        wd_screen.place_widget(widget, space.x(px), space.y(py), space.w(pw), space.h(ph))
    end
    function space.place_box(box, px, py, pw, ph)
        box.place(space.x(px), space.y(py), space.w(pw), space.h(ph))
    end
    return space
end

local px_space = new_px_space(ART_W, ART_H)

function get_px()
    return px_space
end

PANEL_STYLE = {
    border_w = px_space.h(1.5),
    text_h = px_space.h(18),
    pad = px_space.w(10),
    gap = px_space.w(8),
    row_h = px_space.h(32),
}

function get_ui_level()
    return wd_screen.get_brightness_level(cfg.transforms.brightness)
end

function get_dimmed_tint(red, green, blue)
    return wd_screen.get_dimmed_color(get_ui_level(), red, green, blue)
end

function get_tint(rgb)
    return get_dimmed_tint(rgb[1], rgb[2], rgb[3])
end

local STATE_ROLES = { ok = "text", warn = "warn", crit = "crit" }

function get_state_role(value, rising, warn_at, crit_at)
    return STATE_ROLES[wd_face_tones.get_state(value, rising, warn_at, crit_at)]
end

function get_group_tint(key)
    return get_tint(cfg.transforms[key])
end
