local SECTION = d_vektor_config.SECTION
local UI_BONE = "wpn_body"

local ATT_NAME = SECTION
local LED_ANOMALY_NAME = "vektor_led_anomaly"
local LED_RAD_NAME = "vektor_led_rad"
local LED_HOST_NAMES = { LED_ANOMALY_NAME, LED_RAD_NAME }
local FACE_SAVE_DELAY_MS = 1000

local face_save_deadline = nil

local glow = wd_screen.new_screen_glow({
    name = ATT_NAME,
    config = d_vektor_config,
    is_lit = function()
        return is_worn() and not wd_exo.is_exo()
    end,
})

local function new_led_glow(att_name, color, get_offset)
    return wd_attach.new_blink_glow({
        name = att_name,
        color = color,
        range = d_vektor_config.LED_RANGE,
        get_offset = get_offset,
        is_lit = function()
            return is_worn() and not wd_exo.is_exo()
        end,
    })
end

local anomaly_led = new_led_glow(LED_ANOMALY_NAME, d_vektor_config.LED_ANOMALY_COLOR, function()
    return d_vektor_config.LED_ANOMALY_OFFSET
end)
local rad_led = new_led_glow(LED_RAD_NAME, d_vektor_config.LED_RAD_COLOR, function()
    return d_vektor_config.LED_RAD_OFFSET
end)

local bulbs = wd_attach.new_bulb_set({
    name = ATT_NAME,
    texture = d_vektor_config.BULB_TEXTURE,
    get_texture = d_vektor_config.get_bulb_texture,
    order = d_vektor_config.BULBS,
})

local host = wd_face_host.new({
    id = "vektor",
    config = d_vektor_config,
    is_worn = function()
        return is_worn()
    end,
    anchor = { parent = d_bracer_config.SECTION, body = ATT_NAME, bone = UI_BONE, mount = wd_wrist_roll.MOUNT },
    provides = { status_bar = d_vektor_config.get_status_bar },
})

local owner = wd_worn.new({
    attach_label = "st_attach_vektor",
    detach_label = "st_detach_vektor",
    save_key = "vektor_worn",
    get_obj_value = function(obj)
        return obj and obj:section()
    end,
    wear_group = "watch",
    on_attach = function(obj)
        if not (obj and d_vektor_config.set_active_tier(obj:section())) then
            return false
        end
        if not sync_attachment() then
            return false
        end
        return obj:section()
    end,
    on_detach = function()
        sync_attachment()
        d_vektor_config.reset_active_tier()
    end,
})

function is_worn()
    return owner.is_attached()
end

function get_host()
    return host
end

local function is_attachment_present()
    return wd_attach.has_attachment(ATT_NAME)
end

local function is_sensor_ready()
    return is_worn() and is_attachment_present()
end

local anomaly_sensor = wd_sensor_anomaly.new({
    group = "d_vektor_anomaly",
    enabled = function()
        return is_sensor_ready() and d_vektor_config.has_sensor("anomaly")
    end,
    on_blink = function()
        wd_audio.play("anomaly_blink")
        bulbs.anomaly.set_on(true)
        anomaly_led.set_on(true)
    end,
    off = function()
        bulbs.anomaly.set_on(false)
        anomaly_led.set_on(false)
    end,
})

local rad_sensor = wd_sensor_radiation.new({
    group = "d_vektor_rad",
    enabled = function()
        return is_sensor_ready() and d_vektor_config.has_sensor("rad")
    end,
    on_blink = function()
        bulbs.rad.set_on(true)
        rad_led.set_on(true)
    end,
    off = function()
        bulbs.rad.set_on(false)
        rad_led.set_on(false)
    end,
})

local function get_body_transforms()
    local transforms = d_vektor_config.transforms
    return {
        model_pos = transforms.model_pos,
        model_rot = transforms.model_rot,
        model_scale = transforms.model_scale,
        ui_pos = transforms.ui_pos,
        ui_rot = transforms.ui_rot,
        ui_scale = transforms.ui_scale,
    }
end

local function sync_led_hosts(model, transforms)
    for _, name in ipairs(LED_HOST_NAMES) do
        if model then
            wd_attach.attach({
                name = name,
                model = model,
                parent = d_bracer_config.SECTION,
                mount = wd_wrist_roll.MOUNT,
                transforms = transforms,
                bone_visible = { [UI_BONE] = false },
            })
        else
            wd_attach.detach(name)
        end
    end
end

function sync_attachment()
    glow.sync()
    anomaly_led.sync()
    rad_led.sync()
    if not is_worn() then
        wd_attach.detach(ATT_NAME)
        sync_led_hosts(nil)
        host.sync(nil)
        return nil
    end
    local model = d_vektor_config.get_model()
    local transforms = get_body_transforms()
    local body = wd_attach.attach({
        name = ATT_NAME,
        model = model,
        parent = d_bracer_config.SECTION,
        mount = wd_wrist_roll.MOUNT,
        ui = host.get_screen_ui(),
        ui_bone = UI_BONE,
        transforms = transforms,
    })
    local mounted_model = body and model
    if body then
        bulbs.resolve()
    end
    sync_led_hosts(mounted_model, transforms)
    host.sync(mounted_model)
    return body
end

function reapply_transforms()
    glow.sync()
    local transforms = get_body_transforms()
    for _, name in ipairs(LED_HOST_NAMES) do
        wd_attach.reapply_transforms(name, transforms)
    end
    host.reapply_transforms()
    return wd_attach.reapply_transforms(ATT_NAME, d_vektor_config.transforms)
end

function reapply_brightness()
    host.apply_brightness()
    glow.sync()
end

function update_sensors()
    anomaly_sensor.update()
    rad_sensor.update()
end

function actor_on_first_update()
    anomaly_sensor.reset()
    rad_sensor.reset()
    owner.detach_if_dropped()
    sync_attachment()
end

function get_menu_text(obj)
    return owner.get_menu_text(obj)
end

function toggle_attach(obj)
    wd_slots.toggle(obj)
end

function load_state(m_data)
    owner.load(m_data)
    local value = owner.get_value()
    if type(value) == "string" then
        d_vektor_config.set_active_tier(value)
    end
end

local function get_exo_names()
    local names = { ATT_NAME }
    for _, name in ipairs(LED_HOST_NAMES) do
        names[#names + 1] = name
    end
    for _, name in ipairs(host.get_attachment_names()) do
        names[#names + 1] = name
    end
    return names
end

local function is_classic_theme()
    return wd_faces.get_theme(d_vektor_config).id == wd_faces.CLASSIC_THEME
end

local function register_gui()
    local fields = {
        model_pos = wd_gui.new_slider(-0.3, 0.3),
        model_rot = wd_gui.new_slider(-180, 180),
        model_scale = wd_gui.new_slider(0.01, 3),
        ui_pos = wd_gui.new_slider(-0.1, 0.1),
        ui_rot = wd_gui.new_slider(-180, 180),
        ui_scale = wd_gui.new_slider(0.01, 3),
        brightness = wd_gui.new_percent_slider(),
        status_bar = wd_gui.new_catalog_enum(
            d_vektor_config.STATUS_BARS,
            d_vektor_config.get_status_bar_index,
            { no_apply = true, is_shown = is_classic_theme }
        ),
        face_id = wd_faces.new_theme_field(d_vektor_config, host.refresh_face),
    }
    local screen_rows = {
        { "face_id", nil, 1, "Theme" },
        { "brightness", nil, 5, "Brightness" },
        { "status_bar", nil, 1, "Gauge" },
    }
    wd_clock.add_gui_rows(fields, screen_rows, d_vektor_config)
    wd_wrist_roll.add_gui_check(fields, screen_rows)

    wd_gui.register_device({
        id = "vektor",
        label = "Watch",
        is_worn = is_attachment_present,
        store = function()
            return d_vektor_config.transforms
        end,
        saved = function()
            return d_vektor_config.saved
        end,
        defaults = function()
            return d_vektor_config.DEFAULTS
        end,
        save_global = d_vektor_config.save_global,
        on_apply = function()
            reapply_transforms()
            reapply_brightness()
        end,
        fields = fields,
    })

    wd_gui.register_tab({
        device = "vektor",
        id = "vektor_screen",
        label = "Vektor",
        rows = screen_rows,
    })

    wd_gui.register_tab({
        device = "vektor",
        id = "vektor_model",
        dev = true,
        label = "Position",
        rows = {
            { "model_pos", 1, 0.0005, "Position x" },
            { "model_pos", 2, 0.0005, "Position y" },
            { "model_pos", 3, 0.0005, "Position z" },
            { "model_rot", 1, 0.05, "Yaw (Y)" },
            { "model_rot", 2, 0.05, "Pitch (X)" },
            { "model_rot", 3, 0.05, "Roll (Z)" },
            { "model_scale", nil, 0.001, "Scale" },
        },
    })
    wd_gui.register_tab({
        device = "vektor",
        id = "vektor_display",
        dev = true,
        label = "Display",
        rows = {
            { "ui_pos", 1, 0.00005, "Position x" },
            { "ui_pos", 2, 0.00005, "Position y" },
            { "ui_pos", 3, 0.00005, "Position z" },
            { "ui_rot", 1, 0.05, "Yaw (Y)" },
            { "ui_rot", 2, 0.05, "Pitch (X)" },
            { "ui_rot", 3, 0.05, "Roll (Z)" },
            { "ui_scale", nil, 0.001, "Scale" },
        },
    })
end

local function is_face_shown()
    return is_attachment_present() and not wd_exo.is_exo()
end

local function pick_numbered_face(number, pose)
    if pose ~= wd_inspect.POSE_WATCH or not is_face_shown() then
        return false
    end
    local face_id = wd_faces.get_numbered_face_id(d_vektor_config, number)
    if not face_id then
        return false
    end
    if face_id ~= wd_faces.get_face_id(d_vektor_config) then
        d_vektor_config.transforms.face_id = face_id
        host.refresh_face()
        face_save_deadline = time_global() + FACE_SAVE_DELAY_MS
    end
    return true
end

local function save_face()
    face_save_deadline = nil
    d_vektor_config.save_global()
end

local function update_face_save()
    if face_save_deadline and time_global() >= face_save_deadline then
        save_face()
    end
end

local function flush_face_save()
    if face_save_deadline then
        save_face()
    end
end

local function is_limbs_face_ready()
    return is_face_shown() and wd_faces.is_offered(d_vektor_config, d_vektor_config.LIMBS_FACE_ID)
end

local function show_limbs_face()
    host.set_preview_face(d_vektor_config.LIMBS_FACE_ID)
end

local function hide_limbs_face()
    host.set_preview_face(nil)
end

local function start()
    face_save_deadline = nil
    d_vektor_config.load_transforms()
    wd_trader.register(d_vektor_config.TIERS[1].section, 1)
end

function register()
    wd_slots.register_device({
        id = "vektor",
        slot = "wrist",
        matches_section = function(section)
            return d_vektor_config.get_tier_of(section) ~= nil
        end,
        owner = owner,
        is_present = is_attachment_present,
        resync = sync_attachment,
        get_transforms = function()
            return d_vektor_config.transforms
        end,
    })
    wd_exo.register_device({
        id = "vektor",
        names = get_exo_names(),
        hide_screen = true,
        resync = sync_attachment,
    })
    wd_core.register({
        id = "vektor",
        callbacks = {
            actor_on_first_update = { actor_on_first_update },
            actor_on_update = {
                host.update_layers,
                { host.update, interval = 200 },
                { update_sensors, interval = 200 },
                { update_face_save, interval = 200 },
            },
            actor_on_net_destroy = { host.close, flush_face_save },
            save_state = { owner.save },
            load_state = { load_state },
        },
        on_start = start,
    })
    register_gui()
    wd_inspect.register_number_key(pick_numbered_face)
    wd_qaw_preview.register_preview(wd_inspect.POSE_WATCH, {
        is_ready = is_limbs_face_ready,
        show = show_limbs_face,
        hide = hide_limbs_face,
    })
end
