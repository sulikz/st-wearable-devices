local MAX_MARKS = 64
local ICON_H = 0.0035
local PDA_ICON_PX = 19
local ARROW_H = 0.0018

local scratch_pos = vector2()
local scratch_size = vector2()
local scratch_rect = Frect()

local binder = wd_screen.new_binder(d_promin_config.SCREEN_SHADER)

local px = d_promin_health_ui.get_px()
local CHROME = d_promin_health_ui.get_layout()

local BG_TEXTURE = "wd_tab_bg_map"
local VIEW = { x = px.x(572), y = px.y(85), w = px.w(425), h = px.h(450) }

local ARROW_FRAMES = 64
local ARROW_GRID = 8
local ARROW_CELL = 48
local ARROW_ART_H = 29

local TRANSITION_ART_PX = 128

ICONS = {
    arrow = { id = "wd_map_arrow_frames", scale = ARROW_CELL / ARROW_ART_H },
    quest_arrow = {
        id = "wd_map_arrow_frames",
        px_w = ARROW_CELL,
        px_h = ARROW_CELL,
        scale = ARROW_CELL / ARROW_ART_H / 2,
    },
}
for _, direction in ipairs(wd_map_marks.TRANSITION_DIRECTIONS) do
    ICONS["transition_" .. direction] = {
        id = "wd_map_transition_" .. direction,
        px_w = TRANSITION_ART_PX,
        px_h = TRANSITION_ART_PX,
    }
end

function get_arrow_frame(offset_x, offset_y)
    local step = 2 * math.pi / ARROW_FRAMES
    return math.floor(math.atan2(offset_x, -offset_y) / step + 0.5) % ARROW_FRAMES
end

local function set_arrow_frame(widget, frame)
    local cell_x = frame % ARROW_GRID * ARROW_CELL
    local cell_y = math.floor(frame / ARROW_GRID) * ARROW_CELL
    widget:SetTextureRect(scratch_rect:set(cell_x, cell_y, cell_x + ARROW_CELL, cell_y + ARROW_CELL))
end

local frame_alpha = 0
local arrow_tint, arrow_tint_alpha = nil, nil
local white_tint, white_tint_alpha = nil, nil
local storyline_pin_tint, storyline_pin_tint_alpha = nil, nil

local function get_icon_alpha()
    return d_promin_health_ui.get_ui_alpha()
end

local function get_player_arrow_tint()
    local alpha = get_icon_alpha()
    if arrow_tint_alpha ~= alpha then
        arrow_tint_alpha = alpha
        arrow_tint = GetARGB(alpha, 106, 255, 89)
    end
    return arrow_tint
end

local function get_white_tint()
    if white_tint_alpha ~= frame_alpha then
        white_tint_alpha = frame_alpha
        white_tint = GetARGB(frame_alpha, 255, 255, 255)
    end
    return white_tint
end

local function get_storyline_pin_tint()
    if storyline_pin_tint_alpha ~= frame_alpha then
        storyline_pin_tint_alpha = frame_alpha
        storyline_pin_tint = GetARGB(frame_alpha, 242, 231, 11)
    end
    return storyline_pin_tint
end

local function get_icon_tint(icon)
    if icon.tint_alpha ~= frame_alpha then
        icon.tint_alpha = frame_alpha
        icon.tint = GetARGB(frame_alpha, icon.r or 255, icon.g or 255, icon.b or 255)
    end
    return icon.tint
end

local layout_cache = nil
local layout_scale, layout_x, layout_y = nil, nil, nil

function get_layout()
    local transforms = d_promin_config.transforms
    if
        layout_cache
        and layout_scale == transforms.map_scale
        and layout_x == transforms.map_x
        and layout_y == transforms.map_y
    then
        return layout_cache
    end
    layout_scale, layout_x, layout_y = transforms.map_scale, transforms.map_x, transforms.map_y
    local width = VIEW.w * transforms.map_scale
    local height = VIEW.h * transforms.map_scale
    layout_cache = {
        screen = {
            x = VIEW.x + (VIEW.w - width) / 2 + transforms.map_x,
            y = VIEW.y + (VIEW.h - height) / 2 + transforms.map_y,
            w = width,
            h = height,
        },
        icon_h = ICON_H,
        arrow_h = ARROW_H,
        max_marks = MAX_MARKS,
    }
    return layout_cache
end

local function set_tint(slot, tint)
    if slot.tint ~= tint then
        slot.tint = tint
        slot.widget:SetTextureColor(tint)
    end
end

local function set_shown(slot, flag)
    if slot.shown ~= flag then
        slot.shown = flag
        slot.widget:Show(flag)
    end
end

local VARIANT_DY = 1.8

local function get_variant_id(icon, dy)
    if dy and icon.above and icon.below then
        if dy > VARIANT_DY then
            return icon.below
        elseif dy < -VARIANT_DY then
            return icon.above
        end
    end
    return icon.id
end

local function bind_icon(slot, icon, tint_override, dy)
    slot.icon_id = binder.bind(slot.widget, get_variant_id(icon, dy), slot.icon_id)
    set_tint(slot, tint_override or get_icon_tint(icon))
end

local function get_declared_scale(icon)
    return icon.px_h / PDA_ICON_PX
end

function get_category_icon(category)
    local spot = wd_map_marks.SPOT_BY_CATEGORY[category]
    local declared = spot and wd_map_spots.get_icon(spot)
    if not declared then
        return nil
    end
    return ICONS[category] or declared, get_declared_scale(declared)
end

local function resolve_mark_icon(mark)
    local icon = mark.icon
    if icon then
        return icon, get_declared_scale(icon)
    end
    return get_category_icon(mark.category)
end

local function get_icon_size(icon, scale)
    local height = ICON_H * scale
    return height * icon.px_w / icon.px_h, height
end

local EDGE_EPSILON = 1e-6

local function place_icon_inside(slot, icon, scale, center_x, center_y, screen, tint_override, dy)
    local icon_w, icon_h = get_icon_size(icon, scale)
    local left = center_x - icon_w / 2
    local top = center_y - icon_h / 2
    if
        left < screen.x1 - EDGE_EPSILON
        or top < screen.y1 - EDGE_EPSILON
        or left + icon_w > screen.x2 + EDGE_EPSILON
        or top + icon_h > screen.y2 + EDGE_EPSILON
    then
        return false
    end
    bind_icon(slot, icon, tint_override, dy)
    slot.widget:SetWndPos(scratch_pos:set(left, top))
    slot.widget:SetWndSize(scratch_size:set(icon_w, icon_h))
    return true
end

local function apply_map_layer(slot, layer, screen)
    slot.tex_id = binder.bind(slot.widget, layer.texture_id, slot.tex_id)
    set_tint(slot, get_white_tint())
    local width = screen.x2 - screen.x1
    local height = screen.y2 - screen.y1
    local frac = layer.frac
    local window = layer.window
    slot.widget:SetWndPos(scratch_pos:set(screen.x1 + frac.x1 * width, screen.y1 + frac.y1 * height))
    slot.widget:SetWndSize(scratch_size:set((frac.x2 - frac.x1) * width, (frac.y2 - frac.y1) * height))
    slot.widget:SetTextureRect(scratch_rect:set(window.left, window.top, window.right, window.bottom))
    set_shown(slot, true)
end

local function hide_all(page)
    page.chrome.set_visible(false)
    page.bio.set_visible(false)
    for _, slot in ipairs(page.map_slots) do
        set_shown(slot, false)
    end
    page.arrow:Show(false)
    set_shown(page.quest, false)
    for _, slot in ipairs(page.marks) do
        set_shown(slot, false)
    end
end

function build(ctx)
    local page = {
        visible = false,
        center = { x = 0, y = 0 },
        screen = { x1 = 0, y1 = 0, x2 = 0, y2 = 0 },
    }
    local icon_tint = GetARGB(get_icon_alpha(), 255, 255, 255)

    page.chrome = d_promin_health_ui.build_chrome({ init = ctx.init, layout = CHROME, bg_tex = BG_TEXTURE })
    page.bio = d_promin_health_ui.build_bio(ctx)

    page.map = ctx.init("map")
    page.map:SetStretchTexture(true)
    page.map:SetTextureColor(icon_tint)
    page.map_detail = ctx.init("map")
    page.map_detail:SetStretchTexture(true)
    page.map_detail:SetTextureColor(icon_tint)
    page.map_slots = {
        { widget = page.map, tex_id = nil, tint = icon_tint },
        { widget = page.map_detail, tex_id = nil, tint = icon_tint },
    }
    page.marks = {}
    for index = 1, MAX_MARKS do
        local widget = ctx.init("mark")
        widget:SetStretchTexture(true)
        widget:SetTextureColor(icon_tint)
        page.marks[index] = { widget = widget, icon_id = nil, tint = icon_tint }
    end
    page.quest = { widget = ctx.init("quest"), icon_id = nil, tint = icon_tint }
    page.quest.widget:SetStretchTexture(true)
    page.quest.widget:SetTextureColor(icon_tint)
    page.arrow = ctx.init("arrow")
    local arrow_icon = ICONS.arrow
    local arrow_side = ARROW_H * arrow_icon.scale
    page.arrow:SetWndSize(scratch_size:set(arrow_side, arrow_side))
    page.arrow:SetStretchTexture(true)
    binder.set(page.arrow, arrow_icon.id)
    set_arrow_frame(page.arrow, 0)
    page.arrow_frame = 0
    page.arrow_tint = get_player_arrow_tint()
    page.arrow:SetTextureColor(page.arrow_tint)

    local function reposition()
        local screen = get_layout().screen
        local x2 = screen.x + screen.w
        local y2 = screen.y + screen.h
        if
            page.screen.x1 == screen.x
            and page.screen.y1 == screen.y
            and page.screen.x2 == x2
            and page.screen.y2 == y2
        then
            return
        end
        page.center.x = screen.x + screen.w / 2
        page.center.y = screen.y + screen.h / 2
        page.screen.x1 = screen.x
        page.screen.y1 = screen.y
        page.screen.x2 = x2
        page.screen.y2 = y2
        for _, slot in ipairs(page.map_slots) do
            slot.widget:SetWndPos(scratch_pos:set(screen.x, screen.y))
            slot.widget:SetWndSize(scratch_size:set(screen.w, screen.h))
        end
        page.arrow:SetWndPos(scratch_pos:set(page.center.x - arrow_side / 2, page.center.y - arrow_side / 2))
    end
    reposition()
    hide_all(page)

    function page.set_visible(visible)
        page.visible = visible
        if visible then
            page.chrome.set_visible(true)
            page.bio.set_visible(true)
            page.arrow:Show(true)
        else
            hide_all(page)
        end
    end

    function page.update()
        page.chrome.update()
        page.bio.update()
    end

    function page.repaint()
        page.chrome.repaint()
        page.bio.repaint()
    end

    function page.update_map(state)
        if not page.visible then
            return
        end
        frame_alpha = get_icon_alpha()
        reposition()
        local map_layers = (state and state.has_map and state.layers) or {}
        for index, slot in ipairs(page.map_slots) do
            local layer = map_layers[index]
            if layer then
                apply_map_layer(slot, layer, page.screen)
            else
                set_shown(slot, false)
            end
        end
        local player_heading = (state and state.heading) or 0
        local arrow_frame = get_arrow_frame(math.sin(player_heading), -math.cos(player_heading))
        if page.arrow_frame ~= arrow_frame then
            page.arrow_frame = arrow_frame
            set_arrow_frame(page.arrow, arrow_frame)
        end
        local arrow_tint = get_player_arrow_tint()
        if page.arrow_tint ~= arrow_tint then
            page.arrow_tint = arrow_tint
            page.arrow:SetTextureColor(arrow_tint)
        end
        local marks = (state and state.marks) or {}
        for index, slot in ipairs(page.marks) do
            local mark = marks[index]
            local shown = false
            if mark and mark.inside then
                local icon, scale = resolve_mark_icon(mark)
                if icon then
                    shown = place_icon_inside(
                        slot,
                        icon,
                        scale,
                        page.center.x + mark.x,
                        page.center.y + mark.y,
                        page.screen,
                        nil,
                        mark.dy
                    )
                end
            end
            set_shown(slot, shown)
        end
        local quest = state and state.quest
        if quest then
            local storyline = quest.category ~= "quest_secondary"
            local icon, scale, raw_x, raw_y, tint, arrow_frame
            if quest.inside then
                icon, scale = get_category_icon(storyline and "quest" or "quest_secondary")
                raw_x, raw_y = quest.x, quest.y
                page.quest_frame = nil
            else
                icon = ICONS.quest_arrow
                scale = icon.scale
                raw_x, raw_y = quest.pin_x, quest.pin_y
                tint = storyline and get_storyline_pin_tint() or nil
                arrow_frame = get_arrow_frame(quest.x, quest.y)
            end
            if not icon then
                set_shown(page.quest, false)
                return
            end
            local icon_w, icon_h = get_icon_size(icon, scale)
            local center_x =
                math.max(page.screen.x1 + icon_w / 2, math.min(page.screen.x2 - icon_w / 2, page.center.x + raw_x))
            local center_y =
                math.max(page.screen.y1 + icon_h / 2, math.min(page.screen.y2 - icon_h / 2, page.center.y + raw_y))
            local shown = place_icon_inside(page.quest, icon, scale, center_x, center_y, page.screen, tint, quest.dy)
            if arrow_frame and page.quest_frame ~= arrow_frame then
                page.quest_frame = arrow_frame
                set_arrow_frame(page.quest.widget, arrow_frame)
            end
            set_shown(page.quest, shown)
        else
            page.quest_frame = nil
            set_shown(page.quest, false)
        end
    end

    return page
end
