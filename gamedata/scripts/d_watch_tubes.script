local SECTION = d_watch_config.SECTION
local SLOTS = 4

local display_digits = {}

function get_tube_bone(slot, digit)
    return "t" .. slot .. "_n" .. digit
end

local function new_tube_switch(slot)
    local bones = {}
    for digit = 0, 9 do
        bones[digit] = get_tube_bone(slot, digit)
    end
    return wd_attach.new_bone_switch({ name = SECTION, bones = bones })
end

local tubes = {}
for slot = 1, SLOTS do
    tubes[slot] = new_tube_switch(slot)
end

function get_display_digits()
    local mode = d_watch_config.get_clock()
    local seconds_left
    if mode ~= "time" then
        seconds_left = wd_toxic.get_filter_time_left()
    end
    local high
    local low
    if seconds_left then
        high = math.min(math.floor(seconds_left / 60), 99)
        low = math.floor(seconds_left % 60)
    elseif mode == "filter" then
        local has_filter = (wd_toxic.get_filter_capacity() or 0) > 0
        high = has_filter and 99 or 0
        low = high
    else
        high, low = wd_clock.get_time(d_watch_config.transforms)
    end
    display_digits[1] = math.floor(high / 10)
    display_digits[2] = high % 10
    display_digits[3] = math.floor(low / 10)
    display_digits[4] = low % 10
    if seconds_left and seconds_left > 0 and display_digits[1] == 0 then
        display_digits[1] = nil
    end
    return display_digits
end

local function apply_digits(digits)
    for slot = 1, SLOTS do
        tubes[slot].show(digits[slot])
    end
end

function update()
    if wd_attach.has_attachment(SECTION) then
        apply_digits(get_display_digits())
    end
end
