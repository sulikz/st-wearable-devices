local SECTION = "wd_bracer"
local PLACE_INTERVAL_MS = 1000
local TRADER_MIN_SUPPLY = 3

local accessory_bones = wd_attach.new_bone_switch({
    name = SECTION,
    bones = d_bracer_config.ACCESSORY_BONES,
    meshes_per_bone = d_bracer_config.ACCESSORY_MESHES_PER_BONE,
})

local function show_accessory(section)
    local kind, texture = d_bracer_config.get_accessory(section)
    wd_attach.apply_skin_texture(SECTION, texture, d_bracer_config.BAKED_ACCESSORY_TEXTURES[kind])
    accessory_bones.show(kind)
end

local accessory_owner = wd_worn.new({
    save_key = "wd_bracer_patch",
    get_obj_value = function(obj)
        return obj and obj:section()
    end,
    on_attach = function(obj)
        local section = obj:section()
        show_accessory(section)
        return section
    end,
    on_detach = function()
        show_accessory(nil)
    end,
})

local function resync_bare_wrist()
    if not wd_bare_wrist.update() then
        wd_slots.resync_bare_devices()
    end
end

local function remount_devices()
    resync_bare_wrist()
    wd_slots.remount_loadout()
end

local owner = wd_worn.new({
    attach_label = "st_attach_wd_bracer",
    detach_label = "st_detach_wd_bracer",
    save_key = "wd_bracer_worn",
    item_section = SECTION,
    on_attach = function()
        if not sync_attachment() then
            return false
        end
        remount_devices()
        return true
    end,
    on_detach = function()
        wd_bracer_sleeve.stop()
        wd_slots.unmount_all(true)
        resync_bare_wrist()
        sync_attachment()
    end,
})

function is_worn()
    return owner.is_attached()
end

local function is_attachment_present()
    return wd_attach.has_attachment(SECTION)
end

local applied_transforms = nil
local asked_at = 0

local function get_worn_transforms(hands_section)
    return wd_bracer_sleeve.get_bracer_transforms(hands_section) or d_bracer_config.transforms
end

function get_transforms()
    return is_worn() and applied_transforms or nil
end

function sync_attachment()
    if not is_worn() then
        wd_attach.detach(SECTION)
        return nil
    end
    applied_transforms = get_worn_transforms(wd_hands_left.get_outfit_hands_section())
    local attachment = wd_attach.attach({
        name = SECTION,
        model = d_bracer_config.MODEL,
        bone = d_bracer_config.ATT_BONE,
        transforms = applied_transforms,
    })
    show_accessory(accessory_owner.get_value())
    return attachment
end

local function apply_transforms(transforms)
    applied_transforms = transforms
    return wd_attach.reapply_transforms(SECTION, transforms)
end

function reapply_transforms()
    return apply_transforms(get_worn_transforms(wd_hands_left.get_outfit_hands_section()))
end

local function place_on_arm(hands_section)
    local transforms = get_worn_transforms(hands_section)
    if transforms ~= applied_transforms then
        apply_transforms(transforms)
    end
end

local function get_sleeve_visual(hands_section)
    asked_at = time_global()
    local visual = wd_hands_left.get_flat_exo_visual(hands_section) or wd_bracer_sleeve.get_left_visual(hands_section)
    place_on_arm(hands_section)
    return visual
end

local function place_unasked()
    if time_global() - asked_at >= PLACE_INTERVAL_MS and is_worn() then
        place_on_arm(wd_hands_left.get_outfit_hands_section())
    end
end

function actor_on_first_update()
    owner.detach_if_dropped()
    if sync_attachment() then
        remount_devices()
    end
end

function get_menu_text(obj)
    return owner.get_menu_text(obj)
end

function toggle_attach(obj)
    owner.toggle(obj)
end

function is_bracer_section(section)
    return section == SECTION
end

function get_worn_object()
    return owner.get_object()
end

function get_worn_id()
    return owner.get_id()
end

function wear(obj)
    local worn_id = owner.get_id()
    if worn_id == obj:id() then
        return true
    end
    owner.toggle(obj)
    if owner.is_attached() then
        return true
    end
    local worn = worn_id and db.actor:object_id(worn_id)
    if worn then
        owner.toggle(worn)
    end
    return false, "attach_failed"
end

function take_off()
    owner.detach()
end

function get_customize_text(obj)
    if not obj then
        return nil
    end
    return game.translate_string("st_wd_customize")
end

function open_customize(_obj)
    wd_customize.open_from_inventory()
end

function open_customize_on_chord(_key, bind, dis, flags)
    if dis or bind ~= key_bindings.kINVENTORY then
        return
    end
    if key_state(wd_mcm.get_hold_key_dik()) == 0 then
        return
    end
    if not db.actor:object(SECTION) then
        return
    end
    flags.ret_value = false
    wd_customize.open_from_inventory()
end

local function stop_sleeve_in_exo(is_exo)
    if is_exo then
        wd_bracer_sleeve.stop()
    end
end

local function get_default_slide()
    return d_bracer_config.DEFAULTS.model_pos[1]
end

local function get_slide_position()
    return get_default_slide() - d_bracer_config.transforms.model_pos[1]
end

local function set_slide_position(position)
    d_bracer_config.transforms.model_pos[1] = get_default_slide() - position
end

local function get_slide_position_range()
    local low, high = d_bracer_config.get_slide_range()
    local default = get_default_slide()
    return default - high, default - low
end

local function restore_slide(source_name)
    local source = source_name == "default" and d_bracer_config.DEFAULTS or d_bracer_config.saved
    d_bracer_config.transforms.model_pos[1] = source.model_pos[1]
end

local function new_slide_field()
    local slide = wd_gui.new_ranged_slider(get_slide_position_range)
    slide.get = get_slide_position
    slide.set = set_slide_position
    slide.restore = restore_slide
    slide.text = wd_gui.get_mm_text
    return slide
end

local function register_gui()
    local limits = d_bracer_config.LIMITS
    wd_gui.register_device({
        id = "bracer",
        label = "Bracer",
        is_worn = is_attachment_present,
        store = function()
            return d_bracer_config.transforms
        end,
        saved = function()
            return d_bracer_config.saved
        end,
        defaults = function()
            return d_bracer_config.DEFAULTS
        end,
        save_global = d_bracer_config.save_global,
        on_apply = function()
            d_bracer_config.clamp_slide()
            reapply_transforms()
        end,
        fields = {
            slide = new_slide_field(),
            model_scale = wd_gui.new_slider(limits.model_scale[1], limits.model_scale[2]),
        },
    })
    wd_gui.register_tab({
        device = "bracer",
        id = "bracer_model",
        label = "Bracer Position",
        default = true,
        rows = {
            { "slide", nil, 0.0005, wd_gui.FOREARM_POSITION_LABEL },
            { "model_scale", nil, 0.001, "Scale" },
        },
    })
end

local function start()
    d_bracer_config.load_transforms()
    wd_trader.register(SECTION, 1, TRADER_MIN_SUPPLY)
end

function register()
    wd_slots.register_bracer(is_worn)
    wd_slots.register_device({
        id = "patch",
        slot = "patch",
        in_place = true,
        matches_section = d_bracer_config.get_accessory,
        owner = accessory_owner,
    })
    wd_exo.register_device({
        id = "bracer",
        names = { SECTION },
        on_change = stop_sleeve_in_exo,
        resync = sync_attachment,
    })
    wd_core.register({
        id = "bracer",
        callbacks = {
            actor_on_first_update = { actor_on_first_update },
            actor_on_update = { owner.drop_poll, { place_unasked, interval = PLACE_INTERVAL_MS } },
            on_before_key_press = { { open_customize_on_chord, unless = wd_blocking.is_input_captured } },
            save_state = { owner.save, accessory_owner.save },
            load_state = { owner.load, accessory_owner.load },
        },
        on_start = start,
    })
    wd_attach.set_mount_anchor(wd_wrist_roll.MOUNT, {
        get_parent = d_bracer_config.get_mount_parent,
        bone = d_bracer_config.ATT_BONE,
    })
    wd_hands_left.register_source("bracer", function(hands_section)
        if is_worn() then
            return get_sleeve_visual(hands_section)
        end
    end, 1, is_worn, wd_bracer_sleeve.is_building)
    register_gui()
end
