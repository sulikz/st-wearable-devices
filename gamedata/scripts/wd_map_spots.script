local SWEEP_CHUNK = 640
local SNAPSHOT_INTERVAL_MS = 1000
local PAUSE_RESTART_MS = 1000
local SWEEP_INTERVAL_MS = 100
local REFRESH_INTERVAL_MS = 1000

local function get_engine_max_id()
    if alife then
        local ok, value = pcall(function()
            return alife():max_id()
        end)
        if ok and type(value) == "number" then
            return value
        end
    end
    return 0
end

local function get_engine_object_spots(object_id)
    return level.map_get_object_spots_by_id(object_id)
end

local function engine_has_spot(object_id, spot_type)
    return level.map_has_object_spot(object_id, spot_type) ~= 0
end

function new(deps)
    deps = deps or {}
    local get_max_id = deps.get_max_id or get_engine_max_id
    local sweep_chunk = deps.sweep_chunk or SWEEP_CHUNK
    local snapshot_interval_ms = deps.snapshot_interval_ms or SNAPSHOT_INTERVAL_MS
    local get_all_spots = deps.get_all_spots
    if get_all_spots == nil then
        get_all_spots = level.map_get_object_spots or false
    end
    local get_object_spots = deps.get_object_spots
    if get_object_spots == nil then
        get_object_spots = level.map_get_object_spots_by_id and get_engine_object_spots or false
    end
    local has_spot = deps.has_spot or engine_has_spot

    local registry = {}
    local entries = {}
    local held = {}
    local pending_entries = {}
    local pending = {}
    local published_once = false
    local sweeping = false
    local sweep_max_id = 0
    local sweep_index = 1
    local last_tick_at = -1
    local next_snapshot_at = 0

    local function record(list, map, spot_type, object_id)
        local spots = map[object_id]
        if not spots then
            spots = {}
            map[object_id] = spots
        end
        if spots[spot_type] then
            return
        end
        spots[spot_type] = true
        list[#list + 1] = { id = object_id, spot_type = spot_type }
    end

    local function publish()
        entries = pending_entries
        held = pending
        pending_entries = {}
        pending = {}
        published_once = true
    end

    local function start_sweep()
        pending_entries = {}
        pending = {}
        sweep_index = 1
        sweep_max_id = get_object_spots and not get_all_spots and get_max_id() or 0
        sweeping = sweep_max_id > 0
    end

    local function take_snapshot(now)
        if now < next_snapshot_at then
            return
        end
        next_snapshot_at = now + snapshot_interval_ms
        pending_entries = {}
        pending = {}
        for _, spot in ipairs(get_all_spots() or {}) do
            record(pending_entries, pending, spot.spot_type, spot.id)
        end
        publish()
    end

    function registry.is_sweeping()
        return sweeping or (get_all_spots and true or false)
    end

    function registry.update()
        local now = time_global()
        if now == last_tick_at then
            return
        end
        if get_all_spots then
            last_tick_at = now
            take_snapshot(now)
            return
        end
        if not sweeping then
            return
        end
        if now - last_tick_at > PAUSE_RESTART_MS then
            start_sweep()
        end
        last_tick_at = now
        local last = math.min(sweep_index + sweep_chunk - 1, sweep_max_id)
        for object_id = sweep_index, last do
            for _, spot in ipairs(get_object_spots(object_id) or {}) do
                record(pending_entries, pending, spot.spot_type, object_id)
                if not published_once then
                    record(entries, held, spot.spot_type, object_id)
                end
            end
        end
        sweep_index = last + 1
        if sweep_index > sweep_max_id then
            publish()
            sweeping = false
        end
    end

    function registry.add(spot_type, object_id)
        record(entries, held, spot_type, object_id)
        if sweeping then
            record(pending_entries, pending, spot_type, object_id)
        end
    end

    function registry.validate()
        local kept_entries = {}
        local kept = {}
        for _, entry in ipairs(entries) do
            if has_spot(entry.id, entry.spot_type) then
                record(kept_entries, kept, entry.spot_type, entry.id)
            end
        end
        entries = kept_entries
        held = kept
    end

    function registry.refresh_ids(ids)
        if not get_object_spots then
            return
        end
        for _, object_id in ipairs(ids) do
            for _, spot in ipairs(get_object_spots(object_id) or {}) do
                registry.add(spot.spot_type, object_id)
            end
        end
    end

    function registry.reset()
        entries = {}
        held = {}
        published_once = false
        last_tick_at = -1
        next_snapshot_at = 0
        start_sweep()
    end

    function registry.is_ready()
        return published_once
    end

    function registry.get_entries()
        return entries
    end

    registry.reset()
    return registry
end

local declarations = {}
local shared_icons = nil

local function read_text(xml_obj, element)
    local kid_count = 0
    local only_kid = nil
    xml_obj:iterateChildren(element, function(kid)
        kid_count = kid_count + 1
        only_kid = kid
    end)
    if kid_count == 1 and xml_obj:isText(only_kid) then
        return xml_obj:getText(element)
    end
    return nil
end

local function read_declaration_node(xml_obj, element)
    local attrs = xml_obj:getElementAttr(element)
    local node = {
        width = tonumber(attrs.width),
        height = tonumber(attrs.height),
    }
    xml_obj:iterateChildren(element, function(child)
        if not xml_obj:isElement(child) then
            return
        end
        local child_name = xml_obj:getElementName(child)
        if child_name == "mini_map" then
            local child_attrs = xml_obj:getElementAttr(child)
            node.mini_map = child_attrs.spot
            node.pointer = child_attrs.pointer
        elseif child_name == "texture" then
            local child_attrs = xml_obj:getElementAttr(child)
            node.texture = read_text(xml_obj, child)
            node.r = tonumber(child_attrs.r)
            node.g = tonumber(child_attrs.g)
            node.b = tonumber(child_attrs.b)
        elseif child_name == "texture_above" then
            node.texture_above = read_text(xml_obj, child)
        elseif child_name == "texture_below" then
            node.texture_below = read_text(xml_obj, child)
        end
    end)
    return node
end

function load_declarations(xml_obj)
    local loaded = {}
    xml_obj:iterateChildren(xml_obj:getRoot(), function(element)
        if xml_obj:isElement(element) then
            loaded[xml_obj:getElementName(element)] = read_declaration_node(xml_obj, element)
        end
    end)
    declarations = loaded
    shared_icons = nil
end

local function read_declaration(name)
    return declarations[name]
end

function new_icons(deps)
    deps = deps or {}
    local read_node = deps.read_node or read_declaration
    local icons = {}
    local cache = {}

    function icons.get(spot_type)
        local hit = cache[spot_type]
        if hit ~= nil then
            return hit or nil
        end
        if type(spot_type) ~= "string" then
            return nil
        end
        local resolved = false
        local declaration = read_node(spot_type)
        local mini_name = declaration and declaration.mini_map
        local mini = mini_name and mini_name ~= "" and read_node(mini_name)
        local px_w = mini and (mini.width or 16)
        local px_h = mini and (mini.height or 16)
        if mini and type(mini.texture) == "string" and mini.texture ~= "" and px_w > 0 and px_h > 0 then
            local has_variants = type(mini.texture_above) == "string" and type(mini.texture_below) == "string"
            resolved = {
                id = mini.texture,
                px_w = px_w,
                px_h = px_h,
                pointer = (declaration.pointer ~= nil and declaration.pointer ~= ""),
                r = mini.r,
                g = mini.g,
                b = mini.b,
                above = has_variants and mini.texture_above or nil,
                below = has_variants and mini.texture_below or nil,
            }
        end
        cache[spot_type] = resolved
        return resolved or nil
    end

    return icons
end

local shared_registry = nil

function get_registry()
    if not shared_registry then
        shared_registry = new({})
    end
    return shared_registry
end

function get_icon(spot_type)
    if not shared_icons then
        shared_icons = new_icons({})
    end
    return shared_icons.get(spot_type)
end

local allow_sweep = wd_core.throttle(SWEEP_INTERVAL_MS)
local allow_refresh = wd_core.throttle(REFRESH_INTERVAL_MS)
local refresh_requested = false

function request_refresh()
    refresh_requested = true
end

local function get_online_ids()
    return db.OnlineStalkers or {}
end

local function on_map_location_added(spot_type, object_id)
    get_registry().add(spot_type, object_id)
end

local function on_first_update()
    get_registry().reset()
    local kind = callback.map_location_added
    if kind then
        db.actor:set_callback(kind, on_map_location_added)
    end
end

function actor_on_update()
    local registry = get_registry()
    if registry.is_sweeping() then
        if allow_sweep() then
            registry.update()
        end
        return
    end
    if refresh_requested and allow_refresh() then
        refresh_requested = false
        registry.validate()
        registry.refresh_ids(get_online_ids())
    end
end

function register()
    RegisterScriptCallback("actor_on_first_update", on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
